/* pages/login/login.wxss */
.login-container {
  padding: 40rpx 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.login-title {
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 40rpx;
  color: #333;
}

.input-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.code-input-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.code-input {
  flex: 1;
  margin-right: 20rpx;
}

.input-label {
  font-size: 32rpx;
  color: #666;
  width: 160rpx;
}

.input-content, .picker-content {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  padding: 10rpx 0;
}

.get-code-btn {
  width: 200rpx;
  height: 60rpx;
  line-height: 60rpx;
  background-color: #1677ff;
  color: #fff;
  font-size: 26rpx;
  border-radius: 8rpx;
  padding: 0;
}

.btn-disabled {
  background-color: #ccc !important;
  color: #999 !important;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #1677ff;
  color: #fff;
  font-size: 34rpx;
  border-radius: 10rpx;
  margin-top: 20rpx;
  margin-bottom: 60rpx;
}

.to-register-wrap {
  text-align: center;
  font-size: 28rpx;
  color: #666;
}

.register-btn {
  color: #1677ff;
  margin-left: 10rpx;
  text-decoration: underline;
  font-weight: 500;
}