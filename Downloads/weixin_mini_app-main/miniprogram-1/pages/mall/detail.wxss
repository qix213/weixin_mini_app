.detail-container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 骨架屏样式 */
.skeleton-wrap {
  padding: 20rpx;
}

/* 商品主图 */
.goods-main-img {
  width: 100%;
  height: 450rpx;
  background-color: #fff;
}

/* 商品基础信息卡片 */
.goods-base-card {
  margin: 10rpx;
  background-color: #fff;
}

.base-info-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.stock-text {
  color: #1E88E5;
}

.sales-text {
  color: #b4282d;
}

/* 商品详情直接展示样式 */
.goods-desc-section {
  margin: 10rpx;
  padding: 20rpx;
  background-color: #fff;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.desc-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 底部操作栏 */
.operation-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  height: 100rpx;
  background-color: #fff;
  border-top: 1rpx solid #e0e0e0;
  z-index: 999;
}

.cart-btn, .buy-btn {
  flex: 1;
  height: 100%;
  line-height: 100rpx;
  text-align: center;
  border-radius: 0;
  font-size: 28rpx;
}

.buy-btn {
  background-color: #1E88E5;
}

/* 空数据样式 */
.empty-wrap {
  padding: 100rpx 0;
}

/* 数量选择器 */
.num-selector {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
  margin: 10rpx;
}
.selector-title {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}
/* 复用数量控制样式 */
.num-control {
  display: flex;
  align-items: center;
}
.num-control button {
  width: 40rpx;
  height: 40rpx;
  padding: 0;
  line-height: 40rpx;
  text-align: center;
  border: 1rpx solid #ccc;
  background: #fff;
  color: #333;
}
.num-control input {
  width: 60rpx;
  height: 40rpx;
  text-align: center;
  border: 1rpx solid #ccc;
  border-left: none;
  border-right: none;
  padding: 0;
}