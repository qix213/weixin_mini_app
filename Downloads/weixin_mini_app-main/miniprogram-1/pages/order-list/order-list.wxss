.order-card {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 12rpx;
}
.order-header {
  display: flex;
  justify-content: space-between;
  border-bottom: 1rpx solid #eee;
  padding-bottom: 20rpx;
  font-size: 24rpx;
  color: #999;
}
.order-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
}
.price {
  font-size: 36rpx;
  color: #ff4400;
  font-weight: bold;
}