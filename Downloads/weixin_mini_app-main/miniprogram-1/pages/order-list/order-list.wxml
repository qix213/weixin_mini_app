<view class="container">
  <block wx:for="{{orderList}}" wx:key="order_sn">
    <view class="order-card" bindtap="goToDetail" data-sn="{{item.order_sn}}">
      <view class="order-header">
        <text class="sn">订单号：{{item.order_sn}}</text>
        <text class="status">{{item.status}}</text>
      </view>
      <view class="order-body">
        <view class="info">
          <text class="goods-name">{{item.first_goods_name}} 等 {{item.item_count}} 件商品</text>
          <text class="time">{{item.create_time}}</text>
        </view>
        <view class="price">￥{{item.total_price}}</view>
      </view>
    </view>
  </block>
  
  <view wx:if="{{orderList.length === 0}}" class="empty">暂无消费记录</view>
</view>