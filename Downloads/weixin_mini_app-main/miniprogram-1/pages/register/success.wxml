<view class="success-container">
  <!-- 成功图标 -->
  <image src="/images/success.png" class="success-icon"></image>

  <!-- 成功文案 -->
  <view class="success-title">
    注册成功，成为【{{memberType}}】
  </view>
  <view class="success-desc" wx:if="{{memberType === 'TA创粉'}}">
    已为您设立MINI-studio
  </view>

  <!-- 权益列表 -->
  <view class="benefit-list">
    <view class="benefit-item" wx:for="{{benefits}}" wx:key="index">
      <view class="benefit-num">{{index + 1}}</view>
      <view class="benefit-text">{{item}}</view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="btn-group">
    <button class="btn-primary" bindtap="toHome">返回首页</button>
    <button class="btn-gray" bindtap="toMine">进入我的</button>
  </view>
</view>