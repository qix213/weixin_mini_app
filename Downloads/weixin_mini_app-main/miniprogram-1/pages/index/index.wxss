/* 全局样式 */
page {
  background-color: #ffffff; /* 渐变底部已到白，页面背景设为白 */
}

/* 顶部横幅：垂直渐变（上蓝→下白，过渡明显） */
.banner1 {
  width: 100%;
  height: 320rpx; /* 适配渐变长度 */
  /* 垂直渐变：从品牌蓝 → 浅蓝 → 白色 */
  background: linear-gradient(180deg, 
    #1E88E5 0%,    /* 顶部：品牌主蓝 */
    #42a5f5 50%,   /* 中间：浅蓝过渡 */
    #ffffff 100%   /* 底部：完全白色 */
  );
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  color: white;
}

/* 顶部栏：标语 + Logo + 登录按钮（横向排列） */
.banner-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

/* 欢迎标语样式 */
.banner-text {
  flex: 1; /* 占满除Logo和登录按钮外的空间 */
}
.banner-text .greeting {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
}
.banner-text .welcome {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 新增：greeting右侧的Logo样式 */
.banner-logo {
  width: 200rpx;   /* Logo宽度，可按需调整 */
  height: 300rpx;  /* Logo高度，可按需调整 */
   /* margin: 0 40rpx;  */
  border-radius: 8rpx; /* 轻微圆角，提升质感 */
}

/* 右上角登录按钮 */
.login-btn {
  font-size: 26rpx;
  color:  rgb(35, 123, 158);
  padding: 8rpx 16rpx;
  border: 2rpx solid rgba(255,255,255,0.8);
  border-radius: 20rpx;
  white-space: wrap; /* 防止按钮文字换行 */
}

.register-btn {
  font-size: 26rpx;
  color: rgb(35, 123, 158);
  padding: 8rpx 16rpx;
  border: 2rpx solid rgba(255,255,255,0.8);
  border-radius: 20rpx;
  white-space: wrap; /* 防止按钮文字换行 */
}
/* 登录后：欢迎昵称 */
.welcome-text {
  color: #fff;
  font-size: 32rpx;
  margin-left: 20rpx;
}
/* 未登录：登录/注册按钮组 */
.login-register-btn-group {
  display: flex;
  gap: 2rpx;
}
/* 功能按钮组（匹配截图样式） */
.banner-btn-group {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.btn {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
}

/* 入会按钮：蓝边框+白字 */
.join-btn {
  background-color: transparent;
  color: #1E88E5;
  border: 2rpx solid #1E88E5;
}

/* 商城按钮：白底色+蓝字 */
.mall-btn {
  background-color: white;
  color: #1E88E5;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1); /* 轻微阴影提升质感 */
}
/* -------------------- */
.banner {
  height: 290rpx;
  width: 750rpx;
  background-color: rgb(127, 240, 255);
  font-size: 30rpx
}

.tips {
  display: flex;
  justify-content: space-evenly;
  height: 80rpx;
  width: 750rpx;
  background-color: rgb(140, 238, 238);
  font-size: 30rpx;
  color: rgb(196, 36, 14);
  border-radius: 50rpx;
  /* 上下右左 */
  margin: 10rpx 10rpx 30rpx 10rpx;
  padding-left: 2rpx;
}
.tips>scrotext{
  flex-grow: 1;
  height: 30rpx;
  width: 750rpx;
  margin: 80rpx 10rpx 30rpx 10rpx;
  border-radius: 50rpx;
}
.regist{
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  padding: 10rpx 1rpx ;
  margin: 10rpx 30rpx;
}

.icon {
  padding-right: 10rpx;
}

.menu {
  display: flex;
  justify-content: space-between;
  padding: 16rpx;
  border-radius: 10rpx;
  flex-wrap: wrap;
  background-color: powderblue;
}

.item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 250rpx;
  height: 200rpx;
  border: rgb(192, 251, 255) solid 10rpx;
  margin: 1rpx;
  background-color: powderblue;
}

.img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
}

.title {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.notice {
  display: flex;
  justify-content: flex-start;
  margin-top: 20rpx;
  margin-bottom: 10rpx;
}

.notice>text {
  flex-grow: 1;
  font-size: medium;
  color: blue;
}


/* index.wxss（修正后的样式，确保图片有可见的宽高） */
.fixed-images-section {
  padding: 1px 10px;
  /* 确保容器可见，无隐藏属性 */
  display: block;
}

.fixed-images-container {
  display: flex;  /* 横向排列，确保图片并排显示 */
  justify-content: space-between;
  gap: 17px;      /* 图片间距，可选 */
  flex-wrap: wrap;
}

.fixed-image {
  width: 30%;      /* 明确宽度（3张图平分，可调整为 33.33%） */
  height: 160px;   /* 明确高度，不可为 0 或 auto（auto 可能导致高度塌陷） */
  border-radius: 8px;  /* 可选，不影响显示 */
  object-fit: cover;   /* 与 mode="aspectFill" 配合，保持图片比例 */
  background-color: #f5f5f5;  /* 可选：设置背景色，若图片加载失败可看到占位 */
}