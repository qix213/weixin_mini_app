/* ================= 🌟 全局底色：高级暖米白 ================= */
.consume-container {
  min-height: 100vh;
  background-color: #F7F8F7; 
  padding: 32rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  padding-bottom: 80rpx;
}

/* 加载状态 */
.loading { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 60vh; color: #9CA3AF; font-size: 28rpx; }
.spinner { width: 44rpx; height: 44rpx; border: 4rpx solid rgba(197, 179, 144, 0.3); border-top-color: #C5B390; border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20rpx; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ================= 🌟 顶层资产卡片 (深邃黑金) ================= */
.asset-card {
  background: linear-gradient(135deg, #1B211D 0%, #2A332C 100%);
  border-radius: 36rpx;
  padding: 56rpx 48rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 24rpx 48rpx rgba(27, 33, 29, 0.15);
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}
/* 卡片光泽 */
.asset-card::after {
  content: ""; position: absolute; top: -50%; right: -20%; width: 300rpx; height: 300rpx;
  background: radial-gradient(circle, rgba(226, 209, 166, 0.1) 0%, rgba(255,255,255,0) 70%);
  border-radius: 50%;
}
.asset-label { font-size: 26rpx; color: rgba(226, 209, 166, 0.7); display: block; margin-bottom: 16rpx; letter-spacing: 1px;}
.asset-amount { font-size: 76rpx; font-weight: 600; font-family: 'DIN Alternate', sans-serif; color: #E2D1A6; }
.withdraw-btn { 
  background: linear-gradient(135deg, #E2D1A6, #C5B390);
  color: #1B211D; font-size: 30rpx; font-weight: bold; 
  padding: 18rpx 44rpx; border-radius: 50rpx; 
  box-shadow: 0 12rpx 24rpx rgba(197, 179, 144, 0.25);
  z-index: 1; transition: all 0.2s;
}
.withdraw-btn:active { transform: scale(0.95); opacity: 0.9; }


/* ================= 🌟 底部上拉提现弹窗 ================= */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(4px);
  z-index: 998; opacity: 0; visibility: hidden; transition: all 0.3s ease;
}
.modal-mask.show { opacity: 1; visibility: visible; }

.withdraw-bottom-sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #FFFFFF; border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 40rpx 20rpx; z-index: 999;
  transform: translateY(100%); transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  box-shadow: 0 -10rpx 40rpx rgba(0,0,0,0.08);
}
.withdraw-bottom-sheet.show { transform: translateY(0); }

.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 48rpx; }
.modal-title { font-size: 34rpx; font-weight: 600; color: #1C1E1D; }
.close-icon { font-size: 40rpx; color: #9CA3AF; padding: 10rpx; }

.input-container {
  display: flex; align-items: baseline;
  border-bottom: 2rpx solid #EAEBE9;
  padding-bottom: 20rpx; margin-bottom: 32rpx;
}
.currency-symbol { font-size: 56rpx; font-weight: 600; color: #1C1E1D; margin-right: 20rpx; }
.amount-input { flex: 1; font-size: 72rpx; font-weight: bold; font-family: 'DIN Alternate', sans-serif; color: #1C1E1D; height: 90rpx; }

.quick-action-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 56rpx; }
.balance-text { font-size: 26rpx; color: #8A8E88; }
.action-btns { display: flex; gap: 20rpx; }
.quick-btn { 
  font-size: 24rpx; color: #5C635F; background: #F2F3F1; 
  padding: 10rpx 24rpx; border-radius: 24rpx; transition: all 0.2s;
}
.quick-btn.max { color: #C5B390; background: rgba(197, 179, 144, 0.15); font-weight: bold; }
.quick-btn:active { opacity: 0.7; }

.confirm-withdraw-btn {
  background: linear-gradient(135deg, #1B211D, #2A332C); color: #E2D1A6;
  border-radius: 50rpx; font-size: 32rpx; font-weight: 600;
  height: 96rpx; line-height: 96rpx; border: none;
}
.confirm-withdraw-btn::after { display: none; }
.confirm-withdraw-btn:active { opacity: 0.9; transform: scale(0.98); }
.safe-area-bottom { padding-bottom: env(safe-area-inset-bottom); }


/* ================= 🌟 折叠面板区块 ================= */
.foldable-section {
  background: #FFFFFF; border-radius: 32rpx; margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.03); overflow: hidden;
}
.section-header-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 40rpx 32rpx; background: #FFFFFF; transition: background-color 0.2s;
}
.section-header-bar:active { background: #FAFAFA; }
.section-title { font-size: 32rpx; font-weight: 600; color: #1C1E1D; letter-spacing: 0.5px; }
.section-right { display: flex; align-items: center; }
.summary-text { font-size: 26rpx; margin-right: 16rpx; color: #9CA3AF; }
.highlight-text { color: #C5B390; font-weight: bold; font-family: 'DIN Alternate', sans-serif; font-size: 28rpx; }
.toggle-icon { display: flex; align-items: center; justify-content: center; }
.section-body { padding: 0 32rpx 32rpx 32rpx; border-top: 1px solid rgba(0,0,0,0.02); }


/* ================= 🌟 佣金明细列表卡片 ================= */
.commission-card, .member-card { 
  background: #FDFDFD; border-radius: 20rpx; margin-top: 24rpx; 
  border: 1px solid rgba(0,0,0,0.03); box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.01);
}
.commission-card { padding: 32rpx; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.comm-desc-box { display: flex; align-items: center; }
.comm-icon { margin-right: 14rpx; display: flex; align-items: center; }
.comm-desc { font-size: 28rpx; font-weight: 600; color: #1C1E1D; }
.comm-money { font-size: 36rpx; font-weight: bold; font-family: 'DIN Alternate', sans-serif; color: #5C6E58; } /* 柔和雅致绿 */
.comm-divider, .divider { width: 100%; height: 1px; background-color: rgba(0,0,0,0.03); margin: 24rpx 0; }
.info-line { display: flex; margin-bottom: 12rpx; font-size: 24rpx; line-height: 1.6; }
.info-line:last-child { margin-bottom: 0; }
.info-label { width: 130rpx; color: #9A9E9C; flex-shrink: 0; }
.info-value { color: #3A3E3C; flex: 1; }
.font-mono { font-family: Consolas, monospace; }
.text-muted { color: #B0B5B2; }


/* ================= 🌟 下级会员消费与订单详情 ================= */
.member-header { display: flex; justify-content: space-between; padding: 28rpx 24rpx; align-items: center; }
.title-row { display: flex; align-items: center; margin-bottom: 8rpx; }
.nickname { font-size: 30rpx; font-weight: 600; color: #1C1E1D; margin-right: 16rpx; }
.level-tag { background: #F2F3F1; color: #5C6E58; font-size: 20rpx; padding: 6rpx 14rpx; border-radius: 8rpx; font-weight: 600; }
.subtitle { font-size: 24rpx; color: #9CA3AF; }
.member-action-col { display: flex; align-items: center; }
.consume-sum { text-align: right; margin-right: 20rpx; }
.sum-label { font-size: 22rpx; color: #9A9E9C; display: block; }
.sum-val { font-size: 28rpx; font-weight: bold; color: #1C1E1D; font-family: 'DIN Alternate', sans-serif; }
.consume-detail-wrap { padding: 0 24rpx 24rpx; }

.order-item { background: #FAFAFA; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; border: 1px solid rgba(0,0,0,0.02); }
.summary-top { margin-bottom: 16rpx; display: flex; justify-content: space-between;}
.summary-bottom { display: flex; justify-content: space-between; align-items: center;}
.order-sn { font-size: 24rpx; color: #5C635F; font-family: Consolas, monospace; }
.order-status.success { color: #5C6E58; font-weight: bold;}
.emphasis { font-size: 30rpx; font-weight: bold; color: #1C1E1D; margin-left: 8rpx; font-family: 'DIN Alternate', sans-serif;}

.goods-table { margin-top: 20rpx; background: #FFFFFF; border-radius: 12rpx; overflow: hidden; border: 1px solid rgba(0,0,0,0.02);}
.t-head { display: flex; background: #FAFAFA; padding: 12rpx 16rpx; }
.t-row { display: flex; padding: 16rpx; border-top: 1px solid rgba(0,0,0,0.02); }
.t-col { font-size: 24rpx; color: #5C635F; }
.t-head .t-col { color: #9A9E9C; font-size: 22rpx; }
.goods-name { flex: 2; }
.num { flex: 1; text-align: center; }
.price { flex: 1; text-align: right; font-family: 'DIN Alternate', sans-serif; }
.text-ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 240rpx; }


/* ================= 🌟 空状态 ================= */
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 80rpx 0; color: #B0B5B2; font-size: 26rpx; letter-spacing: 1px;}
.empty-img { width: 220rpx; height: 220rpx; margin-bottom: 24rpx; opacity: 0.9; }
.empty-order { text-align: center; color: #B0B5B2; font-size: 24rpx; padding: 30rpx 0; }