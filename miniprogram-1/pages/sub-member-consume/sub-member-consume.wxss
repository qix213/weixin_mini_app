/* pages/sub-member-consume/sub-member-consume.wxss */
.consume-container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.loading, .empty {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  font-size: 30rpx;
  color: #999;
}

.consume-list {
  gap: 20rpx;
  display: flex;
  flex-direction: column;
}

.consume-item {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 15rpx;
}

.order-sn {
  font-size: 26rpx;
  color: #666;
  flex: 2;
}

.order-date {
  font-size: 24rpx;
  color: #999;
  flex: 1;
  text-align: center;
}

.order-status {
  font-size: 26rpx;
  color: #1677ff;
  flex: 1;
  text-align: right;
}

.goods-list {
  margin-bottom: 15rpx;
}

.goods-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  flex: 2;
}

.goods-count {
  font-size: 26rpx;
  color: #666;
  flex: 1;
  text-align: center;
}

.goods-price {
  font-size: 26rpx;
  color: #ff4d4f;
  flex: 1.5;
  text-align: right;
}

.order-total {
  text-align: right;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}