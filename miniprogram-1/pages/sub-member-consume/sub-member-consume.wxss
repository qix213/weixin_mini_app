/* 容器整体样式 */
.consume-container {
  padding: 10rpx 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 加载中/空数据样式 */
.loading, .empty, .empty-order {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 会员列表样式 */
.member-list {
  background-color: #fff;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

/* 会员项样式 */
.member-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}
.member-item:last-child {
  border-bottom: none;
}

/* 会员信息横向布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.member-info {
  flex: 1;
}
.member-main {
  flex: 1;
}
.member-nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.member-code {
  font-size: 24rpx;
  color: #666;
  margin-left: 10rpx;
}
.member-level {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}
.member-total {
  font-size: 26rpx;
  color: #e64340;
  font-weight: bold;
}

/* 展开/收起图标 */
.toggle-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #666;
}

/* 消费详情区域 */
.consume-detail {
  padding: 20rpx;
  background-color: #fff;
  border-radius: 10rpx;
  margin-top: 10rpx;
}

/* 合计金额栏 */
.total-consume-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 20rpx;
}
.total-label {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}
.total-amount {
  font-size: 32rpx;
  color: #e64340;
  font-weight: bold;
}

/* 表格通用样式 */
.table-header {
  background-color: #f8f8f8;
  color: #666;
  font-weight: bold;
}
.order-header, .goods-header {
  padding: 15rpx 10rpx;
  font-size: 26rpx;
}
.order-content, .goods-item {
  padding: 15rpx 10rpx;
  font-size: 26rpx;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
}
.goods-item:last-child {
  border-bottom: none;
}

/* 表格列宽分配 */
.col-sn {
  flex: 2;
}
.col-date {
  flex: 2;
  text-align: center;
}
.col-status {
  flex: 1.5;
  text-align: center;
}
.col-total {
  flex: 1;
  text-align: right;
  color: #e64340;
}
.col-goods {
  flex: 2.5;
}
.col-count {
  flex: 1;
  text-align: center;
}
.col-price {
  flex: 1.2;
  text-align: center;
}
.col-subtotal {
  flex: 1.2;
  text-align: right;
  color: #e64340;
}

/* 商品表格容器 */
.goods-table {
  margin: 15rpx 0;
  border: 1rpx solid #eee;
  border-radius: 5rpx;
  overflow: hidden;
}

/* 无商品提示 */
.no-goods {
  text-align: center;
  padding: 20rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 订单分隔线 */
.order-divider {
  height: 10rpx;
  background-color: #f5f5f5;
  margin: 10rpx 0;
}

/* 无订单提示 */
.empty-order {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 28rpx;
}