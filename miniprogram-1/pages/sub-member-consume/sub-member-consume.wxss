/* 全局容器背景：采用极浅的蓝灰色，衬托白色卡片 */
.consume-container {
  padding: 24rpx;
  background-color: #F4F6F9;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部总计渐变卡片 */
.total-all-card {
  position: relative;
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(22, 119, 255, 0.2);
  margin-bottom: 30rpx;
  overflow: hidden;
}
/* 卡片背景装饰圆环，增加设计感 */
.card-bg-circle {
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}
.total-all-label {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}
.total-all-amount-wrap {
  display: flex;
  align-items: baseline;
  position: relative;
  z-index: 1;
}
.total-all-amount-wrap .symbol {
  font-size: 40rpx;
  font-weight: 500;
  margin-right: 8rpx;
}
.total-all-amount {
  font-size: 72rpx;
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
}

/* 会员列表项卡片 */
.member-card {
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  transition: all 0.3s ease;
  overflow: hidden;
}
.member-card.is-expanded {
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.08);
  border: 1px solid rgba(22, 119, 255, 0.1);
}

/* 会员头部信息 */
.member-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 24rpx;
}
.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.member-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.member-nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 16rpx;
}
/* 等级高级标签 */
.member-tag {
  font-size: 20rpx;
  color: #1677ff;
  background: #E6F0FF;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.member-subtitle {
  font-size: 24rpx;
  color: #999;
}

/* 右侧消费总额与箭头 */
.member-action {
  display: flex;
  align-items: center;
}
.member-total-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-right: 20rpx;
}
.member-total-box .total-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}
.member-total-box .total-value {
  font-size: 32rpx;
  color: #1677ff;
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
}

/* 纯CSS绘制箭头，更平滑 */
.toggle-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 4rpx solid #ccc;
  border-bottom: 4rpx solid #ccc;
  transition: transform 0.3s ease;
}
.arrow-down {
  transform: rotate(45deg);
}
.arrow-up {
  transform: rotate(-135deg);
  border-color: #1677ff;
}

/* 详情展开区域 */
.consume-detail-wrap {
  border-top: 1rpx dashed #eee;
  background-color: #FAFAFA;
}
.consume-detail-inner {
  padding: 30rpx 24rpx;
}

/* 订单卡片 */
.order-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
  border: 1rpx solid #F0F0F0;
}
.order-item:last-child {
  margin-bottom: 0;
}

/* 订单概览 */
.order-summary {
  margin-bottom: 20rpx;
}
.summary-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.order-sn {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}
.order-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.status-primary {
  color: #1677ff;
  background: #E6F0FF;
}
.status-success {
  color: #00B578;
  background: #D4F2E7;
}
.summary-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}
.price-text {
  color: #333;
  font-weight: bold;
  font-size: 28rpx;
}

/* 商品表格 */
.goods-table {
  background: #F8FAFC;
  border-radius: 12rpx;
  padding: 0 16rpx;
}
.table-header {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #E2E8F0;
  font-size: 24rpx;
  color: #64748B;
}
.table-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed #E2E8F0;
  font-size: 24rpx;
  color: #334155;
  align-items: center;
}
.table-row:last-child {
  border-bottom: none;
}

/* 栅格列宽 */
.col-goods { flex: 2.5; padding-right: 10rpx; }
.col-count { flex: 0.8; text-align: center; color: #94A3B8;}
.col-price { flex: 1.2; text-align: center; color: #64748B;}
.col-subtotal { flex: 1.2; text-align: right; }

.emphasis {
  font-weight: bold;
  color: #1677ff;
}
/* 超出省略号 */
.text-ellipsis {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 缺省页/加载状态 */
.loading, .empty, .empty-order, .no-goods {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}
.empty-order { padding: 40rpx 0; }
.no-goods { padding: 30rpx 0; background: #F8FAFC; border-radius: 12rpx; }

.empty-img {
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 20rpx;
}