<wxs module="statusFormatter">
  module.exports.getClass = function(status) {
    var currentStatus = status || '待发货';
    if (currentStatus === '待发货') return 'status-pending';
    if (currentStatus === '已揽收' || currentStatus === '运送中') return 'status-transit';
    if (currentStatus === '派送中') return 'status-delivering';
    if (currentStatus === '已签收') return 'status-success';
    if (currentStatus === '异常件' || currentStatus === '已取消') return 'status-error';
    return 'status-default';
  }
</wxs>

<view class="container">
  <view class="loading-box" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text>正在获取最新订单数据...</text>
  </view>

  <block wx:else>
    <view class="tab-container">
      <scroll-view class="tab-scroll" scroll-x="true" scroll-with-animation="true">
        <view class="tab-list">
          <view 
            class="tab-item {{activeTab === item.key ? 'active' : ''}}"
            wx:for="{{orderStatusTabs}}"
            wx:key="key"
            bindtap="onTabChange"
            data-key="{{item.key}}"
          >
            <view class="tab-text">{{item.name}}</view>
            <view class="tab-line"></view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="empty-state" wx:if="{{filteredOrders.length === 0}}">
      <view class="empty-icon">📦</view>
      <text>暂无相关{{activeTabName}}记录</text>
    </view>

    <view class="order-list" wx:else>
      <view class="order-card {{item.expanded ? 'card-active' : ''}}" wx:for="{{filteredOrders}}" wx:key="orderSn" wx:for-index="idx">
        
        <view class="order-header" bindtap="toggleOrderExpand" data-index="{{idx}}">
          <view class="header-main">
            <view class="sn-row">
              <text class="sn-label">订单号</text>
              <text class="sn-num">{{item.orderSn}}</text>
            </view>
            <view class="status-tag {{statusFormatter.getClass(item.latestExpress.logisticsStatusName)}}">
              {{item.latestExpress.logisticsStatusName || '待发货'}}
            </view>
          </view>
          
          <view class="header-sub">
            <view class="order-info-left">
              <text class="order-time">{{item.createTime}}</text>
              <text class="member-tag">会员: {{item.memberNickname}}</text>
            </view>
            <view class="price-box">
              <text class="currency">¥</text>
              <text class="amount">{{item.totalPrice}}</text>
              <view class="arrow-icon {{item.expanded ? 'arrow-up' : ''}}">{{item.expanded ? '▲' : '▼'}}</view>
            </view>
          </view>
        </view>

        <view class="order-content {{item.expanded ? 'show' : ''}}">
          <view class="detail-section">
            <view class="section-head">
              <view class="title-dot"></view>
              <text>物流详情</text>
            </view>
            
            <view class="express-preview" wx:if="{{item.expressList.length > 0}}">
              <view class="express-info">
                <text class="company">{{item.latestExpress.logisticsCompany}}</text>
                <text class="waybill">{{item.latestExpress.logisticsNo}}</text>
              </view>
              <view class="timeline">
                <view class="timeline-item active">
                  <view class="dot"></view>
                  <view class="content">
                    <text class="txt">{{item.latestExpress.acceptAddress}}</text>
                    <text class="time">{{item.latestExpress.logisticsStatusName}}</text>
                  </view>
                </view>
                <block wx:if="{{item.trackExpanded}}">
                  <view class="timeline-item" wx:for="{{item.expressList}}" wx:for-item="track" wx:key="logisticsTime" wx:if="{{index > 0}}">
                    <view class="dot"></view>
                    <view class="content">
                      <text class="txt">{{track.acceptAddress}}</text>
                      <text class="time">{{track.logisticsTime}}</text>
                    </view>
                  </view>
                </block>
              </view>
              <view class="more-btn" catchtap="toggleTrackExpand" data-index="{{idx}}" wx:if="{{item.expressList.length > 1}}">
                {{item.trackExpanded ? '收起轨迹 ▲' : '查看完整轨迹 ▼'}}
              </view>
            </view>
            <view class="no-data" wx:else>暂无物流更新数据</view>
          </view>

          <view class="detail-section">
            <view class="section-head">
              <view class="title-dot"></view>
              <text>商品清单</text>
            </view>
            <view class="goods-table">
              <view class="goods-row head">
                <text class="col-n">商品名称</text>
                <text class="col-s">单价/数量</text>
                <text class="col-p">小计</text>
              </view>
              <view class="goods-row" wx:for="{{item.goodsList}}" wx:for-item="goods" wx:key="goodsName">
                <text class="col-n">{{goods.goodsName}}</text>
                <view class="col-s">
                  <text class="g-price">¥{{goods.price}}</text>
                  <text class="g-num">x{{goods.num}}</text>
                </view>
                <text class="col-p">¥{{goods.totalPrice}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>