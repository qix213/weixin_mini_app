<view class="container">
  <!-- 加载状态 -->
  <view class="loading-box" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text>正在加载订单数据...</text>
  </view>

  <!-- 主内容 -->
  <view wx:else>
    <!-- 状态提示：修复加载中不显示错误 -->

    <view wx:if="{{orderDetail.jd_precheck_status !== null}}"
          class="status-banner {{orderDetail.jd_precheck_status === false ? 'error' : 'success'}}">
      <view class="text-content">
        <view class="title-row">
          <text class="title">{{orderDetail.jd_precheck_status === false ? '前置校验未通过' : '京东前置校验已通过'}}</text>
          <text class="icon">{{orderDetail.jd_precheck_status === false ? '⚠️' : '✅'}}</text>
        </view>
        <text class="desc">{{orderDetail.jd_precheck_status === false ? (orderDetail.jd_error_msg || '地址超区或受限') : '地址可达，符合揽收标准'}}</text>
      </view>
    </view>

    <!-- 地址卡片 -->
    <view class="card address-card">
      <view class="address-item sender" bindtap="goToAddressList">
        <view class="icon-tag blue">寄</view>
        <view class="info">
          <view class="name-phone">
            <!-- ✅ 全量兜底，无undefined -->
            <text class="name">{{orderDetail.sender_name || '默认寄件人'}}</text>
            <text class="phone">{{orderDetail.sender_phone || '无联系方式'}}</text>
          </view>
          <text class="addr">{{orderDetail.sender_address || '请选择发货地址'}}</text>
        </view>
        <view class="arrow-right">></view>
      </view>
      
      <view class="address-divider"></view>

      <view class="address-item receiver">
        <view class="icon-tag red">收</view>
        <view class="info">
          <view class="name-phone">
            <text class="name">{{receiver.name || '无收件人'}}</text>
            <text class="phone">{{receiver.mobile || '无联系方式'}}</text>
          </view>
          <text class="addr">{{receiver.fullAddress || '无收货地址'}}</text>
        </view>
      </view>
    </view>

    <!-- 商品卡片 -->
    <view class="card goods-card">
      <view class="card-header">包裹明细</view>
      
      <block wx:for="{{orderDetail.goods_detail || []}}" wx:key="index">
        <view class="goods-item">
          <image class="goods-img" src="{{item.goods_image}}" mode="aspectFill"></image>
          <view class="goods-info">
            <text class="goods-name">{{item.goods_name}}</text>
            <text class="goods-price">¥{{item.price}}</text>
            <text class="goods-num">x{{item.num}}</text>
          </view>
        </view>
      </block>

      <!-- ✅ 修复编译错误：简化判断语法 -->
      <view wx:if="{{!orderDetail.goods_detail || orderDetail.goods_detail.length == 0}}" class="empty-tip">
        暂无商品明细
      </view>

      <view class="package-summary">
        共 {{orderDetail.goods_count || 0}} 件商品，由京东物流承担配送
      </view>
    </view>
    <view class="glass-card cargo-form-section" style="margin: 20rpx; padding: 20rpx; background: #fff; border-radius: 12rpx;">
  <view style="font-size: 28rpx; font-weight: bold; margin-bottom: 16rpx; color: #2E3529;">物流包裹信息补充</view>
  
  <view class="input-item" style="display: flex; align-items: center; margin-bottom: 12rpx; font-size: 26rpx;">
    <text style="width: 160rpx; color: #64748b;">物品内容：</text>
    <input style="flex: 1; border-bottom: 1rpx solid #e2e8f0; padding: 4rpx 0;" value="{{cargoName}}" bindinput="onCargoNameInput" placeholder="请输入物品内容"/>
  </view>

  <view class="input-item" style="display: flex; align-items: center; margin-bottom: 12rpx; font-size: 26rpx;">
    <text style="width: 160rpx; color: #64748b;">包裹重量(kg)：</text>
    <input type="digit" style="flex: 1; border-bottom: 1rpx solid #e2e8f0; padding: 4rpx 0;" value="{{cargoWeight}}" bindinput="onCargoWeightInput" placeholder="请输入包裹重量"/>
  </view>

  <view class="input-item" style="display: flex; align-items: center; font-size: 26rpx;">
    <text style="width: 160rpx; color: #64748b;">包裹体积(cm³)：</text>
    <input type="number" style="flex: 1; border-bottom: 1rpx solid #e2e8f0; padding: 4rpx 0;" value="{{cargoVolume}}" bindinput="onCargoVolumeInput" placeholder="请输入包裹体积"/>
  </view>
  <view class="input-item" style="display: flex; align-items: center; font-size: 26rpx; margin-top: 12rpx;">
    <text style="width: 160rpx; color: #64748b;">上门时间：</text>
    <picker mode="multiSelector" range="{{timeRange}}" value="{{timeIndex}}" bindchange="onTimeChange" style="flex: 1;">
      <view style="border-bottom: 1rpx solid #e2e8f0; padding: 4rpx 0; display: flex; justify-content: space-between; align-items: center;">
        <text style="color: {{pickupStartTime ? '#333' : '#999'}};">{{pickupTimeLabel}}</text>
        <text wx:if="{{pickupStartTime}}" style="color: #e64340; font-size: 24rpx; padding-left: 20rpx;" catchtap="clearPickupTime">清除</text>
        <text wx:else style="color: #ccc; font-size: 24rpx;">▼</text>
      </view>
    </picker>
  </view>
</view>
    <!-- 底部按钮 -->
    <view class="bottom-bar">
      <view class="price-info">
        <text class="label">预估运费</text>
        <text class="value" wx:if="{{orderDetail.jd_freight > 0}}">¥ {{orderDetail.jd_freight}}</text>
        <text class="value" wx:else style="font-size: 22rpx; font-weight: normal; color: #8A9684;">以快递员实际揽收为准</text>
      </view>
      <button class="submit-btn" disabled="{{isSubmitting || precheckLoading}}" bindtap="onSubmitJDExpress">
        {{isSubmitting ? '派单中...' : '确认呼叫京东快递'}}
      </button>
    </view>
  </view>
</view>