/* 页面容器 */
.page-container {
  padding: 20rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 加载样式 */
.loading-box {
  text-align: center;
  padding: 100rpx 0;
  color: #666;
  font-size: 28rpx;
}

/* 订单信息 */
.order-info {
  background: #fff;
  padding: 20rpx 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #666;
}

/* 卡片容器 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

/* 卡片标题 */
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #007aff;
  padding-left: 16rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 标签 */
.label {
  font-size: 28rpx;
  color: #555;
  line-height: 1.2;
}

/* 输入框 */
.input {
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e5e6eb;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fff;
}

/* 地区选择器 */
.region-picker {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e5e6eb;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  background: #fff;
}

/* 多行输入框 */
.textarea {
  min-height: 120rpx;
  padding: 20rpx;
  border: 1rpx solid #e5e6eb;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fff;
  resize: none;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 40rpx;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
}