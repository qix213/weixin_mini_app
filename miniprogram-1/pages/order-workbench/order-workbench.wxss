/* 订单页面基础样式 */
.container {
  padding: 0;
  background-color: #f5f5f5;
  min-height: 100vh;
}
.loading {
  text-align: center;
  padding: 50rpx 0;
  font-size: 28rpx;
  color: #999;
}
.main {
  padding-bottom: 20rpx;
}
.tab-scroll {
  background-color: #fff;
  white-space: nowrap;
}
.tab-list {
  display: flex;
  padding: 0 20rpx;
}
.tab-item {
  padding: 20rpx 30rpx;
  font-size: 28rpx;
}
.tab-item.active {
  color: #007aff;
  position: relative;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #007aff;
}
.empty {
  text-align: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #999;
}
.order-list {
  padding: 20rpx;
}
.order-card {
  background-color: #fff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1px solid #f5f5f5;
}
.header-left {
  display: flex;
  flex-direction: column;
}
.order-sn {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 5rpx;
}
.status {
  font-size: 24rpx;
  color: #007aff;
}
.header-right {
  display: flex;
  align-items: center;
}
.total-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #e64340;
  margin-right: 20rpx;
}
.toggle-icon {
  font-size: 24rpx;
  color: #999;
}
.order-detail {
  padding: 20rpx;
}
.detail-row {
  display: flex;
  margin-bottom: 10rpx;
  font-size: 26rpx;
}
.label {
  color: #999;
  width: 120rpx;
  flex-shrink: 0;
}
.value {
  color: #333;
  flex: 1;
}
.detail-section {
  margin-top: 20rpx;
  border-top: 1px solid #f5f5f5;
  padding-top: 20rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}
.no-express {
  padding: 10rpx 0;
  color: #999;
  font-size: 26rpx;
}
.express-tracks {
  margin-top: 10rpx;
}
.track-title {
  font-size: 26rpx;
  color: #007aff;
  padding: 10rpx 0;
  display: block;
}
.track-list {
  margin-left: 20rpx;
}
.track-item {
  display: flex;
  flex-direction: column;
  padding: 10rpx 0;
  border-bottom: 1px solid #f5f5f5;
}
.track-time {
  font-size: 24rpx;
  color: #999;
}
.track-content {
  font-size: 26rpx;
  margin-top: 5rpx;
  color: #333;
}
.goods-header {
  display: flex;
  font-size: 26rpx;
  color: #999;
  padding: 10rpx 0;
  border-bottom: 1px solid #f5f5f5;
}
.col-goods {
  flex: 2;
}
.col-num {
  flex: 1;
  text-align: center;
}
.col-price {
  flex: 1;
  text-align: center;
}
.col-total {
  flex: 1;
  text-align: right;
}
.goods-list {
  padding: 10rpx 0;
}
.goods-item {
  display: flex;
  font-size: 26rpx;
  padding: 10rpx 0;
  border-bottom: 1px solid #f5f5f5;
}