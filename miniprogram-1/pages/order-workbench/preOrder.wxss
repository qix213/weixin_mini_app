/* ================== 全局与配色变量 ================== */
/* 主色调：蓝青色 (#00A0B0, #00CFD6)
  背景色：极浅青灰 (#F4F7F9)
  文字色：深青黑 (#1C2B33) / 中青灰 (#5B6D75)
*/
page {
  background-color: #F4F7F9;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "Segoe UI", Arial, sans-serif;
  padding-bottom: 160rpx; /* 为底部悬浮按钮留出充足空间 */
}

.container {
  padding: 24rpx;
}

/* ================== 加载动画 ================== */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  color: #8A9CA5;
  font-size: 28rpx;
}
.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E0F0F5;
  border-top-color: #00A0B0;
  border-radius: 50%;
  animation: spin 1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  margin-bottom: 24rpx;
}
@keyframes spin { 
  to { transform: rotate(360deg); } 
}

/* ================== 状态提示条 ================== */
.status-banner {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 32rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}
/* 成功：极浅的蓝青色背景 */
.status-banner.success { 
  background-color: #E6F7F8; 
  color: #00848E; 
}
/* 失败：柔和的浅红色背景 */
.status-banner.error { 
  background-color: #FFF0F0; 
  color: #D93025; 
}

.status-banner .icon { 
  font-size: 32rpx; 
  margin-right: 16rpx; 
  line-height: 1.2; 
}
.status-banner .text { 
  flex: 1; 
  display: flex; 
  flex-direction: column; 
}
.status-banner .title { 
  font-size: 28rpx; 
  font-weight: 600; 
  margin-bottom: 6rpx; 
}
.status-banner .desc { 
  font-size: 24rpx; 
  line-height: 1.5; 
  opacity: 0.85; 
}

/* ================== 通用卡片 ================== */
.card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 115, 130, 0.04); /* 微弱的蓝青色投影 */
}

.card-header {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C2B33;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
}
/* 卡片标题左侧的高级感蓝青色装饰条 */
.card-header::before {
  content: "";
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(to bottom, #00CFD6, #00A0B0);
  border-radius: 6rpx;
  margin-right: 14rpx;
}

/* ================== 地址卡片 ================== */
.address-item {
  display: flex;
  align-items: flex-start;
  position: relative;
}
.icon-tag {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
/* 寄件图标：蓝青色渐变 */
.icon-tag.blue { 
  background: linear-gradient(135deg, #00CFD6 0%, #0096A6 100%); 
  box-shadow: 0 4rpx 12rpx rgba(0, 150, 166, 0.2);
}
/* 收件图标：高级橘红渐变 */
.icon-tag.red { 
  background: linear-gradient(135deg, #FFA984 0%, #FF6B6B 100%); 
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.2);
}

.info { 
  flex: 1; 
  display: flex; 
  flex-direction: column; 
}
.name-phone { 
  font-size: 30rpx; 
  font-weight: 600; 
  color: #1C2B33; 
  margin-bottom: 8rpx; 
  display: flex; 
  align-items: center; 
}
/* 兼容收件人信息中独立的两个 name-phone view */
.receiver .name-phone {
  display: inline-block;
  margin-right: 20rpx;
}
.name-phone .name { 
  margin-right: 16rpx; 
}
.name-phone .phone { 
  font-size: 28rpx; 
  color: #5B6D75; 
  font-weight: 400; 
}
.addr { 
  font-size: 26rpx; 
  color: #5B6D75; 
  line-height: 1.6; 
}

/* 箭头美化 */
.arrow-right { 
  color: #B0C4CC; 
  font-size: 32rpx; 
  font-family: consolas; 
  margin-left: 20rpx; 
  align-self: center; 
}

.address-divider {
  height: 1rpx;
  background-color: #F0F4F5;
  margin: 32rpx 0 32rpx 76rpx; /* 对齐文字内容 */
}

/* ================== 商品卡片 ================== */
.goods-item {
  display: flex;
  align-items: stretch;
  margin-bottom: 32rpx;
}
.goods-item:last-child { 
  margin-bottom: 20rpx; 
}

.goods-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background-color: #F4F7F9;
  margin-right: 24rpx;
  flex-shrink: 0;
  border: 1rpx solid #EBF0F2;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  padding: 4rpx 0;
}
.goods-name { 
  font-size: 28rpx; 
  color: #1C2B33; 
  font-weight: 500; 
  line-height: 1.4; 
  display: -webkit-box; 
  -webkit-line-clamp: 2; 
  -webkit-box-orient: vertical; 
  overflow: hidden; 
}
.goods-price { 
  font-size: 32rpx; 
  color: #00A0B0; /* 价格使用主色调凸显 */
  font-weight: 600; 
  margin-top: auto; 
  font-family: DIN, sans-serif; /* 若手机支持，展现更好看的数字 */
}
.goods-num { 
  font-size: 26rpx; 
  color: #8A9CA5; 
  position: absolute; 
  right: 0; 
  bottom: 6rpx; 
}

.empty-tip { 
  text-align: center; 
  color: #A4B4BC; 
  font-size: 28rpx; 
  padding: 40rpx 0; 
}

.package-summary {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #EBF0F2;
  text-align: right;
  font-size: 26rpx;
  color: #8A9CA5;
}

/* ================== 底部操作栏 ================== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background-color: #FFFFFF;
  padding: 0 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 24rpx rgba(0, 30, 40, 0.04);
  z-index: 100;
}

.price-info { 
  display: flex; 
  flex-direction: column; 
  justify-content: center; 
}
.price-info .label { 
  font-size: 24rpx; 
  color: #5B6D75; 
  margin-bottom: 6rpx; 
}
.price-info .value { 
  font-size: 28rpx; 
  color: #00A0B0; 
  font-weight: 600; 
}

/* 核心呼叫按钮：蓝青渐变，取消外边距 */
.submit-btn {
  margin: 0;
  width: 360rpx;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #00CFD6 0%, #0096A6 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 42rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(0, 150, 166, 0.25);
  transition: all 0.3s ease;
}
.submit-btn::after { 
  display: none; /* 移除微信按钮默认边框 */
}
/* 禁用状态：褪色处理 */
.submit-btn[disabled] { 
  background: #C4E8EB !important; 
  color: #FFFFFF !important; 
  box-shadow: none; 
}