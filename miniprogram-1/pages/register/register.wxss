/* --- 基础与背景 --- */
page { background: #f0f9ff; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif; }
.register-container { padding: 40rpx 30rpx; min-height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; }
.dynamic-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; background: linear-gradient(-45deg, #e0f2fe, #ffffff, #bae6fd); background-size: 400% 400%; }

/* --- 玻璃卡片 --- */
.glass-card { 
  background: rgba(255, 255, 255, 0.85); 
  backdrop-filter: blur(20px); 
  border: 2rpx solid rgba(255,255,255,1); 
  border-radius: 30rpx; 
  box-shadow: 0 10rpx 40rpx rgba(14, 165, 233, 0.08); 
}
.main-form-card { padding: 10rpx 30rpx 30rpx; margin-bottom: 40rpx; }

/* --- Tab栏 --- */
.tab-bar { display: flex; margin-bottom: 30rpx; border-bottom: 2rpx dashed rgba(14, 165, 233, 0.15); }
.tab-item { flex: 1; text-align: center; padding: 30rpx 0 20rpx; font-size: 32rpx; color: #64748b; font-weight: bold; position: relative; transition: all 0.3s; }
.tab-active { color: #0ea5e9; font-weight: 800; }
.tab-active::after { content: ''; position: absolute; bottom: -2rpx; left: 50%; transform: translateX(-50%); width: 60rpx; height: 6rpx; background: linear-gradient(135deg, #38bdf8, #0ea5e9); border-radius: 6rpx; }

/* --- 输入项 --- */
.input-item { display: flex; align-items: center; background: rgba(241, 245, 249, 0.7); border: 2rpx solid rgba(255,255,255,0.8); border-radius: 20rpx; padding: 0 24rpx; margin-bottom: 24rpx; height: 96rpx; transition: all 0.3s; }
.input-item:focus-within { background: #fff; border-color: #7dd3fc; box-shadow: 0 0 15rpx rgba(14, 165, 233, 0.1); }
.input-label { width: 150rpx; font-size: 28rpx; color: #334155; font-weight: bold; }
.input-content, .picker-content { flex: 1; font-size: 28rpx; color: #1e293b; font-weight: 500; height: 100%; display: flex; align-items: center; }
.picker-content { justify-content: space-between; }
.picker-text { color: #0ea5e9; font-weight: bold; }
.ph-style { color: #94a3b8; font-weight: normal; }
.disabled-content { color: #0284c7; font-weight: 800; letter-spacing: 1rpx; }
.arrow { color: #94a3b8; font-size: 20rpx; margin-left: 10rpx; transition: all 0.3s;}

/* --- 刷新按钮 --- */
.refresh-btn { height: 60rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #e0f2fe, #bae6fd); color: #0284c7; font-size: 24rpx; font-weight: 800; border-radius: 16rpx; padding: 0 24rpx; border: 1rpx solid rgba(56, 189, 248, 0.3); margin: 0; }
.refresh-btn::after { border: none; }

/* --- 🌟 伸缩日期选择面板 --- */
.date-picker-panel { max-height: 0; opacity: 0; overflow: hidden; transition: all 0.3s ease; }
.date-picker-panel.expanded { max-height: 500rpx; opacity: 1; margin-bottom: 24rpx; }
.dp-inner { background: #fff; border-radius: 20rpx; padding: 20rpx; border: 2rpx solid #e0f2fe; box-shadow: 0 4rpx 15rpx rgba(14, 165, 233, 0.05); }
.dp-header { display: flex; align-items: center; margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 2rpx dashed #e2e8f0; }
.dp-crumb { font-size: 24rpx; color: #64748b; padding: 8rpx 16rpx; border-radius: 12rpx; font-weight: 500; transition: all 0.2s; }
.dp-crumb.active { color: #fff; background: #0ea5e9; box-shadow: 0 4rpx 10rpx rgba(14, 165, 233, 0.3); }
.dp-sep { margin: 0 6rpx; color: #cbd5e1; }
.dp-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.dp-btn { background: #f8fafc; text-align: center; padding: 16rpx 0; font-size: 24rpx; border-radius: 12rpx; border: 2rpx solid #f1f5f9; color: #334155; font-weight: 500; }
.dp-btn:active { background: #e0f2fe; color: #0ea5e9; border-color: #bae6fd; }
.col-3 .dp-btn { width: calc(33.33% - 8rpx); }
.col-4 .dp-btn { width: calc(25% - 9rpx); }
.col-6 .dp-btn { width: calc(16.66% - 10rpx); font-size: 22rpx; padding: 12rpx 0; }

.shop-notice { font-size: 22rpx; color: #ef4444; background: rgba(239, 68, 68, 0.05); padding: 16rpx 20rpx; border-radius: 12rpx; margin-bottom: 24rpx; display: flex; align-items: center; border: 1px dashed rgba(239, 68, 68, 0.2); }

/* --- 🌟 底部操作区 --- */
.action-area { margin-top: auto; padding: 0 10rpx; }

.agreement-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  width: 100%;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  border: 2rpx solid #cbd5e1;
  background: #fff;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.checkbox.checked { background: #0ea5e9; border-color: #0ea5e9; box-shadow: 0 2rpx 8rpx rgba(14, 165, 233, 0.4); }
.check-mark { color: #fff; font-size: 24rpx; font-weight: bold; }

.text-group {
  display: flex;
  align-items: center;
  font-size: 26rpx;
}
.agree-text { color: #64748b; }
.link-text { color: #0ea5e9; font-weight: bold; }

.register-btn { width: 100% !important; height: 96rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #0ea5e9, #2563eb); color: #fff; font-size: 32rpx; font-weight: 800; border-radius: 48rpx; box-shadow: 0 10rpx 25rpx rgba(14, 165, 233, 0.3); transition: transform 0.2s; }
.register-btn::after { border: none; }
.register-btn:active { transform: scale(0.98); }

/* ================= 🌟 协议弹窗样式 ================= */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(5px);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  width: 85%;
  background: #fff;
  border-radius: 30rpx;
  padding: 40rpx 40rpx 50rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.15);
}

.modal-header {
  font-size: 36rpx;
  font-weight: 900;
  color: #1e293b;
  text-align: center;
  margin-bottom: 30rpx;
}

.modal-body {
  max-height: 600rpx; /* 给长文本留出足够的滚动空间 */
  font-size: 26rpx;
  color: #475569;
  line-height: 1.8;
  margin-bottom: 40rpx;
}

.agreement-text {
  white-space: pre-wrap; /* 完美保留文案里的回车换行符 */
}

.modal-footer {
  display: flex;
  justify-content: center;
}

.agree-btn {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  margin: 0;
}

