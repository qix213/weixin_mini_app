.register-container {
  padding: 40rpx 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ====== 强化版Tab栏样式 ====== */
.tab-bar {
  display: flex;
  justify-content: space-between;
  background-color: #fff;
  border-radius: 20rpx; /* 更大圆角 */
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 15rpx rgba(22, 119, 255, 0.15); /* 淡蓝色外阴影 */
  overflow: hidden; /* 裁剪圆角内的内容 */
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0; /* 更大内边距，点击区域更大 */
  font-size: 36rpx; /* 更大字体 */
  color: #333;
  font-weight: 500;
  position: relative;
  transition: all 0.3s ease; /* 平滑过渡 */
}
/* 选中态强化 */
.tab-active {
  background-color: #1677ff; /* 选中态背景色 */
  color: #fff !important; /* 白色字体 */
  font-weight: bold; /* 加粗 */
  box-shadow: inset 0 -2rpx 8rpx rgba(0, 0, 0, 0.1); /* 内阴影 */
}
/* 未选中态hover效果（可选） */
.tab-item:not(.tab-active):active {
  background-color: #f0f7ff; /* 轻触高亮 */
}

.input-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  position: relative;
}

.code-input-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.code-input {
  flex: 1;
  margin-right: 20rpx;
}

.input-label {
  font-size: 32rpx;
  color: #666;
  width: 160rpx;
}

.input-content, .picker-content {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  padding: 10rpx 0;
}

.disabled-content {
  color: #999;
}

.refresh-btn {
  position: absolute;
  right: 20rpx;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  background-color: #1677ff;
  color: #fff;
  border-radius: 20rpx;
}

.get-code-btn {
  width: 180rpx;
  height: 55rpx;
  line-height: 55rpx;
  background-color: #1677ff;
  color: #fff;
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 0;
}

.btn-disabled {
  background-color: #ccc !important;
  color: #999 !important;
}

.benefit-container {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.benefit-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.benefit-list {
  font-size: 28rpx;
  color: #666;
}

.benefit-item {
  margin-bottom: 15rpx;
  line-height: 1.6;
}

.register-btn {
  width: 100%;
  height: 88rpx;
	line-height: 88rpx;
  background-color: #1677ff;
  color: #fff;
  font-size: 34rpx;
  border-radius: 10rpx;
  margin-top: 20rpx;
  margin-bottom: 60rpx;
}