/* ================= 全局与背景 ================= */
page {
  background: #f0f9ff;
  min-height: 100vh;
}

.register-container {
  position: relative;
  min-height: 100vh;
  padding: 40rpx 24rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.dynamic-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  background: linear-gradient(-45deg, #e0f2fe, #ffffff, #bae6fd, #f8fafc);
  background-size: 400% 400%;
  animation: gradientBG 15s ease infinite;
}

@keyframes gradientBG {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ================= 通用毛玻璃卡片 ================= */
.glass-card {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 2rpx solid rgba(255, 255, 255, 1);
  border-radius: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(14, 165, 233, 0.08);
}

.main-form-card {
  padding: 10rpx 30rpx 30rpx;
  margin-bottom: 30rpx;
}

/* ================= Tab切换栏 ================= */
.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 40rpx;
  border-bottom: 2rpx dashed rgba(14, 165, 233, 0.2);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0 20rpx;
  font-size: 32rpx;
  color: #64748b;
  font-weight: 600;
  position: relative;
  transition: all 0.3s;
}

.tab-active {
  color: #0ea5e9;
  font-weight: 800;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #38bdf8, #0ea5e9);
  border-radius: 6rpx;
  box-shadow: 0 4rpx 10rpx rgba(14, 165, 233, 0.4);
}

/* ================= 表单输入区 ================= */
.input-item {
  display: flex;
  align-items: center;
  background: rgba(241, 245, 249, 0.6);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  padding: 10rpx 24rpx;
  margin-bottom: 24rpx;
  height: 96rpx;
  transition: all 0.3s ease;
}

.input-item:focus-within {
  background: rgba(255, 255, 255, 0.9);
  border-color: #7dd3fc;
  box-shadow: 0 0 15rpx rgba(14, 165, 233, 0.15);
}

.input-label {
  width: 150rpx;
  font-size: 28rpx;
  color: #334155;
  font-weight: bold;
}

.input-content {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 500;
  height: 100%;
}

.ph-style { color: #94a3b8; font-weight: 400; }
.disabled-content { color: #0284c7; font-weight: 800; display: flex; align-items: center; }

/* 验证码与刷新按钮 */
.code-input-wrap { padding-right: 12rpx; }

.get-code-btn, .refresh-btn {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e0f2fe, #bae6fd);
  color: #0284c7;
  font-size: 24rpx;
  font-weight: 800;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin: 0;
  border: 1rpx solid rgba(56, 189, 248, 0.4);
}
.get-code-btn::after, .refresh-btn::after { border: none; }
.get-code-btn:active, .refresh-btn:active { transform: scale(0.96); }
.btn-disabled { background: rgba(226, 232, 240, 0.5) !important; color: #94a3b8 !important; border-color: rgba(255, 255, 255, 0.5) !important; }

/* 选择器 */
.picker-content {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #0ea5e9;
}
.picker-content .arrow { font-size: 20rpx; color: #94a3b8; margin-left: 10rpx;}

/* ================= 权益预览卡片 ================= */
.benefit-container {
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.benefit-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1e293b;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.benefit-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #38bdf8, #0ea5e9);
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.benefit-list {
  background: rgba(248, 250, 252, 0.6);
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx dashed rgba(14, 165, 233, 0.3);
}

.benefit-item {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
  margin-bottom: 12rpx;
  display: flex;
}
.benefit-item:last-child { margin-bottom: 0; }
.benefit-item .dot { color: #0ea5e9; font-weight: bold; margin-right: 8rpx;}
.empty-benefit { color: #94a3b8; font-style: italic; justify-content: center; }

/* ================= 底部操作区 (协议+注册按钮) ================= */
.action-area {
  margin-top: auto;
  padding: 0 10rpx;
}

.agreement-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  font-size: 26rpx;
}

.checkbox-container {
  display: flex;
  align-items: center;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid #cbd5e1;
  background: #fff;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.checkbox.checked {
  background: #0ea5e9;
  border-color: #0ea5e9;
  box-shadow: 0 2rpx 8rpx rgba(14, 165, 233, 0.4);
}

.check-mark {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.agree-text { color: #64748b; }
.link-text { color: #0ea5e9; font-weight: bold; }

.register-btn {
  width: 100% !important;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  color: #fff;
  font-size: 34rpx;
  font-weight: 800;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(14, 165, 233, 0.4);
  transition: transform 0.2s;
}
.register-btn::after { border: none; }
.register-btn:active { transform: scale(0.98); }

/* ================= 沉浸式弹窗 (用户须知) ================= */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.5); /* 加深一点遮罩，突显弹窗 */
  backdrop-filter: blur(6px);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.modal-content {
  width: 100%;
  height: 75vh; /* ⚡️核心修复：给弹窗一个绝对的固定高度 */
  display: flex;
  flex-direction: column;
  padding: 0;
  overflow: hidden;
  animation: slideUp 0.3s ease-out;
  background: rgba(255, 255, 255, 0.95); /* 让文字阅读区更实，提升可读性 */
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.modal-header {
  padding: 30rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
  color: #1e293b;
  border-bottom: 2rpx dashed rgba(14, 165, 233, 0.2);
  flex-shrink: 0; /* 防止头部被压缩 */
}

.modal-body {
  height: 100%; /* ⚡️核心修复：让 scroll-view 撑满剩余固定高度，激活滚动 */
  padding: 30rpx;
  box-sizing: border-box;
}

.modal-body .h3 {
  font-size: 30rpx;
  font-weight: 800;
  color: #0ea5e9;
  margin-top: 30rpx;
  margin-bottom: 12rpx;
}
.modal-body .h3:first-child { margin-top: 0; }

.modal-body .p {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.6;
  margin-bottom: 16rpx;
  text-align: justify;
}

.modal-body .sub-p {
  padding-left: 20rpx;
  color: #64748b;
}

.modal-footer {
  padding: 24rpx 30rpx 30rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 -4rpx 15rpx rgba(0,0,0,0.03);
  flex-shrink: 0; /* 防止尾部被压缩 */
}

.modal-btn {
  width: 100% !important;
  height: 88rpx;
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(14, 165, 233, 0.3);
}
.modal-btn:active {
  transform: scale(0.97);
}