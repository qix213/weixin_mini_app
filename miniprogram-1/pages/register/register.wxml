<view class="register-container">
  <!-- ====== 移除原页面内的“用户注册”标题 ====== -->

  <!-- ====== 强化版Tab切换栏 ====== -->
  <view class="tab-bar">
    <view 
      class="tab-item {{activeTab === 0 ? 'tab-active' : ''}}"
      data-tabid="0"
      bindtap="switchTab"
    >
      成为会员
    </view>
    <view 
      class="tab-item {{activeTab === 1 ? 'tab-active' : ''}}"
      data-tabid="1"
      bindtap="switchTab"
    >
      我要开店
    </view>
  </view>

  <!-- 自动生成8位会员ID展示 -->
  <view class="input-item">
    <label class="input-label">会员ID</label>
    <view class="input-content disabled-content">{{memberId}}</view>
    <button class="refresh-btn" bindtap="refreshMemberId">刷新</button>
  </view>

  <!-- 昵称 -->
  <view class="input-item">
    <label class="input-label">昵称</label>
    <input 
      class="input-content" 
      placeholder="请设置昵称" 
      bindinput="handleNicknameInput"
      value="{{nickname}}"
    />
  </view>

  <!-- 手机号 -->
  <view class="input-item">
    <label class="input-label">手机号</label>
    <input 
      class="input-content" 
      placeholder="请输入11位手机号" 
      bindinput="handlePhoneInput"
      value="{{phone}}"
      type="number"
    />
  </view>

  <!-- 验证码 -->
  <view class="input-item code-input-wrap">
    <label class="input-label">验证码</label>
    <input 
      class="input-content code-input" 
      placeholder="请输入6位验证码" 
      bindinput="handleCodeInput"
      value="{{verifyCode}}"
    />
    <button 
      class="get-code-btn {{countDown > 0 ? 'btn-disabled' : ''}}"   
      bindtap="handleGetVerifyCode"
      disabled="{{countDown > 0}}"
    >
      {{countDown > 0 ? countDown + 's后重新获取' : '获取验证码'}}
    </button>
  </view>

  <!-- 密码 -->
  <view class="input-item">
    <label class="input-label">密码</label>
    <input 
      class="input-content" 
      placeholder="8位以上数字+字母组合" 
      password
      bindinput="handlePasswordInput"
      value="{{password}}"
    />
  </view>

  <!-- 确认密码 -->
  <view class="input-item">
    <label class="input-label">确认密码</label>
    <input 
      class="input-content" 
      placeholder="请再次输入密码" 
      password
      bindinput="handlePasswordConfirmInput"
      value="{{passwordConfirm}}"
    />
  </view>

  <!-- 会员/开店类型选择 -->
  <view class="input-item">
    <label class="input-label">{{activeTab === 0 ? '会员类型' : '开店类型'}}</label>
    <picker 
      mode="selector" 
      range="{{activeTab === 0 ? memberTypeList : shopTypeList}}" 
      range-key="name" 
      bindchange="handleUserTypeChange" 
      value="{{userTypeIndex}}"
    >
      <view class="picker-content">{{selectedUserType.name}}</view>
    </picker>
  </view>

  <!-- 权益预览 -->
  <view class="benefit-container">
    <view class="benefit-title">{{activeTab === 0 ? '会员权益预览' : '开店权益预览'}}</view>
    <view class="benefit-list">
      <block wx:for="{{currentBenefits}}" wx:key="index">
        <view class="benefit-item">• {{item}}</view>
      </block>
    </view>
  </view>

  <!-- 推荐人ID -->
  <view class="input-item">
    <label class="input-label">推荐人ID</label>
    <input 
      class="input-content" 
      placeholder="请输入8位数字+字母推荐人ID" 
      bindinput="handleRecommenderIdInput"
      value="{{recommenderId}}"
    />
  </view>

  <!-- 注册按钮 -->
  <button class="register-btn" bindtap="handleRegister">提交注册</button>
</view>