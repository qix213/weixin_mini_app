/* 页面基础：全面适配奶油可可白 */
.pay-container {
  min-height: 100vh;
  position: relative;
  padding-bottom: 240rpx; 
  background-color: #F7F5F0; /* 🌟 核心：奶油可可白底色，温润高雅 */
}

/* 动态渐变背景层：采用 #94A48C 灰绿向柔和浅灰绿过渡 */
.dynamic-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 420rpx;
  background: linear-gradient(135deg, #94A48C 0%, #A7B6A0 100%);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  z-index: 0;
}

.content-wrapper {
  position: relative;
  z-index: 1;
  padding: 40rpx 30rpx;
}

/* 带有微弱奶油色温的玻璃质感面板 */
.glass-panel {
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(15px);
  border-radius: 28rpx;
  padding: 35rpx 30rpx;
  box-shadow: 0 12rpx 40rpx rgba(148, 164, 140, 0.08); /* 灰绿色调的柔和阴影 */
  margin-bottom: 30rpx;
}

/* 订单卡片内部 */
.order-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #3E443A; /* 深灰绿，替代纯黑，提升质感 */
  margin-bottom: 40rpx;
  text-align: center;
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  font-size: 28rpx;
  color: #6E756A; /* 灰绿中间色 */
}

.amount {
  font-weight: 500;
  color: #3E443A;
}

.divider {
  height: 2rpx;
  background-color: #EAE6DF; /* 淡淡的可可色分割线 */
  margin: 30rpx 0;
}

.amount-item .label {
  font-size: 32rpx;
  font-weight: 500;
  color: #3E443A;
}

/* 实付金额：使用深琥珀/深焦糖色或深植物绿突出，这里采用呼应色调的深暖色，避免艳红破坏高级感 */
.final-amount {
  font-size: 48rpx;
  font-weight: bold;
  color: #826E59; /* 优雅的可可深咖色，与奶油白、灰绿绝配 */
}

/* 优惠券选择器 */
.native-picker {
  flex: 1;
  text-align: right;
}

.picker-text {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.picker-val {
  color: #A3A9A0;
}
.val-active {
  color: #826E59; /* 激活时变为深可可色 */
  font-weight: 500;
}

.picker-arrow {
  font-size: 20rpx;
  color: #C2C7BF;
  margin-left: 10rpx;
}

/* 支付方式选择面板 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3E443A;
  margin-bottom: 24rpx;
}

.method-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 10rpx;
  border-bottom: 2rpx solid #F2EFE9;
  transition: all 0.3s;
}
.method-item:last-child {
  border-bottom: none;
}

/* 选中某种支付方式时的优雅微亮包裹块 */
.method-item.item-active {
  background-color: rgba(148, 164, 140, 0.05); /* 极淡的灰绿呼吸感底色 */
  border-radius: 16rpx;
}

.item-left {
  display: flex;
  align-items: center;
}

.icon-box {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: bold;
  margin-right: 24rpx;
  font-size: 26rpx;
}
/* 微信图标和小程序图标统一融入高定色系 */
.wx-color { background-color: #809078; } 
.wallet-color { background: linear-gradient(135deg, #94A48C, #7A8A73); }

.name {
  font-size: 29rpx;
  color: #3E443A;
}

.balance-tag {
  font-size: 25rpx;
  color: #8A9285;
  margin-left: 12rpx;
}

/* 底部操作区 */
.action-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 24rpx 40rpx 64rpx;
  background-color: #FAF9F6; /* 奶油质感底色 */
  box-shadow: 0 -6rpx 30rpx rgba(148, 164, 140, 0.05);
  box-sizing: border-box;
  z-index: 10;
}

.pay-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(148, 164, 140, 0.2);
}

/* 微信和钱包统一采用主调灰绿及其深色延展，完美告别突兀的亮蓝色 */
.btn-wechat { background: #809078; }
.btn-wallet { background: linear-gradient(135deg, #94A48C, #7A8A73); }

.cancel-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background-color: #EFECE6; /* 淡淡的奶油可可灰白 */
  color: #7A8075;
  font-size: 28rpx;
  border: none;
}

.cancel-btn::after, .pay-btn::after {
  border: none;
}

/* 积分步进器（完美融入新皮肤） */
.stepper-glass {
  display: flex;
  align-items: center;
  background: #EFECE6;
  border-radius: 12rpx;
  overflow: hidden;
}
.btn-minus, .btn-plus {
  width: 64rpx;
  height: 56rpx;
  text-align: center;
  line-height: 56rpx;
  color: #5E655A;
  font-weight: bold;
}
.point-input {
  width: 104rpx;
  text-align: center;
  font-size: 26rpx;
  background: #fff;
  height: 56rpx;
  color: #3E443A;
}
.btn-all {
  font-size: 26rpx;
  color: #94A48C;
  margin-left: 16rpx;
  font-weight: 500;
}
.highlight-theme {
  color: #7A8A73; /* 主题高亮灰绿 */
  font-weight: 500;
}
.max-tip {
  font-size: 22rpx;
  color: #A3A9A0;
  margin-left: 12rpx;
}