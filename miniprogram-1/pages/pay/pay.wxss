/* ================= 全局与背景 (轻奢奶油风) ================= */
page {
  background: #FAF8F5; /* 奶油可可白 */
  min-height: 100vh;
  color: #2C3327;
}

.pay-container {
  position: relative;
  padding: 40rpx 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.dynamic-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  /* 温润的白绿交织微渐变 */
  background: linear-gradient(-45deg, #FAF8F5, #FFFFFF, #F4F6F2, #F8F9F5);
  background-size: 400% 400%;
  animation: gradientBG 15s ease infinite;
}

@keyframes gradientBG {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ================= 订单信息卡片 (高透玻璃质感) ================= */
.order-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(148, 164, 140, 0.15); /* 莫兰迪绿极细边框 */
  border-radius: 24rpx; /* 收敛圆角，显得更精致 */
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(148, 164, 140, 0.05); /* 轻柔弥散阴影 */
  margin-bottom: 50rpx;
}

.order-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3327;
  text-align: center;
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 1px solid rgba(148, 164, 140, 0.1); /* 摒弃虚线，改用高级细实线 */
  letter-spacing: 2rpx;
}

.order-item {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.label {
  color: #8A8E88; /* 柔和的高级灰 */
  width: 180rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.amount {
  color: #7A8B72; /* 沉稳的草木绿 */
  font-size: 36rpx;
  font-weight: bold;
  font-family: 'DIN Alternate', 'PingFang SC', sans-serif;
}

.highlight-blue {
  color: #94A48C !important; /* 替换原有的蓝色高亮为品牌绿 */
  font-weight: bold;
}

.amount-item {
  justify-content: space-between;
  margin-top: 40rpx;
  margin-bottom: 0;
  padding: 30rpx;
  background: rgba(148, 164, 140, 0.04); /* 极淡的底色包裹 */
  border-radius: 16rpx;
  border: 1px solid rgba(148, 164, 140, 0.1);
}

.final-amount {
  font-size: 48rpx;
  color: #2C3327; /* 最终金额用深色，显得庄重 */
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
}

/* ================= 优惠券下拉框 ================= */
.coupon-dropdown {
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1px solid rgba(148, 164, 140, 0.1);
}

.native-picker {
  flex: 1;
}

.picker-text {
  font-size: 28rpx;
  color: #7A8B72;
  font-weight: 600;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-val { flex: 1; text-align: right; }
.picker-arrow { font-size: 20rpx; color: #CBD5E1; margin-left: 10rpx; }

/* ================= 积分抵扣区域 ================= */
.point-operate-area {
  margin: 30rpx 0;
  padding: 30rpx 0;
  border-top: 1px solid rgba(148, 164, 140, 0.1);
  border-bottom: 1px solid rgba(148, 164, 140, 0.1);
}

.point-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.max-tip {
  margin-left: auto;
  font-size: 22rpx;
  color: #94A48C;
  background: rgba(148, 164, 140, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.point-deduct-op {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.stepper-glass {
  display: flex;
  align-items: center;
  background: #F8F9F5;
  border: 1px solid rgba(148, 164, 140, 0.15);
  border-radius: 12rpx;
  overflow: hidden;
  height: 60rpx;
}

.btn-minus, .btn-plus {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #6B7067;
  background: transparent;
}

.btn-minus:active, .btn-plus:active { background: rgba(148, 164, 140, 0.1); }

.point-input {
  width: 100rpx;
  height: 60rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #2C3327;
  border-left: 1px solid rgba(148, 164, 140, 0.15);
  border-right: 1px solid rgba(148, 164, 140, 0.15);
}

.btn-all {
  height: 60rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
  background: transparent;
  color: #7A8B72;
  border: 1px solid #94A48C;
  border-radius: 30rpx; /* 胶囊形按钮 */
  transition: all 0.2s;
}

.btn-all:active {
  background: rgba(148, 164, 140, 0.1);
}

.point-deduct-tip {
  font-size: 24rpx;
  color: #8A8E88;
  padding-left: 180rpx;
}

/* ================= 返现余额区域 ================= */
.balance-operate-area {
  margin: 30rpx 0;
  padding: 30rpx 0;
  border-top: 1px solid rgba(148, 164, 140, 0.1);
  border-bottom: 1px solid rgba(148, 164, 140, 0.1);
}

.balance-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.balance-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #2C3327;
}

.balance-text {
  margin-left: 10rpx;
  font-size: 34rpx;
  font-weight: bold;
  color: #4CAF50; /* 现金绿色 */
  font-family: 'DIN Alternate', 'PingFang SC', sans-serif;
}

.balance-tip {
  margin-left: auto;
  font-size: 22rpx;
  color: #94A48C;
  background: rgba(76, 175, 80, 0.08);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

/* ================= 支付方式选择模块 ================= */
.pay-methods-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3327;
  margin-bottom: 24rpx;
  padding-left: 10rpx;
}

.pay-methods-container {
  display: flex;
  gap: 20rpx;
  margin-bottom: 60rpx;
}

.pay-method-item {
  flex: 1;
  background: #FFFFFF;
  border: 1px solid rgba(148, 164, 140, 0.1);
  border-radius: 20rpx;
  padding: 30rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4rpx 16rpx rgba(148, 164, 140, 0.03);
}

/* 选中状态：莫兰迪绿微光 */
.pay-method-selected {
  border-color: #94A48C !important;
  background: rgba(148, 164, 140, 0.04) !important;
  box-shadow: 0 8rpx 20rpx rgba(148, 164, 140, 0.1) !important;
  transform: translateY(-2rpx);
}

.pay-method-icon {
  width: 56rpx;
  height: 56rpx;
}

.pay-method-name {
  font-size: 26rpx;
  color: #4A4F48;
  font-weight: 500;
}

.pay-method-check {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #94A48C 0%, #7A8B72 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(0.5);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); /* 优雅的回弹动效 */
  box-shadow: 0 4rpx 10rpx rgba(148, 164, 140, 0.4);
}

.check-visible {
  opacity: 1;
  transform: scale(1);
}

/* ================= 底部操作按钮 ================= */
.action-footer {
  margin-top: auto;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 支付按钮：绸缎绿渐变 */
.pay-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #94A48C 0%, #7A8B72 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx; /* 增加呼吸感 */
  border-radius: 48rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(148, 164, 140, 0.3);
  transition: all 0.2s;
  border: none;
}

.pay-btn::after { display: none; }

.pay-btn:active { 
  transform: scale(0.97); 
  box-shadow: 0 4rpx 12rpx rgba(148, 164, 140, 0.15);
}

/* 取消按钮：轻盈线框 */
.cancel-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #94A48C;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  border-radius: 48rpx;
  border: 1px solid #94A48C;
  transition: all 0.2s;
}

.cancel-btn::after { display: none; }

.cancel-btn:active { 
  background: rgba(148, 164, 140, 0.05); 
}