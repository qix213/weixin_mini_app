/* ================= 全局与背景 ================= */
page {
  background: #f0f9ff;
  min-height: 100vh;
}

.pay-container {
  position: relative;
  padding: 40rpx 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.dynamic-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  background: linear-gradient(-45deg, #e0f2fe, #ffffff, #bae6fd, #f8fafc);
  background-size: 400% 400%;
  animation: gradientBG 15s ease infinite;
}

@keyframes gradientBG {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ================= 订单信息卡片 ================= */
.order-card {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 2rpx solid rgba(255, 255, 255, 1);
  border-radius: 30rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(14, 165, 233, 0.08);
  margin-bottom: 50rpx;
}

.order-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1e293b;
  text-align: center;
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx dashed rgba(14, 165, 233, 0.2);
}

.order-item {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.label {
  color: #64748b;
  width: 180rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.amount {
  color: #0ea5e9;
  font-size: 36rpx;
  font-weight: 800;
  font-family: 'DIN Alternate', 'PingFang SC', sans-serif;
}

.highlight-blue {
  color: #0ea5e9 !important;
  font-weight: bold;
}

.amount-item {
  justify-content: space-between;
  margin-top: 40rpx;
  margin-bottom: 0;
  padding: 30rpx;
  background: linear-gradient(135deg, rgba(224, 242, 254, 0.6), rgba(255, 255, 255, 0.6));
  border-radius: 20rpx;
  border: 1rpx solid rgba(56, 189, 248, 0.3);
}

.final-amount {
  font-size: 48rpx;
  color: #0284c7;
  text-shadow: 0 4rpx 10rpx rgba(2, 132, 199, 0.1);
}

/* ================= 优惠券下拉框 ================= */
.coupon-dropdown {
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx dashed rgba(14, 165, 233, 0.2);
}

.native-picker {
  flex: 1;
}

.picker-text {
  font-size: 28rpx;
  color: #0284c7;
  font-weight: 600;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-val { flex: 1; text-align: right; }
.picker-arrow { font-size: 20rpx; color: #94a3b8; margin-left: 10rpx; }

/* ================= 积分抵扣区域 ================= */
.point-operate-area {
  margin: 30rpx 0;
  padding: 30rpx 0;
  border-top: 2rpx dashed rgba(14, 165, 233, 0.2);
  border-bottom: 2rpx dashed rgba(14, 165, 233, 0.2);
}

.point-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.max-tip {
  margin-left: auto;
  font-size: 22rpx;
  color: #94a3b8;
  background: rgba(241, 245, 249, 0.8);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.point-deduct-op {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.stepper-glass {
  display: flex;
  align-items: center;
  background: rgba(241, 245, 249, 0.6);
  border: 2rpx solid rgba(226, 232, 240, 1);
  border-radius: 16rpx;
  overflow: hidden;
  height: 64rpx;
}

.btn-minus, .btn-plus {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #475569;
  background: rgba(255, 255, 255, 0.5);
}

.btn-minus:active, .btn-plus:active { background: rgba(226, 232, 240, 0.8); }

.point-input {
  width: 120rpx;
  height: 64rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  border-left: 2rpx solid rgba(226, 232, 240, 0.6);
  border-right: 2rpx solid rgba(226, 232, 240, 0.6);
}

.btn-all {
  height: 64rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #38bdf8, #0ea5e9);
  color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 10rpx rgba(14, 165, 233, 0.2);
}

.point-deduct-tip {
  font-size: 24rpx;
  color: #64748b;
  padding-left: 180rpx;
}

/* ================= 支付方式选择模块 ================= */
.pay-methods-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1e293b;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.pay-methods-container {
  display: flex;
  gap: 20rpx;
  margin-bottom: 60rpx;
}

.pay-method-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(10px);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 30rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.02);
}

.pay-method-selected {
  border-color: #0ea5e9 !important;
  background: rgba(224, 242, 254, 0.8) !important;
  box-shadow: 0 6rpx 20rpx rgba(14, 165, 233, 0.15) !important;
  transform: translateY(-4rpx);
}

.pay-method-icon {
  width: 56rpx;
  height: 56rpx;
}

.pay-method-name {
  font-size: 28rpx;
  color: #334155;
  font-weight: 600;
}

.pay-method-check {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #38bdf8, #0ea5e9);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(0.5);
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 10rpx rgba(14, 165, 233, 0.4);
}

.check-visible {
  opacity: 1;
  transform: scale(1);
}

/* ================= 底部操作按钮 ================= */
.action-footer {
  margin-top: auto;
  padding-bottom: 20rpx;
}

.pay-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
  border-radius: 48rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 25rpx rgba(14, 165, 233, 0.3);
  transition: transform 0.2s;
  border: none;
}

.pay-btn:active { transform: scale(0.98); }

.cancel-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(10px);
  color: #64748b;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: 2rpx solid rgba(255, 255, 255, 1);
}