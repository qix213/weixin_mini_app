/* 核心：金额字体+颜色统一调整（主题蓝色+高转化字体规范） */
/* 抵扣积分提示样式 */
.point-deduct-tip {
  margin-top: 15rpx;
  font-size: 24rpx;
  color: #999;
  padding-left: 180rpx;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif; /* 统一字体 */
}

/* 积分操作区域样式 */
.point-operate-area {
  margin: 20rpx 0;
  padding: 20rpx 0;
  border-top: 1rpx solid #eee;
  border-bottom: 1rpx solid #eee;
}
.point-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif; /* 统一字体 */
}
.point-info .label {
  color: #666;
  width: 180rpx;
}
.point-info .max-tip {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #999;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.point-deduct-op {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.point-deduct-op .label {
  color: #666;
  width: 180rpx;
}
.btn-minus, .btn-plus {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
  font-size: 32rpx;
  background-color: #f5f5f5;
  color: #333;
  border-radius: 8rpx;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.point-input {
  flex: 1;
  height: 60rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.btn-all {
  width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
  font-size: 24rpx;
  background-color: #ff9900;
  color: #fff;
  border-radius: 8rpx;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
/* 积分文字改为主题蓝色（替代原橙色） */
.point-text {
  color: #1677FF !important;
  font-weight: 600; /* 加粗增强视觉焦点 */
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* 支付容器基础样式 */
.pay-container {
  padding: 40rpx 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif; /* 全局统一字体 */
}
.order-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.08);
  margin-bottom: 40rpx;
}
.order-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.order-item {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  font-size: 32rpx;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.label {
  color: #666;
  width: 180rpx;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.amount-item {
  justify-content: center;
  margin-top: 20rpx;
  margin-bottom: 0;
  padding-top: 20rpx;
  border-top: 1rpx dashed #eee;
}
/* 核心修改：金额改为主题蓝色+高转化字体规范 */
.amount {
  color: #1677FF; /* 主题蓝色（替代原红色） */
  font-size: 40rpx; /* 最优售价字号 */
  font-weight: 600; /* bold加粗，增强视觉焦点 */
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif; /* 无衬线高转化字体 */
}
.pay-methods-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.pay-methods-container {
  display: flex;
  gap: 20rpx;
  margin-bottom: 60rpx;
}
.pay-method-item {
  flex: 1;
  background-color: #fff;
  border: 2rpx solid #eee;
  border-radius: 15rpx;
  padding: 25rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
  position: relative;
  transition: all 0.3s ease;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.pay-method-selected {
  border-color: #1677ff !important;
  background-color: #f0f7ff !important;
}
.pay-method-icon {
  width: 60rpx;
  height: 60rpx;
  object-fit: contain;
}
.pay-method-name {
  font-size: 28rpx;
  color: #333;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.pay-method-check {
  position: absolute;
  top: 15rpx;right: 15rpx;
  width: 30rpx;height: 30rpx;
  border-radius: 50%;
  background-color: #1677ff;
  color: #fff;font-size: 20rpx;
  display: flex;align-items: center;justify-content: center;
  opacity: 0;transition: opacity 0.3s ease;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.check-visible {opacity: 1;}
.pay-btn {
  width: 100%;height: 88rpx;line-height: 88rpx;
  background-color: #1677ff;color: #fff;
  font-size: 34rpx;border-radius: 10rpx;
  margin-bottom: 30rpx;
  font-weight: 600; /* 按钮文字加粗 */
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.cancel-btn {
  width: 100%;height: 88rpx;line-height: 88rpx;
  background-color: #fff;color: #666;
  font-size: 34rpx;border-radius: 10rpx;
  border: 1rpx solid #eee;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* 优惠券选择器样式补充（统一字体） */
.coupon-dropdown {
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.native-picker {
  flex: 1;
}
.picker-text {
  font-size: 28rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.picker-arrow {
  font-size: 24rpx;
  color: #999;
}