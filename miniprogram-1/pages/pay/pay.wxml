<view class="pay-container">
  <view class="dynamic-bg"></view>

  <view class="content-wrapper">
    <view class="glass-panel order-card">
      <view class="order-title">{{typeName}}</view>
      
      <view class="order-item">
        <label class="label">订单金额：</label>
        <text class="amount {{isPointGoods ? 'point-text' : ''}}">
          {{isPointGoods ? exchangePoints + ' 积分（¥' + exchangePointsRmb + '）' : '¥' + (originalAmount || '0.00')}}
        </text>
      </view>

      <view class="order-item coupon-dropdown" wx:if="{{!isPointGoods}}">
        <label class="label">使用优惠券：</label>
        <picker 
          mode="selector" 
          range="{{couponDropdownOptions}}" 
          range-key="label"
          value="{{couponIndex}}"
          bindchange="onCouponChangeNative"
          class="native-picker"
        >
          <view class="picker-text">
            <text class="picker-val {{selectedCoupon ? 'val-active' : ''}}">{{selectedCoupon ? selectedCoupon.label : '请选择可用优惠券'}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <view class="point-operate-area" wx:if="{{isPointGoods}}">
        <view class="point-info">
          <label class="label">可用积分：</label>
          <text class="point-text highlight-theme">{{userPoints}} 积分</text>
          <text class="max-tip">最大抵扣：{{maxDeductPoint}}积分(¥{{maxDeductPointRmb}})</text>
        </view>
        
        <view class="point-deduct-op">
          <label class="label">本次抵扣：</label>
          <view class="stepper-glass">
            <view class="btn-minus" bindtap="minusPoint">-</view>
            <input 
              type="number" 
              value="{{pointDeductPoints}}" 
              bindinput="inputPoint"
              placeholder="0"
              class="point-input"
            />
            <view class="btn-plus" bindtap="plusPoint">+</view>
          </view>
          <view class="btn-all" bindtap="useAllPoints">全选</view>
        </view>
        
        <view class="point-deduct-tip">
          <text>本次抵扣金额：<text class="highlight-theme">¥{{pointDeductRmb}}</text></text>
        </view>
      </view>

      <view class="order-item" wx:if="{{!isPointGoods && pointDeductPoints > 0}}">
        <label class="label">积分抵扣：</label>
        <text class="amount">- ¥{{pointDeductRmb || '0.00'}}_{{pointDeductPoints}}积分</text>
      </view>

      <view class="divider"></view>

      <view class="order-item amount-item">
        <label class="label">实付金额</label>
        <text class="amount final-amount">¥{{actualAmount || '0.00'}}</text>
      </view>
    </view>

    <view class="glass-panel pay-method-card">
      <view class="section-title">选择支付方式</view>
      <radio-group bindchange="onPayMethodChange">
        
        <label class="method-item {{payMethod === 'wechat' ? 'item-active' : ''}}">
          <view class="item-left">
            <view class="icon-box wx-color">￥</view>
            <text class="name">微信支付</text>
          </view>
          <radio value="wechat" checked="{{payMethod === 'wechat'}}" color="#94A48C"/>
        </label>

        <label class="radio" wx:if="{{scene !== 'upgrade'}}">
        <label class="method-item {{payMethod === 'wallet' ? 'item-active' : ''}}">
          <view class="item-left">
            <view class="icon-box wallet-color">￥</view>
            <text class="name">电子账户支付</text>
            <text class="balance-tag">(余额: ¥{{walletBalance || '0.00'}})</text>
          </view>
          <radio value="wallet" checked="{{payMethod === 'wallet'}}" color="#94A48C"/>
        </label>
      </label>
      </radio-group>
    </view>
  </view>

  <view class="action-footer">
    <button class="pay-btn {{payMethod === 'wallet' ? 'btn-wallet' : 'btn-wechat'}}" bindtap="handlePay" loading="{{payLoading}}" disabled="{{payLoading}}">
      {{payLoading ? '处理中...' : payButtonText}}
    </button>
    <button class="cancel-btn" bindtap="handleCancel" disabled="{{payLoading}}">
      取消并返回
    </button>
  </view>
</view>