<view class="pay-container">
  <view class="order-card">
    <view class="order-title">{{typeName}}</view>
    
    <view class="order-item">
      <label class="label">订单金额：</label>
      <text class="amount">¥{{originalAmount}}</text>
    </view>

    <view class="order-item coupon-dropdown">
      <label class="label">使用优惠券：</label>
      <picker 
        mode="selector" 
        range="{{couponDropdownOptions}}" 
        range-key="label"
        value="{{couponIndex}}"
        bindchange="onCouponChangeNative"
        class="native-picker"
      >
        <view class="picker-text">
          {{selectedCoupon ? selectedCoupon.title + '（' + selectedCoupon.discountDesc + '）' : '请选择优惠券'}}
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 积分抵扣（只显示积分数量） -->
    <view class="order-item">
      <label class="label">积分抵扣：</label>
      <text class="amount">{{pointDeductPoints}} 积分</text>
    </view>

    <view class="order-item amount-item">
      <label class="label">实付金额：</label>
      <text class="amount">¥{{actualAmount}}</text>
    </view>
  </view>

  <view class="pay-methods-title">选择支付方式</view>
  <view class="pay-methods-container">
    <block wx:for="{{payMethods}}" wx:key="id">
      <view 
        class="pay-method-item {{item.selected ? 'pay-method-selected' : ''}}"
        data-methodid="{{item.id}}"
        bindtap="switchPayMethod"
      >
        <image class="pay-method-icon" src="{{item.icon}}" mode="widthFix"></image>
        <text class="pay-method-name">{{item.name}}</text>
        <view class="pay-method-check {{item.selected ? 'check-visible' : ''}}">✓</view>
      </view>
    </block>
  </view>

  <button 
    class="pay-btn" 
    bindtap="handlePay"
    loading="{{payLoading}}"
    disabled="{{payLoading}}" 
  >
    {{payLoading ? '支付中...' : '确认支付 ¥' + actualAmount}}
  </button>

  <button 
    class="cancel-btn" 
    bindtap="handleCancel"
    disabled="{{payLoading}}"
  >
    取消支付
  </button>
</view>