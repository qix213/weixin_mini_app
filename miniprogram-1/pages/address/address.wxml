<form bindsubmit="saveAddress">
  <view class="form-box">
    <view class="row">
      <text>收货人</text>
      <input name="name" placeholder="请填写收货人姓名" placeholder-style="color:#ccc;" />
    </view>
    
    <view class="row">
      <text>手机号码</text>
      <input name="phone" type="number" maxlength="11" placeholder="请填写手机号码" placeholder-style="color:#ccc;" />
    </view>
    
    <view class="row">
      <text>所在地区</text>
      <picker mode="region" bindchange="bindRegionChange" value="{{region}}">
        <view class="picker-text">
          {{region[0]}} {{region[1]}} {{region[2]}}
        </view>
      </picker>
    </view>
    
    <view class="row" style="align-items: flex-start;">
      <text style="margin-top:10rpx;">详细地址</text>
      <textarea name="detail" placeholder="街道、楼牌号等" placeholder-style="color:#ccc;"></textarea>
    </view>
  </view>

  <view class="save-btn-wrap">
    <button form-type="submit" class="save-btn">保存并使用</button>
  </view>
</form>