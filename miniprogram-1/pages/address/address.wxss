/* 背景颜色设为浅灰，突出白色表单卡片 */
page {
  background-color: #f8f8f8;
  padding-bottom: 60rpx;
}

.form-box {
  background-color: #ffffff;
  margin-top: 20rpx;
  padding: 0 30rpx;
}

/* 每一行的布局 */
.row {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eeeeee;
  font-size: 28rpx;
}

.row:last-child {
  border-bottom: none;
}

/* 左侧标签宽度固定 */
.row text {
  width: 160rpx;
  color: #333;
  font-weight: 500;
}

/* 输入框样式 */
.row input, .row picker {
  flex: 1;
  color: #333;
}

/* 针对多行文本框的特殊处理 */
.row textarea {
  flex: 1;
  height: 120rpx;
  padding: 10rpx 0;
  line-height: 1.5;
}

/* 地区选择器文字颜色 */
.picker-text {
  color: #666;
}

/* 保存按钮容器 */
.save-btn-wrap {
  margin: 60rpx 30rpx;
}

/* 渐变色按钮，更具有电商质感 */
.save-btn {
  width: 100% !important;
  background: linear-gradient(to right, #ff6034, #ee0a24);
  color: #fff;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 45rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(238, 10, 36, 0.3);
}

.save-btn:active {
  opacity: 0.8;
}