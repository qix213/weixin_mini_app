/* 地址容器 */
.address-container {
  padding: 20rpx;
  background-color: #f9f9f9;
  min-height: 100vh;
}

/* 新增按钮 */
.add-btn {
  border: 2rpx dashed #1E88E5;
  border-radius: 8rpx;
  padding: 30rpx;
  text-align: center;
  margin-bottom: 30rpx;
  background-color: #fff;
}

.add-btn text {
  color: #1E88E5;
  font-size: 28rpx;
}

/* 地址列表 */
.address-list {
  margin-bottom: 20rpx;
}

/* 地址项 */
.address-item {
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
  background-color: #fff;
}

/* 默认标签 */
.address-item .default-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: #1E88E5;
  color: #fff;
  font-size: 24rpx;
  padding: 5rpx 15rpx;
  border-bottom-left-radius: 8rpx;
}

/* 地址信息 */
.address-item .info-row {
  margin-bottom: 10rpx;
}

.address-item .info-row text {
  font-size: 28rpx;
  font-weight: bold;
}

.address-item .info-row text.phone {
  font-size: 26rpx;
  margin-left: 20rpx;
  font-weight: normal;
}

.address-item .address-row {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

/* 操作按钮组 */
.address-item .btn-group {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.address-item .btn-group button {
  font-size: 24rpx;
  padding: 0 15rpx;
}

/* 选择地址按钮 */
.address-item .select-btn {
  width: 100%;
  background: #f5f5f5;
  color: #333;
  border-radius: 8rpx;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 28rpx;
}

/* 空地址提示 */
.empty-tip {
  text-align: center;
  padding: 100rpx 0;
}

.empty-tip text {
  font-size: 28rpx;
  color: #999;
}