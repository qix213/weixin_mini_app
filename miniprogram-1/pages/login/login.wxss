/* ================= 全局与背景 ================= */
page {
  background: #f0f9ff;
  min-height: 100vh;
}

.login-container {
  position: relative;
  min-height: 100vh;
  padding: 80rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

/* 动态流光背景 */
.dynamic-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  background: linear-gradient(-45deg, #e0f2fe, #ffffff, #bae6fd, #f8fafc);
  background-size: 400% 400%;
  animation: gradientBG 15s ease infinite;
}

@keyframes gradientBG {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ================= 头部欢迎语 ================= */
.login-header {
  margin-top: 120rpx; /* 因为去掉了长表单，所以稍微往下压一点，视觉更平衡 */
  margin-bottom: 100rpx;
  padding-left: 20rpx;
}

.login-title {
  font-size: 64rpx; /* 字体稍微放大，增强视觉冲击力 */
  font-weight: 900;
  color: #1e293b;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 10rpx rgba(14, 165, 233, 0.1);
}

.login-subtitle {
  font-size: 32rpx;
  color: #0ea5e9;
  font-weight: 600;
  letter-spacing: 2rpx;
  font-family: 'DIN Alternate', sans-serif;
}

/* ================= 毛玻璃操作卡片 ================= */
.glass-card {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 2rpx solid rgba(255, 255, 255, 1);
  border-radius: 40rpx;
  padding: 80rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(14, 165, 233, 0.08);
  margin-bottom: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center; /* 让内部的按钮和文字居中对齐 */
}

/* ================= 底部操作区 ================= */
.login-btn {
  width: 100% !important;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 🌟 核心变化：换成微信专属的绿色渐变，符合快捷登录直觉 */
  background: linear-gradient(135deg, #07c160, #10ad5a);
  color: #fff;
  font-size: 34rpx;
  font-weight: 800;
  border-radius: 50rpx;
  margin-bottom: 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(7, 193, 96, 0.3);
  transition: transform 0.2s;
}

.login-btn::after { border: none; }

.login-btn:active {
  transform: scale(0.98);
}

.to-register-wrap {
  text-align: center;
  font-size: 28rpx;
}

.normal-text {
  color: #64748b;
}

.register-btn {
  color: #0ea5e9;
  font-weight: 800;
  margin-left: 10rpx;
  position: relative;
  padding: 10rpx 0; /* 增加点击热区 */
}

/* 注册按钮底部的科技感小蓝线 */
.register-btn::after {
  content: '';
  position: absolute;
  bottom: 2rpx;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: rgba(14, 165, 233, 0.4);
  border-radius: 2rpx;
}