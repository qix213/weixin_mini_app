/* ================= 全局与背景 ================= */
page {
  background: #FAF8F5; /* 奶油可可白 */
  min-height: 100vh;
}

.login-container {
  position: relative;
  min-height: 100vh;
  padding: 80rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

/* 科技感极简环境光晕 (替换原有的蓝色动画，更显高级静谧) */
.dynamic-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 600rpx;
  z-index: -1;
  background: linear-gradient(180deg, rgba(148, 164, 140, 0.15) 0%, rgba(250, 248, 245, 0) 100%);
  pointer-events: none;
}

/* ================= 头部欢迎语 ================= */
.login-header {
  margin-top: 120rpx; 
  margin-bottom: 100rpx;
  padding-left: 20rpx;
}

.login-title {
  font-size: 60rpx; 
  font-weight: bold;
  color: #222222; /* 深沉的高级黑 */
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: #94A48C; /* 品牌主色调 莫兰迪绿 */
  font-weight: 600;
  letter-spacing: 4rpx;
  font-family: 'DIN Alternate', sans-serif;
  text-transform: uppercase;
}

/* ================= 毛玻璃操作卡片 ================= */
.glass-card {
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 40rpx;
  padding: 80rpx 40rpx;
  box-shadow: 0 12rpx 36rpx rgba(148, 164, 140, 0.08); /* 主调极淡光晕 */
  margin-bottom: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch; 
}

/* ================= 底部操作区 ================= */
.login-btn {
  width: 100% !important;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 保留微信绿，但调成更具质感的高级渐变 */
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  border-radius: 45rpx; /* 高度的一半，完美胶囊 */
  margin-bottom: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25); /* 柔和的微信绿阴影 */
  transition: all 0.2s ease;
}

.login-btn::after { border: none; }

.login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.15);
}

.to-register-wrap {
  text-align: center;
  font-size: 26rpx;
}

.normal-text {
  color: #94a3b8; /* 柔和的浅灰 */
}

.register-btn {
  color: #94A48C; /* 品牌主色调 */
  font-weight: bold;
  margin-left: 10rpx;
  position: relative;
  padding: 10rpx 0; 
  letter-spacing: 1rpx;
}

/* 注册按钮底部的优雅指示线 */
.register-btn::after {
  content: '';
  position: absolute;
  bottom: 2rpx;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: rgba(148, 164, 140, 0.3); /* 半透明的主色调 */
  border-radius: 2rpx;
  transition: background 0.3s;
}

.register-btn:active::after {
  background: rgba(148, 164, 140, 0.8);
}

/* ================= 登录方式切换 ================= */

.login-tabs {
  display: flex;
  width: 100%;
  margin-bottom: 50rpx;
  border-bottom: 1rpx solid rgba(148, 164, 140, 0.15);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #94a3b8;
  position: relative;
  transition: all .25s ease;
}

.tab.active {
  color: #07c160;
  font-weight: bold;
}

.tab.active::after {
  content: "";
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg,#07c160,#06ad56);
}

/* ================= 输入框 ================= */

.login-input {
  width: 100%;
  height: 90rpx;
  margin-bottom: 30rpx;
  padding: 0 30rpx;
  box-sizing: border-box;

  background: rgba(255,255,255,.9);
  border: 2rpx solid rgba(148,164,140,.15);
  border-radius: 45rpx;

  font-size: 30rpx;
  color: #333;

  transition: all .25s ease;
}

/* placeholder颜色 */
.login-input::placeholder {
  color: #b0b8c2;
}

/* 微信小程序 input 获取焦点 */
.login-input:focus {
  border-color: #07c160;
  box-shadow: 0 0 0 6rpx rgba(7,193,96,.08);
}

/* 暂不登录外层容器，增加间距 */
.cancel-login-wrap {
  margin-top: 40rpx;
  width: 100%;
}

/* 暂不登录 按钮样式 (次级按钮设计：幽灵/线框按钮) */
.cancel-btn {
  width: 100% !important; /* 覆盖小程序默认的按钮宽度限制 */
  background-color: transparent !important; /* 透明背景 */
  color: #888888; /* 灰色字体，弱化视觉比重 */
  font-size: 28rpx;
  font-weight: 400;
  border-radius: 50rpx; /* 圆角，可与你的主按钮保持一致 */
  border: 1px solid #cccccc; /* 浅灰色边框 */
  padding: 16rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 去除微信小程序默认的 button 边框（::after 伪元素） */
.cancel-btn::after {
  border: none;
}

/* 按钮点击时的点击态（按下去稍微变暗） */
.cancel-btn:active {
  background-color: rgba(0, 0, 0, 0.05) !important;
  opacity: 0.8;
}

