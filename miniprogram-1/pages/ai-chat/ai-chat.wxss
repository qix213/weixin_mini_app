page {
  background-color: #f8fafc;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.nav-header {
  padding: 100rpx 30rpx 30rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #1e293b;
  background: rgba(248, 250, 252, 0.9);
  backdrop-filter: blur(10px);
  z-index: 10;
  letter-spacing: 2rpx;
}

.chat-scroll {
  flex: 1;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 40rpx;
  width: 100%;
}

.ai-row { justify-content: flex-start; }
.user-row { justify-content: flex-end; }

.avatar-box { margin-right: 20rpx; }
.ai-avatar {
  width: 70rpx; height: 70rpx;
  background: linear-gradient(135deg, rgba(148, 164, 140, 0.2), rgba(148, 164, 140, 0.4));
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
}

.bubble {
  max-width: 75%;
  padding: 24rpx 32rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-wrap: break-word;
}

/* AI 气泡：纯白 + 极弱深海灰绿阴影 */
.ai-bubble {
  background: #ffffff;
  color: #334155;
  border-top-left-radius: 4rpx;
  box-shadow: 0 8rpx 30rpx rgba(148, 164, 140, 0.08);
  border: 1rpx solid rgba(148, 164, 140, 0.1);
}

/* 用户气泡：主色调 */
.user-bubble {
  background: rgb(148, 164, 140);
  color: #ffffff;
  border-top-right-radius: 4rpx;
  box-shadow: 0 8rpx 20rpx rgba(148, 164, 140, 0.3);
}

.preview-img { width: 300rpx; border-radius: 16rpx; margin-bottom: 16rpx; display: block; }

/* ======== 底部操作台 ======== */
.action-panel {
  padding: 30rpx 40rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -10rpx 40rpx rgba(0,0,0,0.03);
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
}

.btn-group { display: flex; flex-direction: column; gap: 20rpx; }

.action-btn {
  width: 100%; height: 88rpx; line-height: 88rpx;
  border-radius: 44rpx; font-size: 30rpx; font-weight: bold; letter-spacing: 2rpx;
}
.action-btn::after { display: none; }

.action-btn.primary {
  background: linear-gradient(135deg, rgb(148, 164, 140), rgb(125, 140, 115));
  color: #fff; box-shadow: 0 10rpx 20rpx rgba(148, 164, 140, 0.3);
}
.action-btn.ghost {
  background: rgba(148, 164, 140, 0.05); color: rgb(148, 164, 140);
  border: 2rpx solid rgb(148, 164, 140);
}

/* ======== 问卷弹窗 (毛玻璃) ======== */
.q-modal { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 100; display: flex; align-items: center; justify-content: center; }
.q-mask { position: absolute; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(8px); }
.q-content {
  position: relative; width: 85%; max-height: 80vh; background: #ffffff;
  border-radius: 40rpx; padding: 50rpx 40rpx; box-sizing: border-box;
  display: flex; flex-direction: column; box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.1);
}

.q-progress { font-size: 24rpx; color: rgb(148, 164, 140); font-weight: bold; margin-bottom: 20rpx; letter-spacing: 2rpx; }
.q-title { font-size: 32rpx; color: #1e293b; font-weight: bold; line-height: 1.5; margin-bottom: 40rpx; }
.q-options { max-height: 50vh; }

.q-option {
  padding: 30rpx; background: #f8fafc; border: 2rpx solid #e2e8f0;
  border-radius: 20rpx; margin-bottom: 24rpx; font-size: 28rpx; color: #475569; transition: all 0.2s;
}
.q-option.selected {
  background: rgba(148, 164, 140, 0.1); border-color: rgb(148, 164, 140);
  color: rgb(148, 164, 140); font-weight: bold;
}
.opt-key { font-weight: bold; margin-right: 10rpx; }

.q-footer { display: flex; justify-content: space-between; margin-top: 40rpx; gap: 20rpx; }
.q-btn { flex: 1; height: 80rpx; line-height: 80rpx; border-radius: 40rpx; font-size: 28rpx; }
.q-btn.primary { background: rgb(148, 164, 140); color: #fff; }
.q-btn.ghost { background: #f1f5f9; color: #64748b; }
.q-btn::after { display: none; }

/* 打字机动画 */
.typing-indicator { display: flex; gap: 6rpx; padding: 10rpx; }
.dot { width: 10rpx; height: 10rpx; background: rgb(148, 164, 140); border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both; }
.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
@keyframes bounce { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }

/* 新增的第1步控件样式 */
.step-0-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
}

.name-input {
  width: 100%;
  height: 88rpx; /* 🌟 给定明确的高度 */
  line-height: 88rpx; /* 🌟 让行高等于高度，确保文字绝对垂直居中 */
  background-color: #F8F9FA;
  padding: 0 40rpx; /* 🌟 去掉上下边距，只保留左右边距 */
  border-radius: 44rpx; /* 高度的一半，呈现完美的胶囊圆角 */
  font-size: 28rpx;
  color: #333333;
  text-align: center;
  border: 1px solid rgba(0, 0, 0, 0.05);
  box-sizing: border-box; /* 防止边距撑破容器宽度 */
}
.action-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.action-row .action-btn {
  flex: 1;
  margin: 0;
  font-size: 26rpx; /* 双按钮时字体稍微调小防拥挤 */
}

.svg-icon {
  width: 66rpx;
  height: 66rpx;
  display: block;
  border-radius: 50%; /* 🌟 加上这行，直接变圆 */
  overflow: hidden;   /* 配合使用，防止边缘溢出 */
}