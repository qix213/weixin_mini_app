page {
  background-color: #0f172a; /* 深邃科技暗黑底色 */
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.chat-container {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

/* --- 动态背景光晕 --- */
.dynamic-bg {
  position: absolute;
  top: -20%;
  left: -20%;
  width: 140%;
  height: 140%;
  z-index: 0;
  transition: all 0.8s ease-in-out;
  opacity: 0.5;
  filter: blur(80px);
}
.bg-lite {
  background: radial-gradient(circle at 50% 30%, rgba(56, 189, 248, 0.2), transparent 60%);
}
.bg-pro {
  background: radial-gradient(circle at 50% 30%, rgba(217, 119, 6, 0.25), rgba(147, 51, 234, 0.1), transparent 60%);
}

/* --- 滚动区与气泡 --- */
.msg-scroll {
  flex: 1;
  height: calc(100vh - 140px); /* 留出底部控制台空间 */
  padding: 20rpx;
  box-sizing: border-box;
  z-index: 1;
  position: relative;
}

.msg-row {
  display: flex;
  margin-bottom: 40rpx;
  align-items: flex-start;
}
.ai-row { justify-content: flex-start; }
.user-row { justify-content: flex-end; }

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  position: relative;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.05);
}

/* Lite 与 Pro 头像特效区分 */
.ai-avatar { transition: all 0.5s ease; }
.pro-avatar {
  box-shadow: 0 0 20rpx rgba(217, 119, 6, 0.4);
  border-color: rgba(245, 158, 11, 0.5);
}

.msg-content {
  max-width: 65%;
  padding: 24rpx 32rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-wrap: break-word;
  position: relative;
}

.user-content {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  border-bottom-right-radius: 8rpx;
  margin-right: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.3);
}

.ai-content {
  background: rgba(30, 41, 59, 0.7);
  backdrop-filter: blur(10px);
  color: #e2e8f0;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-bottom-left-radius: 8rpx;
  margin-left: 20rpx;
  transition: all 0.5s ease;
}

/* Pro专属气泡样式：微透的暗金边框与流光感 */
.pro-content {
  background: linear-gradient(145deg, rgba(30, 41, 59, 0.8), rgba(67, 30, 16, 0.6));
  border: 1px solid rgba(245, 158, 11, 0.3);
  box-shadow: 0 4rpx 24rpx rgba(217, 119, 6, 0.15);
  color: #fef3c7;
}

/* --- 底部控制台：模型胶囊 + 输入框 --- */
.bottom-console {
  position: absolute;
  bottom: 0;
  width: 100%;
  padding-bottom: env(safe-area-inset-bottom);
  background: linear-gradient(to top, rgba(15, 23, 42, 1) 40%, rgba(15, 23, 42, 0));
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 悬浮切换胶囊 */
.model-switch-wrapper {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.model-switch-capsule {
  width: 460rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px);
  border-radius: 40rpx;
  display: flex;
  position: relative;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

/* 胶囊内的滑动块 */
.switch-slider {
  position: absolute;
  top: 6rpx;
  width: 220rpx;
  height: 60rpx;
  border-radius: 30rpx;
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.4s;
  z-index: 1;
}
.slider-left {
  transform: translateX(6rpx);
  background: rgba(56, 189, 248, 0.2);
  border: 1px solid rgba(56, 189, 248, 0.3);
}
.slider-right {
  transform: translateX(230rpx);
  background: linear-gradient(90deg, rgba(217, 119, 6, 0.3), rgba(245, 158, 11, 0.3));
  border: 1px solid rgba(245, 158, 11, 0.4);
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #94a3b8;
  z-index: 2;
  transition: color 0.3s;
}
.active-lite { color: #38bdf8; font-weight: bold; }
.active-pro { color: #fcd34d; font-weight: bold; }

/* 输入框区域 */
.input-bar {
  width: 90%;
  height: 96rpx;
  background: rgba(30, 41, 59, 0.6);
  backdrop-filter: blur(15px);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx 0 32rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
  margin-bottom: 20rpx;
}

.input {
  flex: 1;
  height: 100%;
  color: #fff;
  font-size: 28rpx;
}

.placeholder-style { color: #64748b; }

.send-btn {
  width: 120rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  font-size: 26rpx;
  font-weight: bold;
  background: rgba(255, 255, 255, 0.05);
  transition: all 0.3s ease;
  overflow: hidden;
  position: relative;
}

.send-btn.active {
  background: #3b82f6;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.4);
}