<view class="chat-container">
  <view class="dynamic-bg"></view>

  <scroll-view class="msg-scroll" scroll-y="true" scroll-into-view="last-msg" enhanced="true" show-scrollbar="false">
    <view class="msg-box" wx:for="{{messageList}}" wx:key="index">
      
      <view wx:if="{{item.role === 'assistant'}}" class="msg-row ai-row">
        <view class="avatar ai-avatar">
          <view class="avatar-glow"></view> 🤖
        </view>
        <view class="msg-content ai-content">{{item.content}}</view>
      </view>

      <view wx:else class="msg-row user-row">
        <view class="msg-content user-content">{{item.content}}</view>
        <view class="avatar user-avatar">👤</view>
      </view>

    </view>
    <view id="last-msg" class="scroll-anchor"></view>
  </scroll-view>

  <view class="input-bar-wrapper">
    <view class="input-bar">
      <input class="input" placeholder="输入指令或提问..." placeholder-class="placeholder-style" value="{{inputText}}" bindinput="onInput" confirm-type="send" bindconfirm="sendMessage"/>
      <view class="send-btn {{inputText.length > 0 ? 'active' : ''}}" bindtap="sendMessage">
        <text>发送</text>
      </view>
    </view>
  </view>
</view>