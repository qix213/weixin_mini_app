.cart-container {
  padding-top: 46px;
  background-color: #f7f8fa;
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.cart-list {
  padding: 20rpx;
}

.cart-item {
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.num-control {
  display: flex;
  align-items: center;
}

.num-input {
  width: 70rpx;
  height: 44rpx;
  text-align: center;
  border: 1rpx solid #ebedf0;
  margin: 0 12rpx;
  border-radius: 4rpx;
  font-size: 26rpx;
  background: #f2f3f5;
  color: #323233;
}

.checkout-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx env(safe-area-inset-bottom);
  height: 110rpx;
  background: #ffffff;
  border-top: 1rpx solid #f2f3f5;
  z-index: 99;
}

.total-info {
  font-size: 28rpx;
  color: #323233;
}

.total-price {
  font-weight: bold;
  color: #1989fa; /* 修改为蓝色 */
  font-size: 34rpx;
  margin-left: 8rpx;
}

.pay-btn {
  width: 220rpx !important;
  font-weight: bold !important;
}

.empty-wrap {
  padding-top: 200rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.2;
}

.empty-text {
  font-size: 28rpx;
  color: #969799;
  margin-bottom: 50rpx;
}

.skeleton-wrap {
  padding: 30rpx;
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
}