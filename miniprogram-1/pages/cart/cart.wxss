/* ================= 全局与背景 ================= */
page {
  background: #f0f9ff;
  min-height: 100vh;
}

.cart-container {
  position: relative;
  padding-top: 46px; 
  min-height: 100vh;
  box-sizing: border-box;
  /* ⚡️ 修改这里：从 140rpx 提高到 180rpx，防止最后一件商品被增高的底栏挡住 */
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

/* 覆盖 Vant NavBar 背景使其透明 */
.nav-glass {
  background-color: transparent !important;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}
.nav-glass .van-nav-bar__title { color: #1e293b !important; font-weight: 800 !important; }

.dynamic-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  background: linear-gradient(-45deg, #e0f2fe, #ffffff, #bae6fd, #f8fafc);
  background-size: 400% 400%;
  animation: gradientBG 15s ease infinite;
}

@keyframes gradientBG {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ================= 通用毛玻璃卡片 ================= */
.glass-card {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 2rpx solid rgba(255, 255, 255, 1);
  border-radius: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(14, 165, 233, 0.08);
}

.skeleton-wrap { padding: 40rpx 30rpx; margin: 30rpx 24rpx; }
.skel-item { margin-bottom: 40rpx; }

/* ================= 购物车列表 ================= */
.cart-list {
  padding: 24rpx;
}

.cart-item {
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease;
}

.cart-item:active { transform: scale(0.98); }

/* --- 上半部分：图片与信息 --- */
.item-main {
  display: flex;
  margin-bottom: 30rpx;
  border-bottom: 2rpx dashed rgba(14, 165, 233, 0.15);
  padding-bottom: 30rpx;
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  margin-right: 24rpx;
  background: rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #1e293b;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tags-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: auto;
}

.point-tag {
  background: rgba(224, 242, 254, 0.8);
  color: #0284c7;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  border: 1rpx solid rgba(56, 189, 248, 0.3);
}

.goods-stock {
  font-size: 24rpx;
  color: #94a3b8;
}

.goods-price {
  margin-top: 10rpx;
}

.goods-price .unit { font-size: 24rpx; color: #1e293b; font-weight: bold; }
.goods-price .val { font-size: 36rpx; color: #1e293b; font-weight: 900; font-family: 'DIN Alternate', sans-serif;}

/* --- 下半部分：操作与小计 --- */
.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.sub-total {
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
}

.sub-total .highlight {
  color: #0ea5e9;
  font-size: 32rpx;
  font-weight: 900;
  font-family: 'DIN Alternate', sans-serif;
}

.action-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 玻璃胶囊步进器 (完美复刻商城风格) */
.stepper-glass {
  display: flex;
  align-items: center;
  background: rgba(241, 245, 249, 0.6);
  border: 2rpx solid rgba(226, 232, 240, 1);
  border-radius: 16rpx;
  overflow: hidden;
  height: 60rpx;
}

.btn-minus, .btn-plus {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #475569;
  background: rgba(255, 255, 255, 0.5);
  transition: all 0.2s;
}

.btn-minus:active, .btn-plus:active { background: rgba(226, 232, 240, 0.8); }
.btn-minus.disabled, .btn-plus.disabled { color: #cbd5e1; background: transparent; }

.num-input {
  width: 70rpx;
  height: 60rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
  border-left: 2rpx solid rgba(226, 232, 240, 0.6);
  border-right: 2rpx solid rgba(226, 232, 240, 0.6);
}

/* 柔和的科技感删除按钮 */
.delete-btn {
  height: 60rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(244, 63, 94, 0.08); /* 极淡的粉红色背景 */
  color: #f43f5e;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 16rpx;
  border: 1rpx solid rgba(244, 63, 94, 0.2);
  transition: all 0.2s;
}

.delete-btn:active { background: rgba(244, 63, 94, 0.15); transform: scale(0.95); }
.delete-btn .icon { font-size: 24rpx; margin-right: 6rpx; }

/* ================= 底部结算悬浮栏 ================= */
.bottom-submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  /* ⚡️ 修改这里：从 120rpx 拔高到 150rpx (你可以根据喜好在 140-160 之间微调) */
  height: 150rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(255, 255, 255, 1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
  /* env(safe-area-inset-bottom) 会自动适配 iPhone 底部的那条黑线 */
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.total-info { display: flex; align-items: baseline; }
.total-info .label { font-size: 28rpx; color: #64748b; font-weight: 500;}

.pay-amount .unit { color: #0ea5e9; font-size: 28rpx; margin-left: 8rpx; font-weight: bold; }
.pay-amount .val { color: #0ea5e9; font-size: 46rpx; font-weight: 900; font-family: 'DIN Alternate', sans-serif;}

.submit-btn {
  width: 280rpx !important;
  height: 84rpx;
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  color: #fff;
  border-radius: 42rpx;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(14, 165, 233, 0.4);
  margin: 0;
  transition: transform 0.2s;
}

.submit-btn:active { transform: scale(0.96); }

/* ================= 空状态页 (悬浮感) ================= */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 25vh;
}

.empty-icon-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-icon { font-size: 100rpx; z-index: 2; opacity: 0.8; }

/* 底部呼吸发光环 */
.glow-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(14, 165, 233, 0.1);
  box-shadow: 0 0 40rpx rgba(14, 165, 233, 0.2);
  animation: pulse 3s infinite alternate;
}

@keyframes pulse {
  0% { transform: scale(0.8); opacity: 0.5; }
  100% { transform: scale(1.2); opacity: 1; }
}

.empty-text {
  font-size: 28rpx;
  color: #64748b;
  margin-bottom: 50rpx;
  font-weight: 500;
}

.empty-btn {
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(10px);
  color: #0ea5e9;
  border: 2rpx solid #0ea5e9;
  border-radius: 40rpx;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(14, 165, 233, 0.15);
}