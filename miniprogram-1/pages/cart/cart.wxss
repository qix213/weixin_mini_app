/* ================= 全局与背景 ================= */
page {
  background: #FAF8F5; /* 奶油可可白 */
  min-height: 100vh;
}

.cart-container {
  position: relative;
  padding-top: 46px; 
  min-height: 100vh;
  box-sizing: border-box;
  /* ⚡️ 完美防遮挡底部留白 */
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  font-family: 'DIN Alternate', -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

/* 覆盖 Vant NavBar 背景使其透明 (如果使用了 NavBar) */
.nav-glass {
  background-color: transparent !important;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}
.nav-glass .van-nav-bar__title { 
  color: #222222 !important; 
  font-weight: bold !important; 
  letter-spacing: 2rpx;
}

/* 科技感莫兰迪环境光晕 */
.dynamic-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 600rpx;
  z-index: -1;
  background: linear-gradient(180deg, rgba(148, 164, 140, 0.12) 0%, rgba(250, 248, 245, 0) 100%);
  pointer-events: none;
}

/* ================= 通用毛玻璃卡片 ================= */
.glass-card {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(148, 164, 140, 0.06); /* 主色调极淡光晕 */
}

.skeleton-wrap { padding: 40rpx 30rpx; margin: 30rpx 24rpx; }
.skel-item { margin-bottom: 40rpx; }

/* ================= 购物车列表 ================= */
.cart-list {
  padding: 24rpx;
}

.cart-item {
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease;
}

.cart-item:active { transform: scale(0.98); }

/* --- 上半部分：图片与信息 --- */
.item-main {
  display: flex;
  margin-bottom: 30rpx;
  border-bottom: 1px solid rgba(0, 0, 0, 0.03); /* 极简分割线代替原有的虚线 */
  padding-bottom: 30rpx;
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  margin-right: 24rpx;
  background: #F8F9FA;
  border: 1px solid rgba(0, 0, 0, 0.02);
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222222;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tags-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: auto;
}

/* 标签样式 (莫兰迪绿) */
.point-tag {
  background: rgba(148, 164, 140, 0.08);
  color: #94A48C;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  border: 1px solid rgba(148, 164, 140, 0.15);
}

.goods-stock {
  font-size: 22rpx;
  color: #94a3b8;
}

.goods-price {
  margin-top: 10rpx;
}

.goods-price .unit { font-size: 24rpx; color: #222222; font-weight: bold; }
.goods-price .val { font-size: 36rpx; color: #222222; font-weight: bold; font-family: 'DIN Alternate', sans-serif;}

/* --- 下半部分：操作与小计 --- */
.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.sub-total {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

.sub-total .highlight {
  color: #94A48C; /* 莫兰迪绿高亮 */
  font-size: 32rpx;
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
}

.action-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 玻璃胶囊步进器 (完美贴合轻奢科技感) */
.stepper-glass {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 16rpx;
  overflow: hidden;
  height: 56rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
}

.btn-minus, .btn-plus {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #666666;
  background: transparent;
  transition: all 0.2s;
}

.btn-minus:active, .btn-plus:active { background: rgba(148, 164, 140, 0.1); color: #94A48C; }
.btn-minus.disabled, .btn-plus.disabled { color: #cbd5e1; background: transparent; }

.num-input {
  width: 60rpx;
  height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #222222;
  border-left: 1px solid rgba(0, 0, 0, 0.03);
  border-right: 1px solid rgba(0, 0, 0, 0.03);
  background: rgba(250, 248, 245, 0.5); /* 稍微深一点的奶油白衬托输入框 */
}

/* 柔和的科技感删除按钮 (脏粉色，高级警戒色) */
.delete-btn {
  height: 56rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(196, 155, 155, 0.08); 
  color: #C49B9B;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: 1px solid rgba(196, 155, 155, 0.15);
  transition: all 0.2s;
}

.delete-btn:active { background: rgba(196, 155, 155, 0.15); transform: scale(0.95); }
.delete-btn .icon { font-size: 24rpx; margin-right: 6rpx; }

/* ================= 底部结算悬浮栏 ================= */
.bottom-submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 150rpx;
  background: rgba(250, 248, 245, 0.85); /* 奶油可可白的高斯模糊 */
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1px solid rgba(0, 0, 0, 0.02);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx; /* 两侧留出更多呼吸感 */
  box-shadow: 0 -4rpx 30rpx rgba(148, 164, 140, 0.05); /* 主色极弱阴影 */
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.total-info { display: flex; align-items: baseline; }
.total-info .label { font-size: 26rpx; color: #666666; font-weight: 500;}

.pay-amount .unit { color: #94A48C; font-size: 28rpx; margin-left: 12rpx; font-weight: bold; }
.pay-amount .val { color: #94A48C; font-size: 44rpx; font-weight: bold; font-family: 'DIN Alternate', sans-serif;}

.submit-btn {
  width: 260rpx !important;
  height: 84rpx;
  background: linear-gradient(135deg, #94A48C 0%, #7A8B72 100%);
  color: #FFFFFF;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(148, 164, 140, 0.25);
  margin: 0;
  transition: transform 0.2s;
}

.submit-btn:active { transform: scale(0.96); box-shadow: 0 4rpx 10rpx rgba(148, 164, 140, 0.15); }

/* ================= 空状态页 (悬浮感) ================= */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 25vh;
}

.empty-icon-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-icon { font-size: 100rpx; z-index: 2; opacity: 0.8; }

/* 底部呼吸发光环 (主色调) */
.glow-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(148, 164, 140, 0.1);
  box-shadow: 0 0 40rpx rgba(148, 164, 140, 0.2);
  animation: pulse 3s infinite alternate;
}

@keyframes pulse {
  0% { transform: scale(0.8); opacity: 0.5; }
  100% { transform: scale(1.1); opacity: 1; }
}

.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
  letter-spacing: 2rpx;
  margin-bottom: 50rpx;
  font-weight: 500;
}

.empty-btn {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  color: #94A48C;
  border: 1px solid rgba(148, 164, 140, 0.4);
  border-radius: 40rpx;
  padding: 0 60rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 20rpx rgba(148, 164, 140, 0.08);
}
.empty-btn:active { transform: scale(0.96); }

/* 底部合并总计栏的积分数字高亮 */
.pay-amount .point-color {
  color: #94A48C; /* 统一的高级莫兰迪绿 */
  font-weight: 600;
  font-size: 32rpx;
}

/* 拼接用的加号加深 */
.pay-amount .plus-sign {
  color: #6B7067;
  font-size: 26rpx;
  margin: 0 8rpx;
  font-weight: bold;
}