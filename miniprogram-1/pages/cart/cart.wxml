<van-nav-bar title="我的购物车" fixed border="{{false}}" />

<view class="cart-container">
  <view class="cart-list" wx:if="{{cartList.length > 0}}">
    <van-card
      wx:for="{{cartList}}"
      wx:key="id"
      title="{{item.goods.name}}"
      thumb="{{item.goods.image_url}}"
      class="cart-item"
      border="{{true}}"
    >
      <view slot="price" style="color:#1989fa; font-size:30rpx; font-weight:bold;">
        <block wx:if="{{item.isPointGoods}}">
          {{item.pointPrice}} 积分
        </block>
        <block wx:else>
          ¥{{item.goods.member_price}}
        </block>
      </view>
      
      <view slot="desc">库存：{{item.goods.stock}} 件</view>
      
      <view slot="footer" class="num-control">
        <van-button 
          size="mini" 
          bindtap="changeNum" 
          data-id="{{item.id}}" 
          data-type="minus"
          disabled="{{item.num <= 1}}"
        >-</van-button>
        <input type="number" value="{{item.num}}" disabled class="num-input" />
        <van-button 
          size="mini" 
          bindtap="changeNum" 
          data-id="{{item.id}}" 
          data-type="plus"
          disabled="{{item.num >= item.goods.stock}}"
        >+</van-button>
        <van-button 
          size="mini" 
          type="danger" 
          bindtap="deleteCart" 
          data-id="{{item.id}}" 
          style="margin-left: 10rpx;"
        >删除</van-button>
      </view>
      
      <view slot="extra" style="font-size:24rpx; color:#666;">
        小計：
        <text style="color:#1989fa; font-weight:bold;">
          {{item.isPointGoods ? item.total_price + ' 积分' : '¥' + item.total_price}}
        </text>
      </view>
    </van-card>
  </view>

  <view wx:if="{{cartList.length === 0 && !loading}}" class="empty-wrap">
    <view class="empty-icon">🛒</view>
    <view class="empty-text">购物车空空如也~快去商城逛逛吧！</view>
    <van-button type="primary" color="#1989fa" round bindtap="toMall" class="empty-btn">去商城</van-button>
  </view>

  <van-skeleton title row="3" wx:if="{{loading}}" class="skeleton-wrap" wx:for="{{2}}" wx:key="index" />

  <view class="checkout-bar" wx:if="{{cartList.length > 0}}">
    <view class="total-info">
      总计：
      <text class="total-price">
        {{isAllPointGoods ? totalAll + ' 积分' : '¥' + totalAll}}
      </text>
    </view>
    <van-button type="primary" color="#1989fa" round bindtap="toCheckout" custom-class="pay-btn">去结算</van-button>
  </view>

  <van-toast id="van-toast" />
</view>