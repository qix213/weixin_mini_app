<van-nav-bar title="我的购物车" fixed />

<!-- 购物车主容器（避开导航栏） -->
<view class="cart-container">
  <!-- 购物车列表 -->
  <view class="cart-list" wx:if="{{cartList.length > 0}}">
    <van-card
      wx:for="{{cartList}}"
      wx:key="id"
      title="{{item.goods.name}}"
      thumb="{{item.goods.image_url}}"
      class="cart-item"
      border="{{true}}"
    >
      <!-- 价格/积分展示：积分商品显示积分，普通商品显示金额 -->
      <view slot="price" style="color:#e64340; font-size:30rpx; font-weight:bold;">
        <block wx:if="{{item.isPointGoods}}">
          {{item.pointPrice}} 积分
        </block>
        <block wx:else>
          ¥{{item.goods.member_price}}
        </block>
      </view>
      
      <view slot="desc">库存：{{item.goods.stock}} 件</view>
      
      <view slot="footer" class="num-control">
        <!-- 减少数量 -->
        <van-button 
          size="mini" 
          bindtap="changeNum" 
          data-id="{{item.id}}" 
          data-type="minus"
          disabled="{{item.num <= 1}}"
        >-</van-button>
        <!-- 数量显示 -->
        <input type="number" value="{{item.num}}" disabled class="num-input" />
        <!-- 增加数量 -->
        <van-button 
          size="mini" 
          bindtap="changeNum" 
          data-id="{{item.id}}" 
          data-type="plus"
          disabled="{{item.num >= item.goods.stock}}"
        >+</van-button>
        <!-- 删除商品 -->
        <van-button 
          size="mini" 
          type="danger" 
          bindtap="deleteCart" 
          data-id="{{item.id}}" 
          style="margin-left: 10rpx;"
        >删除</van-button>
      </view>
      
      <!-- 新增：商品小计（积分/金额） -->
      <view slot="extra" style="font-size:24rpx; color:#666;">
        小计：
        <text style="color:#e64340; font-weight:bold;">
          {{item.isPointGoods ? item.total_price + ' 积分' : '¥' + item.total_price}}
        </text>
      </view>
    </van-card>
  </view>

  <!-- 空购物车占位 -->
  <view wx:if="{{cartList.length === 0 && !loading}}" class="empty-wrap">
    <!-- 自定义空购物车样式，不用Vant的cart图片 -->
    <view class="empty-icon">🛒</view>
    <view class="empty-text">购物车空空如也~快去商城逛逛吧！</view>
    <van-button type="primary" bindtap="toMall" class="empty-btn">去商城</van-button>
  </view>

  <!-- 加载中占位 -->
  <van-skeleton title row="3" wx:if="{{loading}}" class="skeleton-wrap" wx:for="2" wx:key="index" />

  <!-- 底部结算栏（有商品时显示，适配积分/金额） -->
  <view class="checkout-bar" wx:if="{{cartList.length > 0}}">
    <view class="total-price">
      总计：
      <text style="color:#e64340; font-weight:bold;">
        {{isAllPointGoods ? totalAll + ' 积分' : '¥' + totalAll}}
      </text>
    </view>
    <van-button type="primary" bindtap="toCheckout">去结算</van-button>
  </view>

  <van-toast id="van-toast" />
</view>