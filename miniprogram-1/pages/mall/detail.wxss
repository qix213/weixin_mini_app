/* 引入全局可可白背景 */
page {
  background-color: #FAF8F5; /* 优雅温暖的可可白 */
  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.detail-container {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ================= 轮播图区域 ================= */
.swiper-container {
  position: relative;
  width: 100%;
  background-color: #FFFFFF;
}

.goods-swipe {
  width: 100%;
  height: 750rpx; /* 1:1 正方形 */
}

.goods-media {
  width: 100%;
  height: 100%;
  display: block;
}

/* 轮播指示器 */
.custom-indicator {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  background: rgba(0, 0, 0, 0.4);
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  color: #FFFFFF;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  backdrop-filter: blur(4px);
}

.no-img-tip {
  width: 100%;
  height: 750rpx;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.default-img { width: 200rpx; height: 200rpx; opacity: 0.5; }

/* ================= 信息卡片 (白色容器，凸显于可可白背景) ================= */
.info-card, .detail-card {
  background-color: #FFFFFF;
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.02);
}

/* --- 1. 商品标题 --- */
.goods-title {
  font-size: 32rpx;
  color: #111111;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

/* --- 2 & 3. 价格展示排版 --- */
.price-wrap {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 22rpx;
  margin-right: 16rpx;
  width: 80rpx; /* 固定宽度对齐 */
}

.price-val {
  font-family: 'DIN Alternate', sans-serif;
}

/* 主价格：#94A48C 主色调 */
.highlight-row .price-label { color: #94A48C; font-weight: 500;}
.highlight-row .price-val { font-size: 40rpx; color: #94A48C; font-weight: bold; }

/* 积分展示 */
.point-val { font-size: 40rpx; color: #94A48C; font-weight: bold; }

/* 副价格：灰色划线 */
.muted-row .price-label { color: #A3A3A3; }
.muted-row .price-val { font-size: 24rpx; color: #A3A3A3; }
.strikethrough { text-decoration: line-through; }

/* ================= 详细信息区卡片 ================= */
.detail-card {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.detail-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-title {
  font-size: 26rpx;
  color: #111111;
  font-weight: 600;
  position: relative;
  padding-left: 16rpx;
}

/* 标题左侧的一抹主色调细线 */
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 24rpx;
  background-color: #94A48C;
  border-radius: 4rpx;
}

.section-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  white-space: pre-wrap; /* 保持后端传入的换行格式 */
}

/* ================= 底部固定动作条 ================= */
.action-bar-placeholder { height: 120rpx; }
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 110rpx;
  background-color: #FFFFFF;
  border-top: 1px solid rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 30rpx;
  box-sizing: border-box;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 99;
}

.action-btn {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 36rpx;
  padding: 0 40rpx;
  margin-left: 20rpx;
}

/* 购物车按钮：带主色调边框的白底 */
.cart-btn {
  background-color: #FFFFFF;
  color: #94A48C;
  border: 1px solid #94A48C;
}

/* 购买按钮：主色调实心填充 */
.buy-btn {
  background-color: #94A48C;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(148, 164, 140, 0.3);
}

.action-btn:active { opacity: 0.8; }

/* ================= 底部弹窗 (数量选择器) ================= */
.buy-popup {
  background-color: #FAF8F5 !important;
}

.popup-container {
  padding: 30rpx 30rpx 40rpx 30rpx;
  display: flex;
  flex-direction: column;
}

.popup-header {
  display: flex;
  padding-bottom: 40rpx;
  border-bottom: 1px solid rgba(0,0,0,0.04);
}

.popup-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background-color: #FFFFFF;
  margin-right: 24rpx;
  border: 1px solid rgba(0,0,0,0.04);
}

.popup-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
}

.popup-price {
  font-size: 36rpx;
  color: #94A48C;
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
}

.popup-stock {
  font-size: 24rpx;
  color: #999999;
}

.popup-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 0;
}

.stepper-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* 精致弹窗步进器 */
.custom-stepper {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 30rpx;
  padding: 6rpx;
  border: 1px solid rgba(0,0,0,0.04);
}

.step-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F5F5F5;
  color: #666666;
}

.step-btn.disabled { opacity: 0.5; }
.step-btn.plus { background-color: #94A48C; color: #FFFFFF; }
.step-input { width: 60rpx; text-align: center; font-size: 28rpx; font-weight: bold; color: #333333; }

.popup-footer {
  margin-top: 20rpx;
}

.confirm-btn {
  width: 100%;
  height: 80rpx;
  background-color: #94A48C;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(148, 164, 140, 0.3);
}

.confirm-btn:active { opacity: 0.9; transform: scale(0.98); }

/* ================= 异常状态 ================= */
.skeleton-wrap { padding: 30rpx; background: #FFFFFF; }
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; }
.empty-img { width: 300rpx; height: 300rpx; opacity: 0.5; }
.empty-text { margin-top: 30rpx; font-size: 28rpx; color: #999999; }