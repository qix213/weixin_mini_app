/* ================= 全局科技背景 ================= */
page {
  min-height: 100vh;
}

.detail-container {
  position: relative;
  min-height: 100vh;
  /* 优化：左右边距收紧，让卡片更宽泛 */
  padding: 16rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.dynamic-bg {
  position: fixed;
  top: 0; left: 0; width: 100%; height: 100%;
  z-index: -1;
  background: linear-gradient(-45deg, #e0f2fe, #ffffff, #bae6fd, #f8fafc);
  background-size: 400% 400%;
  animation: gradientBG 15s ease infinite;
}

@keyframes gradientBG {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ================= 亚克力通用玻璃卡片 ================= */
.glass-card {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  /* 优化：圆角微调，契合紧凑布局 */
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(14, 165, 233, 0.06);
  /* 🚀 核心优化：模块间隙大幅收紧 */
  margin-bottom: 16rpx; 
  overflow: hidden;
}

/* ================= 媒体轮播区域 ================= */
.swiper-container {
  position: relative;
  width: 100%;
  /* 优化：750rpx - 左右各16rpx = 718rpx，保持完美正方形 */
  height: 718rpx; 
}

.goods-swipe {
  width: 100%;
  height: 100%;
}

.goods-media {
  width: 100%;
  height: 100%;
  display: block;
}

.no-img-tip {
  width: 100%;
  height: 718rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.default-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.4;
}

/* 科技感发光轮播指示器 */
.custom-indicator {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 6rpx 24rpx;
  background: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 30rpx;
  z-index: 10;
  display: flex;
  align-items: baseline;
  box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.1);
}

.current-num { font-size: 28rpx; color: #fff; font-weight: 900; }
.slash { font-size: 22rpx; color: #94a3b8; margin: 0 6rpx; }
.total-num { font-size: 22rpx; color: #cbd5e1; font-weight: bold; }

/* ================= 基础信息区域 ================= */
.goods-info-card {
  /* 优化：内部留白收紧，看起来更精致 */
  padding: 24rpx;
}

.price-wrap {
  margin-bottom: 16rpx;
}

.money-price-box, .point-price-box {
  display: flex;
  align-items: baseline;
}

/* 科技蓝渐变字体 */
.tech-gradient-text {
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  -webkit-background-clip: text;
  color: transparent;
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.price-unit {
  font-size: 26rpx;
  font-weight: bold;
  color: #0ea5e9;
  margin-right: 6rpx;
}

.origin-price {
  font-size: 24rpx;
  color: #94a3b8;
  text-decoration: line-through;
  margin-left: 16rpx;
}

.title-wrap {
  margin-bottom: 12rpx;
}

.goods-title {
  font-size: 32rpx;
  color: #1e293b;
  font-weight: 900;
  line-height: 1.4;
}

.goods-desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.meta-footer {
  display: flex;
  justify-content: space-between;
  border-top: 2rpx dashed rgba(14, 165, 233, 0.2);
  /* 优化：分割线上下间距收缩 */
  padding-top: 20rpx;
  margin-top: 16rpx; 
}

.meta-text {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 500;
}

/* ================= 步进器 ================= */
.section-card {
  /* 优化：卡片内边距统一收紧 */
  padding: 24rpx;
}

.flex-row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-label {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 800;
}

.custom-stepper {
  display: flex;
  align-items: center;
  background: rgba(241, 245, 249, 0.6);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 12rpx;
  padding: 4rpx;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #334155;
  font-weight: bold;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.02);
}

.step-btn.disabled { color: #cbd5e1; background: transparent; box-shadow: none; }
.step-plus { color: #0ea5e9; }

.step-input {
  width: 70rpx;
  height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1e293b;
  font-weight: bold;
}

/* ================= 图文详情 ================= */
.detail-card {
  min-height: 300rpx;
}

.section-header {
  display: flex;
  justify-content: center;
  align-items: center;
  /* 优化：标题底部留白稍微收紧 */
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #0ea5e9;
  margin: 0 24rpx;
  letter-spacing: 2rpx;
}

.header-line {
  width: 80rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #38bdf8, transparent);
}

.specs-box {
  background: rgba(248, 250, 252, 0.7);
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(14, 165, 233, 0.1);
}

.specs-label {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 8rpx;
  font-weight: bold;
}

.specs-value {
  font-size: 24rpx;
  color: #1e293b;
  font-weight: 600;
}

.desc-content {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.7;
  white-space: pre-wrap;
}

/* ================= 底部操作栏（高光渐变） ================= */
.glass-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border-top: 2rpx solid rgba(255, 255, 255, 1);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  z-index: 100;
  box-shadow: 0 -10rpx 30rpx rgba(14, 165, 233, 0.05);
}

.action-btn-group {
  display: flex;
  height: 84rpx;
  border-radius: 42rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(14, 165, 233, 0.2);
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  color: #fff;
  transition: opacity 0.2s;
}

.action-btn:active { opacity: 0.9; }

.cart-btn {
  background: linear-gradient(135deg, #38bdf8, #0284c7);
}

.buy-btn {
  background: linear-gradient(135deg, #0ea5e9, #1e3a8a);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-img {
  width: 240rpx;
  height: 240rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
  margin-top: 24rpx;
  font-weight: bold;
}