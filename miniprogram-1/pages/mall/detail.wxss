page {
  --primary-color: #1677ff;
  --primary-light: #E6F0FF;
  --text-main: #333333;
  --text-gray: #999999;
}

.detail-container {
  background-color: #F4F6F9;
  min-height: 100vh;
}

/* ================= 轮播图区 ================= */
.goods-swipe {
  width: 100vw;
  height: 100vw; /* 1:1 比例，主流电商标准 */
  background-color: #fff;
  display: block !important;
}
.goods-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block !important;
}
.no-img-tip {
  width: 100%;
  height: 100vw;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.default-img {
  width: 300rpx;
  height: 300rpx;
  opacity: 0.5;
}

/* ================= 悬浮商品信息面板 ================= */
.goods-info-card {
  position: relative;
  margin: -30rpx 24rpx 24rpx; /* 负边距实现上浮叠加效果 */
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  z-index: 10;
}

/* 价格区 */
.price-wrap {
  margin-bottom: 20rpx;
}
/* 积分样式 */
.point-price-box {
  display: inline-flex;
  align-items: baseline;
  background: var(--primary-light);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}
.point-price-box .price-val {
  color: var(--primary-color);
  font-size: 48rpx;
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
  margin-right: 8rpx;
}
.point-price-box .price-unit {
  color: var(--primary-color);
  font-size: 24rpx;
  font-weight: 500;
}
/* 人民币样式 */
.money-price-box {
  display: flex;
  align-items: baseline;
}
.money-price-box .price-unit {
  color: var(--primary-color);
  font-size: 30rpx;
  font-weight: bold;
}
.money-price-box .price-val {
  color: var(--primary-color);
  font-size: 56rpx;
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
}
.origin-price {
  color: var(--text-gray);
  font-size: 26rpx;
  text-decoration: line-through;
  margin-left: 16rpx;
}

/* 标题区 */
.title-wrap {
  margin-bottom: 12rpx;
}
.goods-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-main);
  line-height: 48rpx;
}
.desc-wrap {
  margin-bottom: 24rpx;
}
.goods-desc {
  font-size: 26rpx;
  color: var(--text-gray);
  line-height: 36rpx;
}

/* 底部数据概览 */
.meta-footer {
  display: flex;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx dashed #F0F0F0;
}
.meta-text {
  font-size: 24rpx;
  color: #888;
}

/* ================= 通用卡片块 ================= */
.section-card {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
}
.flex-row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.section-label {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
}

/* 现代感步进器 */
.custom-stepper {
  display: flex;
  align-items: center;
  background: #F4F6F9;
  border-radius: 12rpx;
  overflow: hidden;
}
.step-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
}
.step-btn.disabled {
  color: #ccc;
}
.step-input {
  width: 70rpx;
  height: 56rpx;
  min-height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  background: #fff;
  color: #333;
  font-weight: 500;
}

/* ================= 图文详情区 ================= */
.detail-card {
  padding: 40rpx 30rpx;
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}
.header-line {
  width: 60rpx;
  height: 2rpx;
  background: #E2E8F0;
}
.header-title {
  font-size: 28rpx;
  color: var(--text-gray);
  margin: 0 20rpx;
  letter-spacing: 2rpx;
}

.specs-box {
  background: #F8FAFC;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  display: flex;
}
.specs-label {
  color: #64748B;
  font-size: 26rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.specs-value {
  color: var(--text-main);
  font-size: 26rpx;
}

.desc-content {
  font-size: 28rpx;
  color: #475569;
  line-height: 1.8;
  word-wrap: break-word;
}

/* ================= 底部吸底操作栏 ================= */
.action-bar-placeholder {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
.action-bar-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #fff;
  padding: 16rpx 24rpx env(safe-area-inset-bottom); /* 适配苹果底部小黑条 */
  box-sizing: border-box;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
  z-index: 99;
}
.action-btn-group {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}
.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
}
/* 购物车按钮：淡蓝色 */
.cart-btn {
  background: var(--primary-light);
  color: var(--primary-color);
}
/* 购买按钮：蓝色渐变 */
.buy-btn {
  background: linear-gradient(90deg, #4096ff, #1677ff);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(22, 119, 255, 0.3);
}

/* ================= 缺省页/骨架屏 ================= */
.skeleton-wrap {
  padding: 30rpx;
  background: #fff;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 0;
}
.empty-img {
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 30rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}