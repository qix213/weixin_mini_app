.detail-container {
  padding-bottom: 120rpx;
  background-color: #f5f5f5;
}

/* 原生swiper样式（替换原goods-swipe） */
.goods-swipe {
  width: 100%;
  height: 600rpx;
  background-color: #fff;
  /* 强制渲染，避免被隐藏 */
  display: block !important;
}

.goods-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  /* 强制显示，优先级最高 */
  display: block !important;
}

/* 其他样式保持不变 */
.no-img-tip {
  width: 100%;
  height: 600rpx;
  line-height: 600rpx;
  text-align: center;
  background-color: #fff;
  color: #999;
  font-size: 32rpx;
}

/* 商品卡片 */
.goods-base-card {
  margin: 10rpx;
  padding: 20rpx;
  background-color: #fff;
}

.base-info-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  color: #666;
  font-size: 28rpx;
}

/* 数量选择器 */
.num-selector {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
  margin: 10rpx;
}

.selector-title {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.num-control {
  display: flex;
  align-items: center;
}

.num-control button {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border: 1px solid #eee;
  background-color: #fff;
}

.num-control input {
  width: 80rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-top: 1px solid #eee;
  border-bottom: 1px solid #eee;
  margin: 0 -1px;
}

/* 商品详情区 */
.goods-desc-section {
  background-color: #fff;
  margin: 10rpx;
  padding: 20rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.specs-item {
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.specs-label {
  color: #666;
  margin-right: 10rpx;
}

.specs-value {
  color: #333;
}

.desc-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 底部操作栏 */
.operation-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  height: 100rpx;
  line-height: 100rpx;
  background-color: #fff;
  border-top: 1px solid #eee;
}

.cart-btn, .buy-btn {
  flex: 1;
  height: 100%;
  line-height: 100rpx;
  text-align: center;
  border-radius: 0;
}

.buy-btn {
  background-color: #1E88E5;
  color: #fff;
}

/* 骨架屏/空状态 */
.skeleton-wrap {
  padding: 20rpx;
}

.empty-wrap {
  padding: 100rpx 0;
}