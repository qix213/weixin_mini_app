<view class="detail-container">
  <view class="dynamic-bg"></view>

  <view class="skeleton-wrap glass-card" wx:if="{{loading}}">
    <van-skeleton title row="8" />
  </view>

  <view class="main-content" wx:if="{{!loading && goodsDetail.id}}">
    
    <view class="swiper-container glass-card" wx:if="{{mediaList.length > 0}}">
      <swiper 
        class="goods-swipe" 
        indicator-dots="{{false}}"  
        autoplay="{{!isPlayingVideo}}" 
        interval="5000"
        circular="{{true}}" 
        bindchange="onSwipeChange"
      >
        <swiper-item wx:for="{{mediaList}}" wx:key="index">
          
          <video 
            wx:if="{{item.type === 1}}"
            id="goods-video-{{index}}"  src="{{item.url}}" 
            class="goods-media"
            controls
            object-fit="contain"
            show-center-play-btn="{{true}}"
            bindplay="onVideoPlay"
            bindpause="onVideoPause"
            bindended="onVideoPause"
          ></video>
          
          <image 
            wx:else
            src="{{item.url}}" 
            mode="aspectFit"  
            class="goods-media"
            bindtap="previewImages"  
            data-index="{{index}}" 
            data-src="{{item.url}}"
            binderror="imageLoadError" 
          />
        </swiper-item>
      </swiper>
      
      <view class="custom-indicator blur-pill">
        <text class="current-num">{{currentSwipeIndex + 1}}</text>
        <text class="slash"> / </text>
        <text class="total-num">{{mediaList.length}}</text>
      </view>
    </view>
    
    <view class="no-img-tip glass-card" wx:elif="{{mediaList.length === 0}}">
      <image class="default-img" src="https://img.yzcdn.cn/vant/empty-image-default.png" mode="aspectFit"></image>
    </view>

    <view class="goods-info-card glass-card">
      <view class="price-wrap">
        <block wx:if="{{isPointGoods}}">
          <view class="point-price-box">
            <text class="price-val tech-gradient-text">{{pointPrice}}</text>
            <text class="price-unit"> 积分</text>
          </view>
        </block>
        <block wx:else>
          <view class="money-price-box">
            <text class="price-unit">¥</text>
            <text class="price-val tech-gradient-text">{{goodsDetail.member_price}}</text>
            <text class="origin-price" wx:if="{{goodsDetail.original_price}}">¥{{goodsDetail.original_price}}</text>
          </view>
        </block>
      </view>

      <view class="title-wrap">
        <text class="goods-title">{{goodsDetail.name}}</text>
      </view>
      <view class="desc-wrap" wx:if="{{goodsDetail.brief_intro}}">
        <text class="goods-desc">{{goodsDetail.brief_intro}}</text>
      </view>

      <view class="meta-footer">
        <text class="meta-text"><text class="icon">📦</text> 库存 {{goodsDetail.stock}}</text>
        <text class="meta-text" wx:if="{{goodsDetail.sales}}"><text class="icon">🔥</text> 销量 {{goodsDetail.sales}}</text>
      </view>
    </view>

    <view class="section-card glass-card flex-row-between">
      <text class="section-label">购买数量</text>
      <view class="custom-stepper">
        <view class="step-btn {{cartNum <= 1 ? 'disabled' : ''}}" bindtap="minusNum">-</view>
        <input class="step-input" type="number" value="{{cartNum}}" bindinput="changeNum" />
        <view class="step-btn step-plus" bindtap="plusNum">+</view>
      </view>
    </view>

    <view class="section-card glass-card detail-card">
      <view class="section-header">
        <view class="header-line"></view>
        <text class="header-title">产品详情</text>
        <view class="header-line"></view>
      </view>

      <view class="specs-box" wx:if="{{goodsDetail.specs}}">
        <text class="specs-label">产品规格</text>
        <text class="specs-value">{{goodsDetail.specs}}</text>
      </view>

      <view class="desc-content">
        <text>{{goodsDetail.intro || goodsDetail.description || '暂无详细描述'}}</text>
      </view>
    </view>

  </view>

  <view class="action-bar-placeholder" wx:if="{{!loading && goodsDetail.id}}"></view>
  <view class="action-bar-wrap glass-bar" wx:if="{{!loading && goodsDetail.id}}">
    <view class="action-btn-group">
      <view class="action-btn cart-btn" bindtap="addToCart">加入购物车</view>
      <view class="action-btn buy-btn" bindtap="buyNow">立即结算</view>
    </view>
  </view>

  <van-toast id="van-toast" />
  
  <view class="empty-state glass-card" wx:if="{{!loading && !goodsDetail.id}}">
    <image class="empty-img" src="https://img.yzcdn.cn/vant/empty-image-default.png" mode="aspectFit"></image>
    <text class="empty-text">商品似乎去了外太空</text>
  </view>
</view>