<view class="detail-container">
  <!-- 加载中骨架屏 -->
  <van-skeleton title row="6" wx:if="{{loading}}" class="skeleton-wrap" />

  <!-- 商品详情内容 -->
  <view wx:if="{{!loading && goodsDetail.id}}">
    <!-- 核心：改用原生swiper，放弃van-swipe -->
    <swiper 
      class="goods-swipe" 
      indicator-dots="{{true}}" 
      indicator-color="#fff" 
      indicator-active-color="#1E88E5" 
      autoplay="{{false}}" 
      circular="{{true}}" 
      bindchange="onSwipeChange"
      wx:if="{{imageList.length > 0}}"
    >
      <swiper-item wx:for="{{imageList}}" wx:key="index">
        <!-- 强制渲染image，关闭懒加载，加超时兜底 -->
        <image 
          src="{{item}}" 
          mode="aspectFill"  
          class="goods-img"
          bindtap="previewImages"  
          data-index="{{index}}" 
          lazy-load="{{false}}"  
          show-menu-by-longpress="{{false}}"
          binderror="imageLoadError" 
          bindload="imageLoadSuccess" 
        />
      </swiper-item>
    </swiper>

    <!-- 图片列表为空时的提示 -->
    <view class="no-img-tip" wx:elif="{{imageList.length === 0}}">
      暂无商品图片
    </view>

    <!-- 商品基础信息/数量选择器/详情/底部操作栏 保持不变 -->
    <van-card
      title="{{goodsDetail.name}}"
      price="{{goodsDetail.member_price}}"
      origin-price="¥{{goodsDetail.original_price}}"
      desc="{{goodsDetail.brief_intro || '暂无商品简介'}}"
      class="goods-base-card"
      border="{{false}}"
    >
      <view slot="footer" class="base-info-footer">
        <text class="stock-text">库存：{{goodsDetail.stock}} 件</text>
        <text class="sales-text" wx:if="{{goodsDetail.sales}}">销量：{{goodsDetail.sales}} 件</text>
      </view>
    </van-card>

    <view class="num-selector">
      <view class="selector-title">购买数量：</view>
      <view class="num-control">
        <button size="mini" bindtap="minusNum" disabled="{{cartNum <= 1}}">-</button>
        <input type="number" value="{{cartNum}}" bindinput="changeNum" min="1" />
        <button size="mini" bindtap="plusNum">+</button>
      </view>
    </view>

    <view class="goods-desc-section">
      <view class="section-title">商品详情</view>
      <view class="specs-item" wx:if="{{goodsDetail.specs}}">
        <text class="specs-label">产品规格：</text>
        <text class="specs-value">{{goodsDetail.specs}}</text>
      </view>
      <view class="desc-content">
        <text>{{goodsDetail.intro || goodsDetail.description || '暂无详细描述'}}</text>
      </view>
    </view>

    <view class="operation-bar">
      <van-button type="default" bindtap="addToCart" class="cart-btn">加入购物车</van-button>
      <van-button bindtap="buyNow" class="buy-btn">立即购买</van-button>
    </view>
  </view>

  <van-toast id="van-toast" />
  <van-empty image="goods" description="商品不存在或已下架" wx:if="{{!loading && !goodsDetail.id}}" class="empty-wrap" />
</view>