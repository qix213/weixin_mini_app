<view class="detail-container">

<view class="skeleton-wrap" wx:if="{{loading}}">
  <van-skeleton title row="8" />
</view>

<view class="main-content" wx:if="{{!loading && goodsDetail.id}}">
  
  <view class="swiper-container" wx:if="{{mediaList.length > 0}}">
    <swiper class="goods-swipe" indicator-dots="{{false}}" autoplay="{{!isPlayingVideo}}" interval="5000" circular="{{true}}" bindchange="onSwipeChange">
      <swiper-item wx:for="{{mediaList}}" wx:key="index">
        <video wx:if="{{item.type === 1}}" id="goods-video-{{index}}" src="{{item.url}}" class="goods-media" controls object-fit="contain" show-center-play-btn="{{true}}" bindplay="onVideoPlay" bindpause="onVideoPause" bindended="onVideoPause"></video>
        <image wx:else src="{{item.url}}" mode="aspectFill" class="goods-media" bindtap="previewImages" data-index="{{index}}" data-src="{{item.url}}" binderror="imageLoadError" />
      </swiper-item>
    </swiper>
    
    <view class="custom-indicator">
      <text class="current-num">{{currentSwipeIndex + 1}}</text>
      <text class="slash"> / </text>
      <text class="total-num">{{mediaList.length}}</text>
    </view>
  </view>
  
  <view class="no-img-tip" wx:elif="{{mediaList.length === 0}}">
    <image class="default-img" src="https://img.yzcdn.cn/vant/empty-image-default.png" mode="aspectFit"></image>
  </view>

  <view class="product-info-wrapper">
    
    <view class="goods-header">
      <text class="goods-title">{{goodsDetail.name}}</text>
      <text class="goods-specs" wx:if="{{goodsDetail.goods_type === 2 && goodsDetail.service_times}}">包含次数：{{goodsDetail.service_times}}次</text>
      <text class="goods-specs" wx:elif="{{goodsDetail.goods_type !== 2 && goodsDetail.qualification}}">{{goodsDetail.qualification}}</text>
    </view>

    <!-- 🌟 主页面价格渲染 -->
    <view class="price-section">
      <block wx:if="{{isPointGoods}}">
        <view class="price-row member-price">
          <text class="price-label">兑换所需</text>
          <text class="price-val point-val">{{pointPrice}} 积分</text>
        </view>
      </block>
      <block wx:else>
        <!-- 1. 当前角色该享受的主价格 -->
        <view class="price-row member-price">
          <text class="price-label">{{mainPriceLabel}}</text>
          <text class="price-symbol">￥</text>
          <text class="price-val">{{mainPriceValue}}</text>
        </view>
        
        <!-- 2. 🌟 修复：独立显示划线的副价格 -->
        <!-- 注意这里是 wx:if，不是 wx:elif！并且去掉了 goods_type !== 2 的限制 -->
        <view class="price-row retail-price" wx:if="{{subPriceValue && subPriceValue !== '0.00' && subPriceValue !== '0' && mainPriceValue !== subPriceValue}}">
          <text class="price-label">{{subPriceLabel}}</text>
          <text class="price-val strikethrough">￥{{subPriceValue}}</text>
        </view>

        <!-- 3. 服务项目独立显示次数 -->
        <view class="price-row member-price" wx:if="{{goodsDetail.goods_type === 2 && goodsDetail.service_times}}">
          <text class="price-label" style="font-size: 24rpx; color: #8A8E88; margin-left: 16rpx;">包含次数：{{goodsDetail.service_times}}次</text>
        </view>
      </block>
    </view>

    <view class="intro-text" wx:if="{{goodsDetail.intro}}">
      {{goodsDetail.intro}}
    </view>

    <view class="theme-divider"></view>
    
    <view class="detail-section" wx:if="{{goodsDetail.fuc}}">
      <view class="section-title">
        <view class="vertical-bar"></view>
        <text>{{goodsDetail.goods_type === 2 ? '针对问题' : '产品功效'}}</text>
      </view>
      <view class="section-content">{{goodsDetail.fuc}}</view>
    </view>

    <view class="detail-section" wx:if="{{goodsDetail.brief_intro}}">
      <view class="section-title">
        <view class="vertical-bar"></view>
        <text>{{goodsDetail.goods_type === 2 ? '应急护理' : '核心成分'}}</text>
      </view>
      <view class="section-content">{{goodsDetail.brief_intro}}</view>
    </view>

    <view class="detail-section" wx:if="{{goodsDetail.specs}}">
      <view class="section-title">
        <view class="vertical-bar"></view>
        <text>{{goodsDetail.goods_type === 2 ? '常规护理' : '适合肤质'}}</text>
      </view>
      <view class="section-content">{{goodsDetail.specs}}</view>
    </view>

    <view class="detail-section" wx:if="{{goodsDetail.method}}">
      <view class="section-title">
        <view class="vertical-bar"></view>
        <text>{{goodsDetail.goods_type === 2 ? '特殊护理' : '使用方法'}}</text>
      </view>
      <view class="section-content">{{goodsDetail.method}}</view>
    </view>

  </view>
</view>

<view class="action-bar-placeholder" wx:if="{{!loading && goodsDetail.id}}"></view>
<view class="action-bar" wx:if="{{!loading && goodsDetail.id}}">
  <view class="action-btn cart-btn" bindtap="openPopup" data-action="cart">加入购物车</view>
  <view class="action-btn buy-btn" bindtap="openPopup" data-action="buy">立即购买</view>
</view>

<van-popup show="{{ showPopup }}" position="bottom" round closeable bind:close="closePopup" custom-class="buy-popup">
  <view class="popup-container">
    <view class="popup-header">
      <image class="popup-img" src="{{mediaList[0].url || 'https://img.yzcdn.cn/vant/empty-image-default.png'}}" mode="aspectFill"></image>
      <!-- 🌟 弹窗内价格渲染 -->
      <view class="popup-info">
        <text class="popup-price" wx:if="{{isPointGoods}}">{{pointPrice}} 积分</text>
        <text class="popup-price" wx:else>¥{{mainPriceValue}}</text>
        <text class="popup-stock">库存 {{goodsDetail.stock}}件</text>
      </view>
    </view>
    <view class="popup-body">
      <text class="stepper-label">购买数量</text>
      <view class="custom-stepper">
        <view class="step-btn {{cartNum <= 1 ? 'disabled' : ''}}" bindtap="minusNum"><van-icon name="minus" /></view>
        <input class="step-input" type="number" value="{{cartNum}}" bindinput="changeNum" />
        <view class="step-btn plus" bindtap="plusNum"><van-icon name="plus" color="#FFFFFF" /></view>
      </view>
    </view>
    <view class="popup-footer">
      <view class="confirm-btn" bindtap="onConfirmAction">确 定</view>
    </view>
  </view>
</van-popup>

<view class="empty-state" wx:if="{{!loading && !goodsDetail.id}}">
  <image class="empty-img" src="https://img.yzcdn.cn/vant/empty-image-default.png" mode="aspectFit"></image>
  <text class="empty-text">商品已下架</text>
</view>
</view>