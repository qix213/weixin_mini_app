page {
  background-color: #F5F7FA; 
}

.container {
  padding: 20rpx; /* 外边距收紧 */
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx; /* 卡片内边距从30缩小到24 */
  margin-bottom: 20rpx; /* 卡片间距缩小 */
}

/* 极窄状态条 */
.status-banner.slim {
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.status-banner.success { background-color: #edf7ed; color: #2e7d32; }
.status-banner.error { background-color: #fff4f4; color: #d32f2f; }
.status-text { font-size: 26rpx; margin-left: 12rpx; font-weight: 500; }

/* 瘦身版地址卡片 */
.address-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0; /* 极大地缩减了上下高度 */
}

.icon-tag {
  width: 44rpx; /* 圆圈变小 */
  height: 44rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 22rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
}
.icon-tag.blue { background: #3b82f6; }
.icon-tag.red { background: #ef4444; }

.info { flex: 1; display: flex; flex-direction: column; }
.name-phone { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 6rpx; }
.name-phone .name { margin-right: 16rpx; }
.name-phone .phone { color: #666; font-weight: normal; font-size: 26rpx; }
.addr { font-size: 24rpx; color: #888; line-height: 1.3; }

.arrow-right { color: #ccc; font-size: 28rpx; }
.address-divider { height: 1px; background: #f0f0f0; margin: 10rpx 0 10rpx 64rpx; }

/* 表单组合并卡片 */
.integrated-card { padding: 10rpx 24rpx 24rpx; }

.form-group {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid #f5f5f5;
}
.form-group .label { font-size: 28rpx; color: #333; font-weight: 500; }
.picker-value { flex: 1; text-align: right; font-size: 28rpx; color: #333; }
.spec-text { color: #007aff; /* 给可点击的套餐加点强调色 */ }
.arrow { font-size: 20rpx; color: #bbb; margin-left: 8rpx; }

/* 运费预估结果框 (扁平化融入) */
.estimate-box {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 24rpx;
}
.estimate-box .row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}
.estimate-box .row.highlight {
  border-top: 1px dashed #e2e8f0;
  padding-top: 16rpx;
  margin-top: 12rpx;
  color: #333;
}
.estimate-box .row .points { color: #ea580c; font-size: 32rpx; font-weight: bold; }
.estimate-box .row.balance { font-size: 22rpx; justify-content: flex-end; margin-bottom: 0; }

/* 微型警告行 */
.mini-warning {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #e64340;
  line-height: 1.4;
}
.mini-warning text { margin-left: 8rpx; flex: 1; }

/* 底部结算栏 */
.bottom-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #ffffff;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  z-index: 99;
}
.price-info .label { font-size: 22rpx; color: #666; display: block; margin-bottom: 4rpx; }
.submit-btn {
  margin: 0;
  width: 380rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #2E3529;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}
.submit-btn[disabled] { background: #e2e8f0 !important; color: #94a3b8 !important; }

/* 时间选择器清除按钮 */
.clear-btn {
  font-size: 24rpx;
  color: #e64340; /* 红色警告色 */
  padding: 4rpx 16rpx;
  background-color: rgba(230, 67, 64, 0.1);
  border-radius: 20rpx;
  margin-left: auto; /* 推到最右边 */
  z-index: 10;
}

/* 确保第一页的 picker-value 内容两端对齐 */
.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}