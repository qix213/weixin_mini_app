<view class="mall-container">
  <view class="dynamic-bg"></view>

  <view class="search-header">
    <view class="search-box">
      <van-icon name="search" color="#0ea5e9" size="36rpx" />
      <input 
        class="search-input"
        value="{{searchValue}}"
        placeholder="搜索商品或关键词"
        placeholder-class="search-placeholder"
        bindinput="onSearchChange"  
        bindconfirm="onSearch"     
      />
      <view class="search-action-btn" bindtap="onSearch">搜索</view>
    </view>
  </view>

  <van-grid column-num="4" border="{{false}}" class="category-grid" wx:if="{{categories.length > 0}}">
    <van-grid-item 
      wx:for="{{categories}}" 
      wx:key="id"
      icon="{{item.icon || 'apps-o'}}" 
      text="{{item.name}}"
      bind:click="chooseCategory"
      data-id="{{item.id}}"
      class="{{selectedCategoryId == item.id ? 'active' : ''}}"
    />
  </van-grid>

  <view class="goods-list-wrap">
    
    <view class="skeleton-wrap" wx:if="{{loading}}">
      <van-skeleton title row="3" class="skeleton-item" />
      <van-skeleton title row="3" class="skeleton-item" />
    </view>
    
    <view class="goods-grid" wx:else>
      <view class="goods-card" wx:for="{{goodsList}}" wx:key="id" bindtap="toGoodsDetail" data-id="{{item.id}}">
        
        <view class="img-wrap">
          <image class="goods-img" src="{{item.image_url}}" mode="aspectFill" lazy-load="true"></image>
        </view>

        <view class="goods-info">
          <text class="goods-name">{{item.name}}</text>
          <text class="goods-desc" wx:if="{{item.brief_intro}}">{{item.brief_intro}}</text>
          
          <view class="price-row">
            <block wx:if="{{item.isPointGoods}}">
              <view class="point-badge">
                <text class="price-val">{{item.pointPrice}}</text>
                <text class="price-unit">积分</text>
              </view>
            </block>
            <block wx:else>
              <view class="price-badge">
                <text class="price-unit">¥</text>
                <text class="price-val">{{item.member_price}}</text>
                <text class="origin-price" wx:if="{{item.original_price}}">¥{{item.original_price}}</text>
              </view>
            </block>
          </view>
          
          <view class="action-footer">
            <text class="stock-text">库存 {{item.stock}}</text>
            
            <view class="action-controls">
              <view class="custom-stepper">
                <view class="step-btn {{item.cartNum <= 1 ? 'disabled' : ''}}" catchtap="minusNum" data-id="{{item.id}}">-</view>
                <input class="step-input" type="number" value="{{item.cartNum || 1}}" bindinput="changeNum" data-id="{{item.id}}" catchtap="noop" />
                <view class="step-btn" catchtap="plusNum" data-id="{{item.id}}">+</view>
              </view>
              
              <view class="add-cart-btn" catchtap="addToCart" data-id="{{item.id}}" data-name="{{item.name}}">
                <van-icon name="shopping-cart-o" size="32rpx" />
              </view>
            </view>
          </view>
        </view>

      </view>
    </view>

    <view class="empty-state" wx:if="{{!loading && goodsList.length === 0}}">
      <image class="empty-img" src="https://img.yzcdn.cn/vant/empty-image-default.png" mode="aspectFit"></image>
      <text class="empty-text">暂时没有找到相关商品哦</text>
    </view>

  </view>

  <van-toast id="van-toast" />
</view>