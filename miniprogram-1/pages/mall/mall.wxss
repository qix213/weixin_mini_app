page {
  background-color: #FAF8F5; /* 奶油可可白底色 */
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.mall-container {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* ================= 搜索栏 (加入轻微毛玻璃效果) ================= */
.search-header {
  background-color: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 20rpx 30rpx;
  border-bottom: 1px solid rgba(148, 164, 140, 0.08); /* 边框融入品牌绿 */
  z-index: 10;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #F4F6F2; /* 替换冷灰，改为品牌色的极浅背景 */
  height: 72rpx;
  border-radius: 36rpx; 
  padding: 0 30rpx;
  border: 1px solid rgba(148, 164, 140, 0.05); 
}

.search-input {
  flex: 1;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #2C3327; /* 深墨绿代替纯黑 */
}

.search-placeholder {
  color: #8A8E88; /* 柔和的灰绿 */
  font-weight: 400;
}

/* ================= 主内容区：左右分栏 ================= */
.main-content {
  display: flex;
  flex: 1;
  overflow: hidden;
  background-color: transparent; /* 让 page 的奶油可可白透出来 */
}

/* ================= 左侧分类侧边栏 ================= */
.sidebar {
  width: 180rpx; 
  background-color: rgba(255, 255, 255, 0.5); 
  height: 100%;
  border-right: 1px solid rgba(148, 164, 140, 0.06);
}

.category-item {
  position: relative;
  height: 140rpx;
  margin: 16rpx; 
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  gap: 10rpx;
  
  /* 独立栏目边框 */
  border: 1px solid rgba(148, 164, 140, 0.05);
  border-radius: 16rpx;
  background-color: #F4F6F2; /* 统一浅绿灰背景 */
}

.category-name {
  font-size: 24rpx;
  color: #6B7067; /* 统一文字色 */
  font-weight: 400;
  transition: all 0.3s ease;
}

.category-icon { color: #8A8E88; transition: all 0.3s ease; }

/* 🌟 激活状态：主色调边框 + 纯白底色 + 微阴影 */
.category-item.active { 
  background-color: #FFFFFF; 
  border: 1px solid rgba(148, 164, 140, 0.4); 
  box-shadow: 0 6rpx 16rpx rgba(148, 164, 140, 0.08); 
}

.category-item.active .category-name { color: #2C3327; font-weight: 600; }
.category-item.active .category-icon { color: #94A48C; }

.active-indicator {
  display: none;
}

/* ================= 右侧商品列表区 ================= */
.goods-scroll {
  flex: 1;
  height: 100%;
  background-color: transparent; 
  padding: 24rpx 20rpx;
  box-sizing: border-box;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between; 
}

/* 🌟 商品卡片 */
.goods-card {
  width: calc(50% - 10rpx); 
  background-color: #FFFFFF;
  border-radius: 16rpx; 
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  
  /* 融入环境色的阴影与边框 */
  border: 1px solid rgba(148, 164, 140, 0.06);
  box-shadow: 0 8rpx 24rpx rgba(148, 164, 140, 0.04);
}

.img-wrap {
  width: 100%;
  position: relative;
  padding-top: 100%; 
  background-color: #F8F9F7;
  border-bottom: 1px solid rgba(148, 164, 140, 0.04);
}

.goods-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 主色调角标 (继承首页科技感渐变) */
.point-badge-corner {
  position: absolute;
  top: 0;
  left: 0;
  background: linear-gradient(135deg, #94A48C 0%, #7A8B72 100%);
  color: #FFFFFF;
  font-size: 18rpx;
  padding: 6rpx 14rpx;
  border-radius: 0 0 16rpx 0;
  font-weight: 500;
  letter-spacing: 1rpx;
  box-shadow: 2rpx 2rpx 8rpx rgba(148, 164, 140, 0.3);
}

/* ================= 商品信息与排版 ================= */
.goods-info {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.goods-name {
  font-size: 26rpx;
  color: #2C3327; /* 深墨绿 */
  font-weight: 500;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  height: 72rpx; 
}

/* --- 价格美学 --- */
.price-container {
  margin-top: 12rpx;
  margin-bottom: auto; 
  display: flex;
  flex-direction: column;
  gap: 6rpx; 
}

.price-row {
  display: flex;
  align-items: baseline; 
}

.price-label {
  font-size: 20rpx;
  margin-right: 4rpx;
}

.price-val {
  font-family: 'DIN Alternate', -apple-system, BlinkMacSystemFont, sans-serif;
}

/* 主价格高亮 */
.main-price-row .price-label {
  color: #94A48C; 
  font-weight: 500;
}
.main-price-row .price-val {
  color: #94A48C; /* 深色数字更大气 */
  font-size: 24rpx; 
  font-weight: 400;
  letter-spacing: -0.5rpx;
}

/* 副价格置灰 */
.sub-price-row .price-label {
  color: #8A8E88;
  font-size: 18rpx;
}
.sub-price-row .price-val {
  color: #8A8E88;
  font-size: 22rpx;
  font-weight: 400;
}

.strikethrough {
  text-decoration: line-through;
}

/* 轻奢「探索详情」按钮 */
.explore-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F4F6F2; 
  border: 1px solid transparent; /* 去除生硬边框，用背景色区分 */
  color: #7A8F70; /* 略深于主色调，提高辨识度 */
  font-size: 20rpx;
  border-radius: 24rpx; 
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: all 0.2s ease;
}

.explore-btn:active {
  background-color: rgba(148, 164, 140, 0.15);
  transform: scale(0.96);
}

/* ================= 辅助样式 ================= */
.skeleton-wrap { padding: 10rpx 0; }
.sk-item { margin-bottom: 40rpx; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.empty-text { margin-top: 20rpx; font-size: 24rpx; color: #8A8E88; }
.bottom-spacer { height: 100rpx; }
::-webkit-scrollbar { display: none; }