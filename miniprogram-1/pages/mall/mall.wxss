/* ================= 全局变量与底色 ================= */
page {
  --primary-color: #0ea5e9;
  --primary-light: #e0f2fe;
  --text-main: #334155;
  --text-gray: #94a3b8;
  --danger-color: #f43f5e;
  background: #f0f9ff;
  min-height: 100vh;
}

.mall-container {
  position: relative;
  min-height: 100vh;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* 动态流光背景 */
.dynamic-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  background: linear-gradient(-45deg, #e0f2fe, #ffffff, #bae6fd, #f8fafc);
  background-size: 400% 400%;
  animation: gradientBG 15s ease infinite;
}

@keyframes gradientBG {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ================= 顶部悬浮搜索栏 ================= */
.search-header {
  /* 优化：上下边距从 16rpx 进一步收紧到 10rpx，左右保持 16rpx */
  padding: 10rpx 16rpx;
  position: sticky;
  top: 0;
  z-index: 99;
  background: linear-gradient(to bottom, rgba(240, 249, 255, 0.95) 30%, rgba(240, 249, 255, 0));
}

.search-box {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 2rpx solid rgba(255, 255, 255, 1);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 10rpx 0 24rpx;
  height: 76rpx;
  box-shadow: 0 8rpx 24rpx rgba(14, 165, 233, 0.08);
}

.search-input {
  flex: 1;
  color: #1e293b;
  font-size: 26rpx;
  margin-left: 12rpx;
}

.search-placeholder {
  color: #94a3b8;
}

.search-action-btn {
  background: linear-gradient(135deg, #7dd3fc, #0ea5e9);
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  padding: 10rpx 32rpx;
  border-radius: 30rpx;
  margin-left: 10rpx;
  box-shadow: 0 4rpx 15rpx rgba(14, 165, 233, 0.2);
}

/* ================= 分类宫格 (独立卡片防误触版) ================= */
.category-grid {
  margin: 10rpx 16rpx 0;
  width: calc(100% - 32rpx); 
  box-sizing: border-box;
  overflow-x: auto;
  overflow-y: hidden;
  white-space: nowrap; 
  -webkit-overflow-scrolling: touch; 
  /* 🌟 核心修改：取消外层大盒子的统一背景，让背景透明化 */
  background: transparent;
}

/* 隐藏滚动条 */
.category-grid::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

/* 内部 flex 容器 */
.category-grid .van-grid {
  display: flex !important;
  flex-wrap: nowrap !important;
  padding-right: 24rpx !important;
  /* 🌟 核心修改：利用 gap 属性强行在分类之间拉开物理间距 */
  gap: 16rpx; 
}

/* 单个分类外层容器 */
.category-grid .van-grid-item {
  flex: 0 0 auto !important; 
  width: 140rpx !important; /* 稍微收紧一点宽度，配合间距 */
}

/* 🌟 核心修改：给每个独立的分类加上自己的毛玻璃背景和边框 */
.category-grid .van-grid-item__content {
  background: rgba(255, 255, 255, 0.65) !important;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  /* 加上清晰的独立边框 */
  border: 2rpx solid rgba(148, 163, 184, 0.3) !important; 
  border-radius: 20rpx !important;
  padding: 20rpx 10rpx !important;
  box-shadow: 0 4rpx 12rpx rgba(14, 165, 233, 0.05);
  transition: all 0.2s ease;
}

/* 🌟 激活状态：选中时边框和背景高亮，视觉反馈更强 */
.category-grid .van-grid-item.active .van-grid-item__content {
  border: 2rpx solid var(--primary-color) !important;
  background: rgba(224, 242, 254, 0.8) !important; /* 浅蓝色背景强调 */
}

.category-grid .van-grid-item.active .van-grid-item__text {
  color: var(--primary-color) !important;
  font-weight: 800;
}

.category-grid .van-grid-item.active .van-grid-item__icon {
  color: var(--primary-color) !important;
  transform: scale(1.1);
}
/* ================= 商品列表区域 ================= */
.goods-list-wrap {
  padding: 16rpx 16rpx 24rpx;
}

/* 骨架屏 */
.skeleton-wrap {
  display: flex;
  justify-content: space-between;
}
.skeleton-item {
  /* 优化：骨架屏宽度同步调整 */
  width: 48.8%;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  padding: 20rpx 0;
}

/* 双列网格布局 */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

/* ======== 高级毛玻璃商品卡片 ======== */
.goods-card {
  /* 优化：宽度增加到 48.8%，让中间缝隙变窄 */
  width: 48.8%;
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 2rpx solid rgba(255, 255, 255, 1);
  /* 优化：圆角收缩到20rpx */
  border-radius: 20rpx;
  overflow: hidden;
  /* 优化：底部间距收紧到16rpx */
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(14, 165, 233, 0.06);
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.goods-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 15rpx rgba(14, 165, 233, 0.05);
}

.img-wrap {
  width: 100%;
  height: 345rpx;
  background-color: rgba(255, 255, 255, 0.5);
  overflow: hidden;
}

.goods-img {
  width: 100%;
  height: 100%;
}

/* 卡片信息区 */
.goods-info {
  /* 优化：内部文本边距收紧，更显精致 */
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.goods-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 800;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.goods-desc {
  font-size: 22rpx;
  color: var(--text-gray);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 16rpx;
}

/* 价格与积分展示 */
.price-row {
  margin-bottom: 16rpx;
  display: flex;
  align-items: baseline;
}

/* 科技感积分标签 */
.point-badge {
  background: linear-gradient(135deg, #e0f2fe, #bae6fd);
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  display: inline-flex;
  align-items: baseline;
  border: 1rpx solid rgba(56, 189, 248, 0.4);
}

.point-badge .price-val {
  color: #0284c7;
  font-size: 30rpx;
  font-weight: 900;
  font-family: 'DIN Alternate', sans-serif;
  margin-right: 6rpx;
}

.point-badge .price-unit {
  color: #0284c7;
  font-size: 20rpx;
  font-weight: 800;
}

/* 价格展示 */
.price-badge .price-unit {
  color: var(--primary-color);
  font-size: 22rpx;
  font-weight: bold;
}

.price-badge .price-val {
  color: var(--primary-color);
  font-size: 34rpx;
  font-weight: 900;
  font-family: 'DIN Alternate', sans-serif;
}

.origin-price {
  color: var(--text-gray);
  font-size: 20rpx;
  text-decoration: line-through;
  margin-left: 10rpx;
  font-weight: 500;
}

/* 底部操作栏 */
.action-footer {
  margin-top: auto;
}

.stock-text {
  font-size: 22rpx;
  color: var(--text-gray);
  margin-bottom: 12rpx;
  display: block;
}

.action-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 透气感步进器 */
.custom-stepper {
  display: flex;
  align-items: center;
  background: rgba(241, 245, 249, 0.8);
  border-radius: 10rpx;
  overflow: hidden;
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.step-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #475569;
  font-weight: bold;
}

.step-btn.disabled {
  color: #cbd5e1;
}

.step-input {
  width: 48rpx;
  height: 44rpx;
  min-height: 44rpx;
  text-align: center;
  font-size: 24rpx;
  background: transparent;
  color: #1e293b;
  font-weight: bold;
}

/* 购物车流光按钮 */
.add-cart-btn {
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #7dd3fc, #0ea5e9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  box-shadow: 0 6rpx 15rpx rgba(14, 165, 233, 0.3);
  transition: transform 0.2s;
}

.add-cart-btn:active {
  transform: scale(0.9);
}

/* ================= 空白页 ================= */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
.empty-img {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 20rpx;
  opacity: 0.8;
}
.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
  font-weight: bold;
}