:root {
  --primary-color: #1E88E5;
  --primary-light: #E3F2FD;
  --text-dark: #333;
  --text-gray: #666;
}

.mall-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 分类样式 */
.category-grid {
  background: #fff;
  padding: 10rpx 0;
  margin-bottom: 10rpx;
}
.category-grid .van-grid-item.active {
  color: var(--primary-color);
}
.category-grid .van-grid-item__icon {
  font-size: 40rpx !important;
}

/* 商品列表布局：微调卡片宽度，减少间距 */
.goods-list {
  padding: 10rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8rpx;
}
.goods-card-wrap {
  width: 49%;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}
.skeleton-item {
  width: 49%;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

/* 商品卡片：核心调整内部布局 */
.goods-card {
  width: 100%;
  height: 100%;
  background: #fff;
  min-height: 800rpx;
}
.goods-card .van-card__thumb {
  width: 120rpx !important;
  height: 120rpx !important;
  flex-shrink: 0;
}
.goods-card .van-card__content {
  flex: 1;
  padding-left: 12rpx !important;
  min-width: 0;
}
/* 标题：禁止换行 */
.goods-card .van-card__title {
  font-size: 28rpx !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  max-width: 100% !important;
}
/* 描述：优化换行规则 */
.goods-card .van-card__desc {
  font-size: 24rpx !important;
  color: var(--text-gray) !important;
  word-break: keep-all !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  max-width: 100% !important;
}

/* 核心：强制隐藏积分商品的默认价格 */
.point-goods-card .van-card__price,
.point-goods-card .van-card__origin-price {
  display: none !important;
}

/* 🔥 新增：积分价格禁止换行（核心修复） */
.goods-card [slot="tags"] {
  white-space: nowrap !important; /* 容器禁止换行 */
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  min-width: 120rpx !important; /* 保证最小宽度，避免挤压 */
}
.goods-card [slot="tags"] text {
  white-space: nowrap !important; /* 文字禁止换行 */
}

/* 数量控制 */
.num-control {
  display: flex;
  align-items: center;
  margin-right: 10rpx;
}
.num-control button {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
  font-size: 28rpx;
  border: 1rpx solid #eee;
  background: #fff;
}
.num-control input {
  width: 80rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border: 1rpx solid #eee;
  margin: 0 5rpx;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 搜索框 */
.search-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
}