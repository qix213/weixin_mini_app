/* ================== 基础设置 ================== */
.video-play-page {
  min-height: 100vh;
  background-color: #FAF8F5; /* 奶油可可白底色 */
  position: relative;
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, sans-serif;
}

.content-wrapper {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* ================== 视频区域 ================== */
.video-container {
  width: 100%;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  background-color: #F8F9F5;
  box-shadow: 0 12rpx 32rpx rgba(148, 164, 140, 0.12); /* 柔和的高级弥散阴影 */
  border: 1px solid rgba(148, 164, 140, 0.08);
}

.video-player {
  width: 100%;
  height: 450rpx;
  display: block;
}

/* 居中自定义播放按钮 */
.custom-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  background: rgba(44, 51, 39, 0.4); /* 深绿色调低透明度，比纯黑更高级 */
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  transition: all 0.3s ease;
}

.custom-play-btn:active {
  transform: translate(-50%, -50%) scale(0.9);
}

.play-svg {
  width: 50rpx;
  height: 50rpx;
  filter: invert(100%); /* 纯白图标 */
}

/* ================== 白卡浮雕信息卡片 ================== */
.glass-card {
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(148, 164, 140, 0.06);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.video-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C3327; /* 深森林绿主文本 */
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.video-meta {
  display: flex;
  gap: 40rpx;
  font-size: 24rpx;
  color: #8A8E88; /* 莫兰迪灰 */
}

.meta-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.icon {
  font-size: 22rpx;
  color: #94A48C;
}

/* ================== 按钮组 ================== */
.func-btns {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 20rpx;
}

.func-btn {
  width: 100% !important;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: all 0.3s;
}

.func-btn::after {
  border: none;
}

/* 莫兰迪绿主按钮 */
.primary-btn {
  background: linear-gradient(135deg, #94A48C 0%, #7A8B72 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(148, 164, 140, 0.25);
}

.primary-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(148, 164, 140, 0.15);
}

/* 浅色辅助按钮 */
.secondary-btn {
  background: rgba(148, 164, 140, 0.08);
  color: #7A8B72;
  border: 1px solid rgba(148, 164, 140, 0.15);
}

.secondary-btn:active {
  background: rgba(148, 164, 140, 0.15);
}

/* 幽灵返回按钮 */
.ghost-btn {
  background: transparent;
  color: #A0A49D;
  font-size: 28rpx;
  font-weight: 500;
}