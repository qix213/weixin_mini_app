/* ================== 基础设置 ================== */
.content-detail-page {
  min-height: 100vh;
  background-color: #FAF8F5;
  position: relative;
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, sans-serif;
}

.content-wrapper {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* ================== 媒体区域 (兼容图片与视频) ================== */
.media-container {
  width: 100%;
  height: 450rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  background-color: #F8F9F5;
  box-shadow: 0 12rpx 32rpx rgba(148, 164, 140, 0.12);
  border: 1px solid rgba(148, 164, 140, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.media-player, .media-cover {
  width: 100%;
  height: 100%;
  display: block;
}

/* 伪装图文模式时的遮罩提示 */
.media-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: linear-gradient(to top, rgba(44, 51, 39, 0.6), transparent);
  padding: 30rpx 20rpx 20rpx;
  box-sizing: border-box;
}
.media-tip {
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
}

/* 居中自定义播放按钮 */
.custom-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  background: rgba(44, 51, 39, 0.4);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  transition: all 0.3s ease;
}

.custom-play-btn:active {
  transform: translate(-50%, -50%) scale(0.9);
}

.play-svg {
  width: 50rpx;
  height: 50rpx;
  filter: invert(100%);
}

/* ================== 白卡浮雕信息卡片 ================== */
.glass-card {
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(148, 164, 140, 0.06);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.content-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C3327;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.content-meta {
  display: flex;
  gap: 40rpx;
  font-size: 24rpx;
  color: #8A8E88;
}

.meta-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.icon {
  font-size: 22rpx;
  color: #94A48C;
}

/* ================== 按钮组 ================== */
.func-btns {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 20rpx;
}

.func-btn {
  width: 100% !important;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: all 0.3s;
}

.func-btn::after {
  border: none;
}

.primary-btn {
  background: linear-gradient(135deg, #94A48C 0%, #7A8B72 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(148, 164, 140, 0.25);
}

.primary-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(148, 164, 140, 0.15);
}

.secondary-btn {
  background: rgba(148, 164, 140, 0.08);
  color: #7A8B72;
  border: 1px solid rgba(148, 164, 140, 0.15);
}

.secondary-btn:active {
  background: rgba(148, 164, 140, 0.15);
}

.ghost-btn {
  background: transparent;
  color: #A0A49D;
  font-size: 28rpx;
  font-weight: 500;
}