.video-play-page {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 视频播放器 */
.video-player {
  width: 100%;
  height: 400rpx;
  border-radius: 10rpx;
}

/* 视频信息 */
.video-info {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 10rpx;
}

.video-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.video-meta {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.meta-item {
  margin-right: 20rpx;
}

/* 会员等级信息 */
.level-info {
  font-size: 28rpx;
  color: #333;
}

.level-item {
  display: block;
  margin-bottom: 5rpx;
}

.user-level {
  color: #07c160;
  font-weight: bold;
}

.required-level {
  color: #ff4757;
  font-weight: bold;
}

/* 功能按钮 */
.func-btns {
  margin-top: 20rpx;
  display: flex;
  gap: 20rpx;
}

.func-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 10rpx;
}

.cancel-btn {
  background: #999;
}

/* 无权限样式 */
.no-permission {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 20rpx;
}

.forbidden-img {
  width: 200rpx;
  margin-bottom: 30rpx;
}

.forbidden-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4757;
  margin-bottom: 10rpx;
}

.forbidden-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.back-btn {
  width: 60%;
  height: 80rpx;
  line-height: 80rpx;
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 10rpx;
}