/* 页面基底：使用你的奶油可可白 */
page {
  background-color: #FAF8F5; 
  min-height: 100vh;
}

/* 外部容器：宽度 100vw 绝对贴边 */
.privilege-container {
  width: 100vw;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom); 
  position: relative; /* 配合骨架屏 */
}

/* 🌟 新增：骨架屏流光背景 */
.skeleton-bg {
  background-color: #F0F2ED; /* 淡淡的莫兰迪灰绿底色 */
  overflow: hidden;
}
.skeleton-bg::after {
  content: "";
  position: absolute;
  top: 0; 
  left: 0; 
  width: 100%; 
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.7), transparent);
  animation: shimmer 1.5s infinite ease-in-out;
  z-index: 1;
}
@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* 🌟 核心：长图样式与渐显动效 */
.privilege-img {
  width: 100%;       
  height: auto;      
  display: block;    
  /* 开启 GPU 硬件加速，同时优化 opacity 和 transform */
  will-change: transform, opacity; 
  
  /* 🌟 初始状态：完全透明，等待加载完成 */
  opacity: 0;
  transition: opacity 0.8s ease-in-out; /* 0.8秒柔和渐显 */
  
  position: relative;
  z-index: 2; /* 确保加载出来后盖在骨架屏上面 */
}

/* 🌟 结合 JS 触发展示 */
.privilege-img.show {
  opacity: 1;
}