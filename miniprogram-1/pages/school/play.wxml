<view class="video-play-page">
  <view wx:if="{{hasPermission}}">
    <view class="video-container" style="position: relative; width: 100%; height: 300px;">
      <video 
        id="myVideo"
        src="{{videoUrl}}"
        controls
        playsinline
        show-play-btn
        show-center-play-btn
        show-fullscreen-btn
        enable-progress-gesture
        bindplay="onPlay"
        bindpause="onPause"
        bindtimeupdate="onTimeUpdate"
        bindended="onEnded"
        bindseeked="onSeeked"
        bindfullscreenchange="onFullScreenChange"
        binderror="onVideoError"
        bindloadeddata="onLoadedData"
        class="video-player"
        style="width: 100%; height: 100%; background-color: #000;"
        autoplay="{{false}}"
        initial-time="0"
      ></video>
      <view 
        class="custom-play-btn" 
        bindtap="togglePlay"
        wx:if="{{!isPlaying && videoLoaded}}"
      >
        <image 
          src="https://cdn.jsdelivr.net/gh/feathericons/feather/icons/play-circle.svg" 
          style="width: 60px; height: 60px; tint-color: #ffffff;"
        ></image>
      </view>
    </view>
    <view class="video-info">
      <view class="video-title">{{videoTitle || '未知视频'}}</view>
      <view class="video-meta">
        <text class="meta-item">时长：{{duration || '00:00'}}</text>
        <text class="meta-item">播放：{{playCount || 0}} 次</text>
      </view>
      <view class="level-info">
        <text class="level-item">当前等级：<text class="user-level">{{userLevelName}}</text></text>
        <text class="level-item">要求等级：<text class="required-level">{{requiredLevelName}}</text></text>
      </view>
    </view>
    <view class="func-btns">
      <button bindtap="toCheckIn" class="func-btn">学习打卡</button>
      <button bindtap="toExam" class="func-btn">考核通关</button>
      <button bindtap="goBack" class="func-btn cancel-btn">返回列表</button>
    </view>
  </view>
  <view wx:else class="no-permission">
    <view class="forbidden-text">您暂无权限观看该视频</view>
    <view class="forbidden-desc">需要升级到{{requiredLevelName || '未知等级'}}及以上会员等级</view>
    <button bindtap="goBack" class="back-btn">返回课程列表</button>
  </view>
</view>