<view class="video-play">
  <!-- 原生视频播放组件，确保src正确赋值 -->
  <video
    src="{{videoUrl}}"
    poster="{{coverUrl}}"
    controls="{{true}}"                
    enableFullscreenGesture="{{true}}" 
    show-fullscreen-btn="{{true}}"     
    show-play-btn="{{true}}"
    show-center-play-btn="{{true}}"
    direction="{{90}}"               
    object-fit="contain"              
    autoplay="{{false}}"
    vslide-gesture="{{true}}"          
    vslide-gesture-in-fullscreen="{{true}}"
    class="video-player"
  progress-interval="{{1000}}"  
  bindtimeupdate="onTimeUpdate" 
  bindseeked="onSeeked"  
    bindfullscreenchange="onFullScreenChange"
></video>

  <!-- 课程信息 -->
  <view class="video-info">
    <view class="title">{{videoTitle}}</view>
    <view class="desc">{{categoryName}} | 时长：{{duration}}</view>
    <view class="play-count">播放量：{{playCount}} 次</view>
  </view>

  <!-- 操作按钮 -->
  <view class="oper-btn-group">
    <button bindtap="toCheckIn" class="oper-btn primary-btn">立即打卡</button>
    <button bindtap="toExam" class="oper-btn warning-btn">参与考核</button>
  </view>
</view>