page {
  background-color: #020617;
  color: #e2e8f0;
}

.exam-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 选择科目 */
.header-title {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
  margin: 40rpx 0;
  color: #38bdf8;
  text-shadow: 0 0 10rpx rgba(56, 189, 248, 0.4);
}

.course-list {
  padding: 0 30rpx;
}

.course-card {
  background: rgba(30, 41, 59, 0.8);
  border: 1px solid rgba(56, 189, 248, 0.2);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  transition: all 0.3s;
}

.card-icon {
  font-size: 60rpx;
  margin-right: 30rpx;
}

.card-info {
  flex: 1;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #94a3b8;
}

.card-arrow {
  font-size: 28rpx;
  color: #38bdf8;
  font-weight: bold;
}

/* 答题区域 */
.exam-header {
  padding: 30rpx;
  background: rgba(15, 23, 42, 0.9);
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid rgba(56, 189, 248, 0.2);
}

.exam-title {
  font-size: 32rpx;
  color: #38bdf8;
  font-weight: bold;
}

.exam-progress {
  font-size: 28rpx;
  color: #94a3b8;
}

.question-scroll, .analysis-scroll {
  flex: 1;
  height: calc(100vh - 120rpx);
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.question-item, .analysis-item {
  background: rgba(30, 41, 59, 0.6);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.q-title {
  font-size: 32rpx;
  line-height: 1.6;
  margin-bottom: 30rpx;
  color: #f8fafc;
}

.q-type-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  vertical-align: middle;
}
.q-type-tag.single { background: rgba(56, 189, 248, 0.2); color: #38bdf8; border: 1px solid #38bdf8; }
.q-type-tag.multi { background: rgba(167, 139, 250, 0.2); color: #a78bfa; border: 1px solid #a78bfa; }
.q-type-tag.tf { background: rgba(52, 211, 153, 0.2); color: #34d399; border: 1px solid #34d399; }
.q-type-tag.fail { background: rgba(248, 113, 113, 0.2); color: #f87171; border: 1px solid #f87171; }

.options-group {
  display: flex;
  flex-direction: column;
}

.option-label {
  padding: 24rpx;
  background: rgba(15, 23, 42, 0.5);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  border: 1px solid transparent;
  transition: all 0.2s;
}

.option-label.selected {
  background: rgba(56, 189, 248, 0.1);
  border-color: rgba(56, 189, 248, 0.5);
}

.opt-text {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #cbd5e1;
  line-height: 1.5;
  flex: 1;
}

.submit-btn-wrap {
  padding: 40rpx 0 80rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  color: white;
  border-radius: 50rpx;
  font-weight: bold;
  font-size: 34rpx;
  box-shadow: 0 10rpx 20rpx rgba(14, 165, 233, 0.3);
}

.back-btn {
  background: transparent;
  border: 1px solid #38bdf8;
  color: #38bdf8;
  box-shadow: none;
}

/* 成绩与解析 */
.result-header {
  text-align: center;
  padding: 60rpx 0;
  margin: 30rpx;
  border-radius: 20rpx;
}
.result-header.pass {
  background: linear-gradient(135deg, rgba(52, 211, 153, 0.2), rgba(16, 185, 129, 0.4));
  border: 1px solid #34d399;
}
.result-header.fail {
  background: linear-gradient(135deg, rgba(248, 113, 113, 0.2), rgba(239, 68, 68, 0.4));
  border: 1px solid #f87171;
}

.score-num {
  font-size: 100rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 4rpx 10rpx rgba(0,0,0,0.5);
}

.score-status {
  font-size: 32rpx;
  color: #fff;
  margin-top: 20rpx;
}

.analysis-title {
  font-size: 36rpx;
  font-weight: bold;
  padding: 0 30rpx;
  color: #a78bfa;
}

.ans-compare {
  background: rgba(0,0,0,0.3);
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.text-green { color: #34d399; }
.text-red { color: #f87171; }

.explanation-box {
  background: rgba(56, 189, 248, 0.1);
  border-left: 6rpx solid #38bdf8;
  padding: 20rpx;
  border-radius: 0 12rpx 12rpx 0;
}

.exp-title {
  font-size: 28rpx;
  color: #38bdf8;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.exp-content {
  font-size: 26rpx;
  color: #cbd5e1;
  line-height: 1.6;
}