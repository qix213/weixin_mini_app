/* ================= 全局配置 ================= */
page {
  background-color: #FAF8F5; /* 奶油可可白 */
  color: #2C3327;            /* 深邃灰绿文字 */
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.exam-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ================= 1. 选择科目区域 ================= */
.start-exam-wrapper {
  padding: 40rpx 0;
}

/* 迎宾头部（脱离原先拥挤的卡片） */
.exam-ready-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.exam-badge-wrap {
  width: 130rpx;
  height: 130rpx;
  background: linear-gradient(135deg, rgba(148, 164, 140, 0.2) 0%, rgba(148, 164, 140, 0.05) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  box-shadow: 0 16rpx 32rpx rgba(148, 164, 140, 0.1);
}

.exam-badge-icon {
  font-size: 64rpx;
  color: #94A48C;
}

.exam-ready-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2C3327;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.exam-ready-subtitle {
  font-size: 24rpx;
  color: #94A48C;
  font-family: 'DIN Alternate', sans-serif;
  letter-spacing: 1rpx;
}

/* 课程列表 */
.course-list {
  padding: 0 30rpx;
}

.list-title {
  font-size: 28rpx;
  color: #8A8E88;
  margin-bottom: 24rpx;
  padding-left: 10rpx;
}

.course-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 30rpx rgba(148, 164, 140, 0.04);
  transition: all 0.2s ease;
}

.course-card:active {
  transform: scale(0.97);
  background: #F8F9F5;
}

.card-left {
  display: flex;
  align-items: center;
}

.card-icon-box {
  width: 80rpx;
  height: 80rpx;
  background: #F4F6F2;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.card-icon {
  font-size: 44rpx;
  color: #94A48C;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3327;
  margin-bottom: 10rpx;
}

.card-desc {
  font-size: 22rpx;
  color: #8A8E88;
}

.card-arrow {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #94A48C;
  font-weight: 500;
}

/* ================= 2. 答题区域 ================= */
.testing-box {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.exam-header {
  padding: 30rpx 40rpx 40rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(148, 164, 140, 0.05);
  z-index: 10;
}

.exam-header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.exam-title {
  font-size: 32rpx;
  color: #2C3327;
  font-weight: bold;
}

.exam-progress-text {
  font-size: 24rpx;
  color: #8A8E88;
}

.current-num {
  color: #94A48C;
  font-size: 30rpx;
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
}

/* 顶部细细的渐变进度条 */
.progress-bar {
  height: 6rpx;
  background: #F0F2ED;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #94A48C 0%, #7A8B72 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.question-scroll, .analysis-scroll {
  flex: 1;
  height: 0; /* 配合 flex:1 实现完美滚动 */
  padding: 30rpx;
  box-sizing: border-box;
}

.question-item {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(148, 164, 140, 0.04);
}

.q-title {
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.q-type-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  vertical-align: 4rpx;
  font-weight: 500;
}
.q-type-tag.single { background: rgba(148, 164, 140, 0.12); color: #7A8B72; }
.q-type-tag.multi { background: rgba(175, 161, 143, 0.15); color: #AFA18F; }
.q-type-tag.tf { background: rgba(122, 139, 114, 0.12); color: #607058; }

.q-title-text {
  font-size: 32rpx;
  color: #2C3327;
  font-weight: 600;
}

.q-score {
  font-size: 24rpx;
  color: #A3A7A0;
  margin-left: 8rpx;
  font-weight: normal;
}

/* ================= 选项重构 (纯 CSS 高级感) ================= */
.hidden-input {
  display: none; /* 彻底隐藏原生单选圈圈 */
}

.options-group {
  display: flex;
  flex-direction: column;
}

.option-label {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  background: #F8F9F5;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  transition: all 0.25s ease;
}

/* 未选中态 */
.opt-prefix {
  width: 44rpx;
  height: 44rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #94A48C;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.02);
  transition: all 0.25s ease;
}

.opt-text {
  flex: 1;
  font-size: 28rpx;
  color: #4A4F48;
  line-height: 1.5;
  transition: all 0.25s ease;
}

/* 选中态（单选/判断） */
.option-label.selected {
  background: #94A48C;
  border-color: #94A48C;
  box-shadow: 0 8rpx 20rpx rgba(148, 164, 140, 0.3);
}
.option-label.selected .opt-prefix {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  box-shadow: none;
}
.option-label.selected .opt-text {
  color: #FFFFFF;
  font-weight: 500;
}

/* 多选题微调（保留原生 checkbox 的视觉，但美化外框） */
.multi-label {
  padding: 24rpx 30rpx;
}
.custom-checkbox {
  margin-right: 16rpx;
  transform: scale(0.85); /* 稍微缩小一点，更精致 */
}

/* ================= 通用大按钮 ================= */
.submit-btn-wrap {
  padding: 20rpx 0 60rpx;
}

.submit-btn {
  width: 100% !important;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #94A48C 0%, #7A8B72 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  letter-spacing: 4rpx;
  box-shadow: 0 12rpx 24rpx rgba(148, 164, 140, 0.25);
  border: none;
}

.submit-btn:active {
  transform: scale(0.97);
  box-shadow: 0 6rpx 12rpx rgba(148, 164, 140, 0.15);
}

.back-btn {
  background: transparent;
  border: 2rpx solid #94A48C;
  color: #94A48C;
  box-shadow: none;
  line-height: 92rpx; /* 减去 border 高度 */
}
.back-btn:active {
  background: rgba(148, 164, 140, 0.05);
}

/* ================= 3. 成绩与解析 ================= */
.result-card-wrap {
  padding: 30rpx;
}

.result-header-card {
  padding: 60rpx 40rpx;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.05);
}

/* 渐变成绩卡：及格 / 不及格 */
.result-header-card.pass {
  background: linear-gradient(135deg, #A8B79F 0%, #87997C 100%);
  color: #FFFFFF;
}
.result-header-card.fail {
  background: linear-gradient(135deg, #E2BDB9 0%, #C98A84 100%);
  color: #FFFFFF;
}

.score-ring {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 24rpx;
}

.score-num {
  font-size: 140rpx;
  font-weight: 800;
  font-family: 'DIN Alternate', sans-serif;
  line-height: 1;
}

.score-unit {
  font-size: 36rpx;
  margin-left: 10rpx;
  font-weight: 500;
}

.score-status {
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}

.score-desc {
  font-size: 24rpx;
  margin-top: 16rpx;
  opacity: 0.8;
}

.analysis-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C3327;
  padding: 20rpx 30rpx;
}

.analysis-item {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(148, 164, 140, 0.04);
}

.q-type-tag.fail { background: rgba(212, 163, 157, 0.15); color: #C98A84; }

/* 答案对比框 */
.ans-compare {
  background: #F8F9F5;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.ans-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}
.ans-row:last-child { margin-bottom: 0; }

.ans-label {
  color: #8A8E88;
  width: 140rpx;
}

.ans-val {
  flex: 1;
  font-weight: 600;
}
.text-green { color: #7A8B72; }
.text-red { color: #C98A84; }

/* 专家解析框 */
.explanation-box {
  background: rgba(148, 164, 140, 0.05);
  border-radius: 16rpx;
  padding: 24rpx;
}

.exp-title {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #94A48C;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.exp-content {
  font-size: 26rpx;
  color: #4A4F48;
  line-height: 1.6;
}