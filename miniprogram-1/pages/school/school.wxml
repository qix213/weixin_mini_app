<view class="business-school">
  <view class="dynamic-bg"></view>

  <view class="search-header">
    <view class="search-box">
      <icon type="search" size="16" color="#0ea5e9" class="search-icon"></icon>
      <input type="text" placeholder="搜索课程/视频关键词" placeholder-class="search-placeholder" 
             value="{{searchValue}}" bindinput="onSearchChange" confirm-type="search" 
             bindconfirm="onSearch" class="search-input" />
      <text bindtap="clearSearch" wx:if="{{searchValue}}" class="clear-icon">×</text>
      <view bindtap="onSearch" class="search-action-btn">搜索</view>
    </view>
  </view>

  <view class="func-grid">
    <view class="func-card primary" bindtap="toCourseStudy">
      <text class="func-icon">📖</text>
      <text class="func-text">课程学习</text>
    </view>
    <view class="func-card primary" bindtap="toCheckInList">
      <text class="func-icon">📅</text>
      <text class="func-text">学习打卡</text>
    </view>
    <view class="func-card warning" bindtap="toExam">
      <text class="func-icon">🏆</text>
      <text class="func-text">考核通关</text>
    </view>
    <view class="func-card warning" bindtap="toCertification">
      <text class="func-icon">🎓</text>
      <text class="func-text">线下认证</text>
    </view>
  </view>

  <view class="category-wrap">
    <scroll-view scroll-x="true" class="category-scroll" show-scrollbar="false" enhanced="true">
      <view class="category-container">
        <view class="category-item {{activeTab === index ? 'active' : ''}}" 
              wx:for="{{categoryList}}" wx:key="index"
              bindtap="onTabChange" data-index="{{index}}">
          {{item}}
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="video-list">
    <view class="skeleton-item" wx:if="{{loading && videoList.length === 0}}" wx:for="3" wx:key="index">
      <view class="skeleton-thumb"></view>
      <view class="skeleton-info">
        <view class="skeleton-title"></view>
        <view class="skeleton-desc"></view>
        <view class="skeleton-footer"></view>
      </view>
    </view>

    <view class="video-card" wx:for="{{videoList}}" wx:key="id" bindtap="toVideoPlay" data-id="{{item.id}}">
      <view class="thumb-wrap">
        <image class="video-thumb" src="{{item.cover_url}}" mode="aspectFill" lazy-load="true"></image>
        <view class="play-overlay"><text class="play-icon">▶</text></view>
      </view>
      
      <view class="video-info">
        <view class="video-title">{{item.title}}</view>
        <view class="video-desc">时长：{{item.duration}}  |  播放：{{item.play_count}}</view>
        
        <view class="video-footer">
          <view class="level-badge">
            <text class="badge-icon">👑</text>
            <text class="badge-text">需 {{item.required_level_name}}</text>
          </view>
          <view bindtap="toVideoPlay" data-id="{{item.id}}" catchtap="true" class="study-btn">立即学习</view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!loading && videoList.length === 0}}">
      <image src="https://img.yzcdn.cn/vant/empty-image-default.png" class="empty-img" mode="aspectFit"></image>
      <text class="empty-text">暂无相关课程，休息一下吧</text>
    </view>

    <view class="load-more" wx:if="{{loading && videoList.length > 0}}">
      <text>系统正在加载中...</text>
    </view>
    <view class="no-more" wx:if="{{finished && videoList.length > 0}}">
      <text>- 已经到底啦 -</text>
    </view>
  </view>
</view>