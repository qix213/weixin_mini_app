/* 全局样式 */
page {
  background-color: #f5f5f5;
  font-size: 28rpx;
}
.business-school {
  min-height: 100vh;
}

/* 原生搜索栏样式 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: #1E88E5;
}
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: rgba(255,255,255,0.2);
  border-radius: 40rpx;
  padding: 0 20rpx;
  height: 70rpx;
}
.search-icon {
  margin-right: 10rpx;
}
.search-input {
  flex: 1;
  color: #fff;
  font-size: 28rpx;
}
.search-placeholder {
  color: rgba(255,255,255,0.8);
  font-size: 28rpx;
}
.clear-icon {
  color: #fff;
  font-size: 32rpx;
  margin-left: 10rpx;
}
.search-btn {
  background-color: #fff;
  color: #1E88E5;
  border: none;
  border-radius: 40rpx;
  padding: 0 20rpx;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 28rpx;
  margin-left: 10rpx;
}

/* 功能按钮组样式 */
.func-group {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  background: #fff;
  margin-bottom: 10rpx;
}
.func-btn {
  width: 48%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  margin-bottom: 10rpx;
  border: none;
}
.primary-btn {
  background-color: #1E88E5;
  color: #fff;
}
.warning-btn {
  background-color: #FF9800;
  color: #fff;
}

/* 分类标签样式 */
.category-wrap {
  background-color: #fff;
  margin-bottom: 10rpx;
}
.category-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}
.category-item {
  display: inline-block;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: #666;
}
.category-item.active {
  color: #1E88E5;
  font-weight: bold;
  border-bottom: 4rpx solid #1E88E5;
}

/* 视频列表样式 */
.video-list {
  padding: 0 10rpx;
}
/* 骨架屏样式 */
.skeleton-item {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}
.skeleton-thumb {
  width: 200rpx;
  height: 120rpx;
  background-color: #eee;
  border-radius: 8rpx;
  margin-right: 20rpx;
}
.skeleton-title {
  width: 300rpx;
  height: 40rpx;
  background-color: #eee;
  border-radius: 4rpx;
  margin-bottom: 10rpx;
}
.skeleton-desc {
  width: 200rpx;
  height: 30rpx;
  background-color: #eee;
  border-radius: 4rpx;
}
/* 视频卡片样式 */
.video-card {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}
.video-thumb {
  width: 200rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}
.video-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.video-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.video-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}
.video-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.play-count {
  font-size: 24rpx;
  color: #999;
}
.study-btn {
  background-color: #1E88E5;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 0 20rpx;
  height: 50rpx;
  line-height: 50rpx;
  font-size: 24rpx;
}

/* 空数据提示 */
.empty-tip {
  text-align: center;
  padding: 60rpx 0;
}
.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载更多/无更多样式 */
.load-more, .no-more {
  text-align: center;
  padding: 20rpx 0;
  font-size: 24rpx;
  color: #999;
}

/* 会员等级标签 */
.level-tag {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  padding: 5rpx 10rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
  color: #fff;
}
/* 有权限的标签样式 */
.level-allowed {
  background: #07c160;
}
/* 无权限的标签样式 */
.level-forbidden {
  background: #ff4757;
}
/* 视频信息中的等级提示 */
.required-level {
  font-size: 24rpx;
  color: #999;
  margin-right: 20rpx;
}
/* 自定义导航栏（修复右上角显示） */
.custom-nav {
  width: 100%;
  height: 45px;
  line-height: 45px;
  background-color: #1677ff;
  color: #fff;
  text-align: center;
  font-size: 17px;
  position: relative;
}
.nav-title {
  display: inline-block;
}
.nav-right {
  position: absolute;
  right: 15px;
  top: 0;
}

/* 原有样式保留 */
.business-school {
  padding: 10rpx;
  background: #f5f5f5;
}
/* 其他原有样式... */