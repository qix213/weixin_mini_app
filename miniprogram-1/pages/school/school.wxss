page {
  background-color: #FAF8F5; /* 奶油可可白 */
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.school-container {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* ================= 搜索栏 ================= */
.search-header {
  background-color: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 20rpx 30rpx;
  border-bottom: 1px solid rgba(148, 164, 140, 0.08);
  z-index: 10;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #F8F9F5; /* 稍微调浅，融入背景 */
  height: 72rpx;
  border-radius: 36rpx;
  padding: 0 30rpx;
  border: 1px solid rgba(148, 164, 140, 0.08);
  transition: all 0.3s;
}

.search-box:focus-within {
  background-color: #FFFFFF;
  border-color: rgba(148, 164, 140, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(148, 164, 140, 0.05);
}

.search-input {
  flex: 1;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #2C3327;
}

.search-placeholder { color: #A0A49D; }
.clear-icon { font-size: 36rpx; color: #CBD5E1; padding: 0 16rpx; }
.search-action-btn { color: #94A48C; font-size: 28rpx; padding-left: 20rpx; font-weight: 600; }

/* ================= 主内容区分栏 ================= */
.main-content {
  display: flex;
  flex: 1;
  overflow: hidden;
}

/* ================= 左侧侧边栏 ================= */
.sidebar {
  width: 200rpx; /* 稍微收紧，给右侧视频留出更多空间 */
  background-color: #F8F9F5; 
  height: 100%;
  border-right: 1px solid rgba(148, 164, 140, 0.05);
  box-sizing: border-box;
  padding: 20rpx 0; 
}

/* ================= 主菜单基础样式 (扁平化融入) ================= */
.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 16rpx 16rpx 16rpx; 
  padding: 32rpx 0;
  border-radius: 16rpx; 
  background-color: transparent; /* 默认透明，融入灰绿底色 */
  position: relative;
  transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}

.menu-item:active {
  transform: scale(0.95);
  background-color: rgba(148, 164, 140, 0.05);
}

.menu-icon {
  font-size: 48rpx; /* 微调图标大小，比例更协调 */
  color: #A0A49D;   /* 默认莫兰迪灰 */
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
}

.menu-name {
  font-size: 24rpx;
  color: #8A8E88;
  font-weight: 500;
  transition: all 0.3s ease;
}

/* ================= 主菜单选中状态 (白卡浮雕效果) ================= */
.menu-item.active,
.menu-item.active-parent {
  background-color: #FFFFFF; /* 选中时变成纯白卡片 */
  box-shadow: 0 8rpx 24rpx rgba(148, 164, 140, 0.12); /* 高级弥散阴影 */
  transform: translateY(-2rpx); /* 微微浮起 */
}

.menu-item.active .menu-icon,
.menu-item.active-parent .menu-icon {
  color: #94A48C; 
  transform: scale(1.1); 
}

.menu-item.active .menu-name,
.menu-item.active-parent .menu-name {
  color: #2C3327; 
  font-weight: bold; 
}

/* 下拉箭头 (绝对定位，防止破坏上下排版) */
.arrow {
  position: absolute;
  bottom: 14rpx;
  width: 10rpx;
  height: 10rpx;
  border-right: 3rpx solid #CBD5E1;
  border-bottom: 3rpx solid #CBD5E1;
  transition: all 0.3s ease;
}
.arrow.down { transform: rotate(45deg); }
.arrow.up { transform: rotate(-135deg); border-color: #94A48C; }

/* ================= 子菜单样式 ================= */
.sub-menu-list {
  background: transparent;
  padding: 0 0 16rpx 0;
  margin: -10rpx 16rpx 20rpx; /* 利用负边距贴合父级菜单 */
}

.sub-item {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #8A8E88; 
  text-align: center;
  position: relative;
  transition: all 0.3s ease;
  margin: 0 12rpx 8rpx; 
  border-radius: 12rpx;
}

.sub-item.active {
  color: #2C3327; 
  font-weight: bold; 
  background: #FFFFFF; 
  box-shadow: 0 4rpx 16rpx rgba(148, 164, 140, 0.08); 
}

.sub-dot {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #94A48C;
}

/* ================= 右侧视频列表 ================= */
.video-scroll {
  flex: 1;
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 玻璃拟态卡片 */
.glass-card {
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 20rpx; /* 圆角调大，更柔和 */
  box-shadow: 0 8rpx 32rpx rgba(148, 164, 140, 0.06); /* 阴影调柔和 */
  overflow: hidden;
  margin-bottom: 32rpx;
  transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1);
}

.video-card:active { transform: scale(0.97); }

.thumb-wrap {
  position: relative;
  width: 100%;
  height: 280rpx; /* 增加封面图高度，视觉更开阔 */
  background-color: #F8F9F5;
}

.video-thumb { 
  width: 100%; 
  height: 100%; 
  object-fit: cover; /* 保证图片等比裁切不拉伸 */
}

.play-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 88rpx;
  height: 88rpx;
  background: rgba(44, 51, 39, 0.4); /* 用主色调的深色调低透明度，比纯黑更高级 */
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}

.play-icon {
  width: 0; 
  height: 0; 
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  border-left: 24rpx solid #FFFFFF;
  margin-left: 10rpx;
}

.video-info { 
  padding: 24rpx; 
}

/* 视频标题容器 */
.video-title {
  display: flex;
  align-items: flex-start; /* 确保多行文本时序号对齐第一行 */
  font-size: 30rpx;
  color: #2C3327;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

/* 🌟 新增：优雅的数字序号前缀 */
.video-index-num {
  font-family: "DIN Alternate", "Courier New", monospace; /* 使用等宽高质感数字字体 */
  font-size: 32rpx;
  color: #94A48C; /* 经典莫兰迪绿 */
  font-weight: 700;
  margin-right: 16rpx; /* 与右侧标题拉开间距 */
  background: rgba(148, 164, 140, 0.1); /* 极其清淡的绿底色背景 */
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  display: inline-block;
  line-height: 1.2;
}

/* 标题文本限制 */
.video-title-text {
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.video-desc {
  font-size: 22rpx;
  color: #8A8E88;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.video-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1px dashed rgba(148, 164, 140, 0.15); /* 加一条虚线分割，细节拉满 */
}

.category-badge {
  font-size: 20rpx;
  color: #7A8B72;
  background: rgba(148, 164, 140, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.study-btn {
  background: linear-gradient(135deg, #94A48C 0%, #7A8B72 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(148, 164, 140, 0.3);
}

/* ================= 骨架屏与空状态 ================= */
.skeleton-item {
  margin-bottom: 32rpx;
  background: #fff;
  border-radius: 20rpx;
  padding-bottom: 24rpx;
}
.skeleton-thumb { width: 100%; height: 280rpx; background: #F0F2EE; border-radius: 20rpx 20rpx 0 0; }
.skeleton-info { padding: 24rpx; }
.skeleton-title { width: 80%; height: 32rpx; background: #F0F2EE; margin-bottom: 16rpx; border-radius: 8rpx; }
.skeleton-desc { width: 40%; height: 24rpx; background: #F0F2EE; border-radius: 8rpx; }

.empty-state { text-align: center; padding: 120rpx 0; color: #8A8E88; font-size: 26rpx; letter-spacing: 2rpx; }
.no-more { text-align: center; font-size: 22rpx; color: #CBD5E1; padding: 30rpx 0 50rpx; letter-spacing: 2rpx; }
/* 视频首帧占位样式 */
.video-thumb {
  width: 100%;
  height: 100%;
  /* 屏蔽内部交互 */
  pointer-events: none; 
}

/* 强制点击拦截遮罩 */
.video-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: transparent;
  z-index: 5; /* 确保盖在 video 之上 */
}

/* 确保播放按钮图标在最上层 */
.play-overlay {
  z-index: 10;
}
/* ================= 视频列表新增样式 ================= */

/* 时长悬浮标签 */
.duration-badge {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  backdrop-filter: blur(4px);
  z-index: 10;
}

/* 底部元信息行 */
.video-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  border-top: 1px dashed rgba(148, 164, 140, 0.15);
  padding-top: 16rpx;
}

/* 分类小标签 */
.category-badge {
  font-size: 20rpx;
  color: #7A8B72;
  background: rgba(148, 164, 140, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

/* 播放统计 */
.video-stats {
  display: flex;
  align-items: center;
}

.stat-item {
  font-size: 22rpx;
  color: #A0A49D;
  display: flex;
  align-items: center;
}

.stat-icon {
  font-size: 18rpx;
  margin-right: 6rpx;
  transform: translateY(1rpx);
}