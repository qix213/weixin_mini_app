<view class="exam-container">
  
  <!-- ================= 1. 选择科目 ================= -->
  <view class="step-box" wx:if="{{status === 'select'}}">
    <view class="start-exam-wrapper">
      
      <!-- 迎宾头部 -->
      <view class="exam-ready-header">
        <view class="exam-badge-wrap">
          <van-icon name="medal-o" class="exam-badge-icon"/>
        </view>
        <view class="exam-ready-title">商学院 · 考核认证</view>
        <view class="exam-ready-subtitle">Unique Skin Beauty Academy</view>
      </view>
      
      <!-- 考试列表 -->
      <view class="course-list">
        <view class="course-card" wx:for="{{courseTypes}}" wx:key="id" bindtap="startExam" data-id="{{item.id}}" data-name="{{item.name}}">
          <view class="card-left">
            <view class="card-icon-box">
              <van-icon name="records" class="card-icon"/>
            </view>
            <view class="card-info">
              <view class="card-title">{{item.name}}</view>
              <view class="card-desc">满分100分 | 单选·多选·判断</view>
            </view>
          </view>
          <view class="card-arrow">
            <text>开始</text>
            <van-icon name="arrow" size="24rpx" />
          </view>
        </view>
      </view>

    </view>
  </view>

  <!-- ================= 2. 答题中 ================= -->
  <view class="step-box testing-box" wx:if="{{status === 'testing'}}">
    
    <view class="exam-header">
      <view class="exam-header-top">
        <text class="exam-title">{{currentCourseName}}</text>
        <text class="exam-progress-text"><text class="current-num">{{questions.length}}</text> 题</text>
      </view>
      <!-- 进度条装饰 -->
      <view class="progress-bar">
        <view class="progress-inner" style="width: 100%;"></view>
      </view>
    </view>

    <scroll-view scroll-y class="question-scroll">
      <view class="question-item" wx:for="{{questions}}" wx:key="id" wx:for-index="qIndex">
        
        <view class="q-title">
          <text class="q-type-tag {{item.question_type === 1 ? 'single' : (item.question_type === 2 ? 'multi' : 'tf')}}">
            {{item.question_type === 1 ? '单选题' : (item.question_type === 2 ? '多选题' : '判断题')}}
          </text>
          <text class="q-title-text">{{qIndex + 1}}. {{item.question}}</text> 
          <text class="q-score">({{item.score}}分)</text>
        </view>

        <!-- 单选 / 判断 (隐藏原生 radio，通过 CSS 选中态高亮整行) -->
        <radio-group wx:if="{{item.question_type === 1 || item.question_type === 3}}" 
                     bindchange="onSingleChange" data-qid="{{item.id}}" class="options-group">
          <label class="option-label {{userAnswers[item.id] === optKey ? 'selected' : ''}}" 
                 wx:for="{{item.options}}" wx:for-index="optKey" wx:for-item="optVal" wx:key="optKey" wx:if="{{optVal}}">
            <radio value="{{optKey}}" checked="{{userAnswers[item.id] === optKey}}" class="hidden-input" />
            <view class="opt-prefix">{{optKey}}</view>
            <view class="opt-text">{{optVal}}</view>
          </label>
        </radio-group>

        <!-- 多选 (原生 checkbox 稍加美化) -->
        <checkbox-group wx:if="{{item.question_type === 2}}" 
                        bindchange="onMultiChange" data-qid="{{item.id}}" class="options-group">
          <label class="option-label multi-label" 
                 wx:for="{{item.options}}" wx:for-index="optKey" wx:for-item="optVal" wx:key="optKey" wx:if="{{optVal}}">
            <checkbox value="{{optKey}}" color="#94A48C" class="custom-checkbox" />
            <view class="opt-prefix">{{optKey}}</view>
            <view class="opt-text">{{optVal}}</view>
          </label>
        </checkbox-group>
      </view>

      <view class="submit-btn-wrap">
        <button class="submit-btn" bindtap="submitExam">提交考卷</button>
      </view>
    </scroll-view>
  </view>

  <!-- ================= 3. 考试结果 ================= -->
  <view class="step-box result-box" wx:if="{{status === 'result'}}">
    
    <!-- 成绩卡片 -->
    <view class="result-card-wrap">
      <view class="result-header-card {{examResult.is_pass ? 'pass' : 'fail'}}">
        <view class="score-ring">
          <view class="score-num">{{examResult.score}}</view>
          <view class="score-unit">分</view>
        </view>
        <view class="score-status">
          <van-icon name="{{examResult.is_pass ? 'passed' : 'close'}}" size="36rpx" />
          <text style="margin-left: 8rpx;">{{examResult.is_pass ? '恭喜，考核通过！' : '抱歉，未能及格'}}</text>
        </view>
        <view class="score-desc" wx:if="{{!examResult.is_pass}}">请温习解析后重新发起挑战</view>
      </view>
    </view>

    <view class="analysis-title">解析与回顾</view>
    
    <scroll-view scroll-y class="analysis-scroll">
      <view class="analysis-item" wx:for="{{resultList}}" wx:key="index">
        
        <view class="q-title">
          <text class="q-type-tag {{item.is_correct ? 'tf' : 'fail'}}">
            {{item.is_correct ? '回答正确' : '回答错误'}}
          </text>
          <text class="q-title-text">{{item.question}}</text>
        </view>
        
        <view class="ans-compare">
          <view class="ans-row">
            <text class="ans-label">你的答案</text>
            <text class="ans-val {{item.is_correct ? 'text-green' : 'text-red'}}">{{item.user_answer || '未作答'}}</text>
          </view>
          <view class="ans-row">
            <text class="ans-label">正确答案</text>
            <text class="ans-val text-green">{{item.correct_answer}}</text>
          </view>
        </view>
        
        <view class="explanation-box" wx:if="{{item.explanation}}">
          <view class="exp-title">
            <van-icon name="bulb-o" size="32rpx" style="margin-right:8rpx;"/>
            专家解析
          </view>
          <view class="exp-content">{{item.explanation}}</view>
        </view>
      </view>

      <view class="submit-btn-wrap">
        <button class="submit-btn back-btn" bindtap="backToSelect">返回认证中心</button>
      </view>
    </scroll-view>
  </view>
</view>