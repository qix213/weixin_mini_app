/* ================= 全局与背景 ================= */
page {
  background-color: #FAF8F5; /* 奶油可可白 */
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  min-height: 100vh;
}

/* 顶部科技感极简环境光晕 */
.dynamic-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 600rpx;
  z-index: -1;
  background: linear-gradient(180deg, rgba(148, 164, 140, 0.15) 0%, rgba(250, 248, 245, 0) 100%);
  pointer-events: none;
}

.coupon-container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
}

/* ================= 状态筛选栏 (高级胶囊样式) ================= */
.status-filter {
  display: flex;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 40rpx;
  margin-bottom: 40rpx;
  padding: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(148, 164, 140, 0.05);
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #94a3b8;
  font-weight: 500;
  border-radius: 32rpx;
  transition: all 0.3s ease;
}

.filter-item.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #94A48C 0%, #7A8B72 100%);
  font-weight: bold;
  box-shadow: 0 6rpx 16rpx rgba(148, 164, 140, 0.25);
}

/* ================= 优惠券列表 ================= */
.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* 优惠券主体 (拟态毛玻璃) */
.coupon-item {
  display: flex;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(148, 164, 140, 0.06);
  transition: transform 0.2s ease;
}

.coupon-item:active {
  transform: scale(0.98);
}

/* 未使用：左侧隐约的品牌色光效暗示 */
.coupon-item.unused::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, #94A48C 0%, #7A8B72 100%);
}

/* 已使用/过期样式 (优雅的灰度透视) */
.coupon-item.used, .coupon-item.expired {
  background: rgba(255, 255, 255, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.5);
  box-shadow: none;
}

/* ================= 优惠券左侧 (面额) ================= */
.coupon-left {
  flex: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-right: 1px dashed rgba(0, 0, 0, 0.06); /* 极简分割线代替原有的突兀圆孔 */
  padding-right: 30rpx;
}

.coupon-amount {
  font-size: 64rpx;
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
  color: #94A48C;
  margin-bottom: 8rpx;
  display: flex;
  align-items: baseline;
}

/* 面额的符号 ¥ 小一点 */
.coupon-amount::before {
  content: '¥';
  font-size: 32rpx;
  margin-right: 6rpx;
}

.coupon-item.used .coupon-amount,
.coupon-item.expired .coupon-amount {
  color: #C2C2C2;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #222222;
  letter-spacing: 1rpx;
}

.coupon-item.used .coupon-name,
.coupon-item.expired .coupon-name {
  color: #A3A3A3;
}

/* ================= 优惠券右侧 (有效期+状态) ================= */
.coupon-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
  padding-left: 20rpx;
  gap: 16rpx;
}

.coupon-period {
  font-size: 22rpx;
  color: #94a3b8;
  font-family: 'DIN Alternate', sans-serif;
  text-align: right;
  line-height: 1.4;
}

.coupon-status {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.coupon-status.unused {
  color: #FFFFFF;
  background: linear-gradient(135deg, #94A48C 0%, #7A8B72 100%);
  box-shadow: 0 4rpx 12rpx rgba(148, 164, 140, 0.2);
}

.coupon-status.used {
  color: #A3A3A3;
  background: rgba(0, 0, 0, 0.04);
}

.coupon-status.expired {
  color: #C49B9B; /* 高级脏粉色提示过期 */
  background: rgba(196, 155, 155, 0.08);
}

/* ================= 加载中与空状态 ================= */
.loading-container, .empty-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 150rpx 0;
}

.loading-text, .empty-text {
  font-size: 26rpx;
  color: #94a3b8;
  margin-bottom: 30rpx;
  letter-spacing: 2rpx;
}

.retry-btn {
  background: rgba(255, 255, 255, 0.8);
  color: #94A48C;
  border: 1px solid rgba(148, 164, 140, 0.3);
  border-radius: 40rpx;
  padding: 0 50rpx;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 26rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 16rpx rgba(148, 164, 140, 0.05);
  transition: all 0.2s;
}

.retry-btn:active {
  transform: scale(0.96);
  background: rgba(148, 164, 140, 0.05);
}

/* 隐藏原本破坏毛玻璃的虚线打孔设计，采用内部分割线（已在 .coupon-left 实现） */
.coupon-dash {
  display: none; 
}