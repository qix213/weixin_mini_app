/* 页面容器 */
.coupon-container {
  padding: 10rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 状态筛选栏 */
.status-filter {
  display: flex;
  background-color: #fff;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
}
.filter-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #333;
}
.filter-item.active {
  color: #1677ff;
  font-weight: bold;
  border-bottom: 4rpx solid #1677ff;
}

/* 加载中 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}
.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 优惠券列表 */
.coupon-list {
  gap: 10rpx;
  display: flex;
  flex-direction: column;
}

/* 优惠券项 */
.coupon-item {
  display: flex;
  background-color: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  position: relative;
  overflow: hidden;
}
/* 未使用优惠券样式 */
.coupon-item.unused {
  border: 2rpx solid #1677ff;
}
/* 已使用/过期样式（置灰） */
.coupon-item.used, .coupon-item.expired {
  border: 2rpx solid #e5e5e5;
  background-color: #f9f9f9;
  color: #999;
}

/* 优惠券左侧（面额） */
.coupon-left {
  flex: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.coupon-amount {
  font-size: 48rpx;
  font-weight: bold;
  color: #1677ff;
  margin-bottom: 8rpx;
}
.coupon-item.used .coupon-amount,
.coupon-item.expired .coupon-amount {
  color: #999;
}
.coupon-name {
  font-size: 28rpx;
  color: #333;
}
.coupon-item.used .coupon-name,
.coupon-item.expired .coupon-name {
  color: #999;
}

/* 优惠券右侧（有效期+状态） */
.coupon-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
  gap: 8rpx;
}
.coupon-period {
  font-size: 24rpx;
  color: #666;
}
.coupon-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}
.coupon-status.unused {
  color: #1677ff;
  background-color: #e6f4ff;
}
.coupon-status.used {
  color: #666;
  background-color: #f5f5f5;
}
.coupon-status.expired {
  color: #999;
  background-color: #f9f9f9;
}

/* 优惠券虚线装饰 */
.coupon-dash {
  position: absolute;
  top: 50%;
  right: 0;
  width: 20rpx;
  height: 20rpx;
  transform: translateY(-50%);
  border-radius: 50%;
  background-color: #f5f5f5;
  box-shadow: 0 0 0 10rpx #f5f5f5;
}
.coupon-dash::before {
  content: '';
  position: absolute;
  top: -100rpx;
  left: 10rpx;
  width: 1rpx;
  height: 200rpx;
  background-image: linear-gradient(to bottom, #e5e5e5 50%, transparent 50%);
  background-size: 100% 10rpx;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}
.retry-btn {
  background-color: #1677ff;
  color: #fff;
  border-radius: 8rpx;
  padding: 12rpx 32rpx;
  font-size: 28rpx;
}