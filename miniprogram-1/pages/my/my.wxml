<view class="mine-container">
  <view class="dynamic-bg"></view>

  <view class="user-info-card">
    <block wx:if="{{isLogin && memberInfo.nickname}}">
      <view class="avatar-area">
        <image class="avatar" src="/images/bg/bg.png" mode="aspectFill"></image>
        <view class="user-base-info">
          <view class="nickname">{{memberInfo.nickname}}</view>
          <view class="member-id">会员ID：{{memberInfo.member_id}}</view>
        </view>
      </view>
      <view class="member-card-btn" bindtap="goToMemberCenter">会员权益</view>
    </block>
    <block wx:else>
      <view class="unlogin-area">
        <button class="unlogin-btn" bindtap="goToLogin">立即登录/注册</button>
      </view>
    </block>
  </view>

  <view class="vip-board" wx:if="{{isLogin}}">
    <view class="vip-header">
      <view class="vip-title">{{memberInfo.user_type_text || '蓝朋友'}}</view>
    </view>
    <view class="vip-sub">
      <view class="vip-expire">会籍有效期：{{memberInfo.expire_time_text}}</view>
      <view class="vip-upgrade" wx:if="{{memberInfo.nextLevelDiff > 0}}">
        还需充值{{memberInfo.nextLevelDiff}}元升级为{{memberInfo.nextLevelName}}
      </view>
      <view class="vip-upgrade max-level" wx:else>尊贵的顶级会员，您已享最高权益</view>
    </view>

    <view class="vip-progress">
      <view class="node-item" wx:for="{{levelConfig}}" wx:key="value">
        <view class="node-cost">{{item.cost >= 10000 ? (item.cost/10000)+'万' : item.cost}}</view>
        <view class="node-icon-wrap">
          <view class="line-left" wx:if="{{index !== 0}}" style="background: {{ memberInfo.user_type >= item.value ? '#0ea5e9' : '#e2e8f0' }}"></view>
          <view class="line-right" wx:if="{{index !== levelConfig.length - 1}}" style="background: {{ memberInfo.user_type > item.value ? '#0ea5e9' : '#e2e8f0' }}"></view>
          <view class="star-bg">
            <van-icon name="{{ memberInfo.user_type >= item.value ? 'star' : 'star-o' }}" color="{{ memberInfo.user_type >= item.value ? '#0ea5e9' : '#cbd5e1' }}" size="40rpx" />
          </view>
        </view>
        <view class="node-name" style="color: {{ memberInfo.user_type >= item.value ? '#1e293b' : '#94a3b8' }}; font-weight: {{ memberInfo.user_type >= item.value ? 'bold' : 'normal' }}">
          {{item.shortName}}
        </view>
      </view>
    </view>
  </view>

  <view class="asset-container" wx:if="{{isLogin}}">
    <view class="asset-item" bindtap="goToPoints">
      <view class="asset-title">会员积分</view>
      <view class="asset-value">{{points || 0}}</view>
    </view>
    <view class="asset-divider"></view>
    <view class="asset-item" bindtap="goToCoupon">
      <view class="asset-title">优惠券</view>
      <view class="asset-value {{couponCount === 0 ? 'asset-value-gray' : ''}}">{{couponCount || 0}}张</view>
    </view>
  </view>

  <view class="function-list">
    <view class="function-item" bindtap="{{isLogin ? 'goToAddressManage' : 'goToLogin'}}">
      <view class="function-icon">📍</view>
      <view class="function-name" style="{{!isLogin ? 'color:#94a3b8' : ''}}">地址管理</view>
      <view class="function-arrow">→</view>
    </view>
    <view class="function-item" bindtap="goToInvoiceManage">
      <view class="function-icon">📄</view>
      <view class="function-name">订单状态</view>
      <view class="function-arrow">→</view>
    </view>
    <view class="function-item" bindtap="{{isLogin ? 'goToAIChat' : 'goToLogin'}}">
      <view class="function-icon">🤖</view>
      <view class="function-name" style="{{!isLogin ? 'color:#94a3b8' : ''}}">AI蓝博士</view>
      <view class="function-arrow">→</view>
    </view>
    <view class="function-item" bindtap="{{isLogin ? 'goToSubMemberConsume' : 'goToLogin'}}">
      <view class="function-icon">📊</view>
      <view class="function-name" style="{{!isLogin || !memberInfo.user_type ? 'color:#94a3b8' : ''}}">推荐会员消费记录</view>
      <view class="function-arrow">→</view>
    </view>
    <view class="function-item" bindtap="previewQrcode">
      <view class="function-icon">🔍</view>
      <view class="function-name">关注公众号</view>
      <view class="function-arrow">→</view>
    </view>
    <view class="function-item" bindtap="goToCustomerService">
      <view class="function-icon">💬</view>
      <view class="function-name">我的客服</view>
      <view class="function-arrow">→</view>
    </view>
    <view class="function-item" bindtap="goToLogout">
      <view class="function-icon">⚙️</view>
      <view class="function-name">登出</view>
      <view class="function-arrow">→</view>
    </view>
  </view>

  <modal wx:if="{{showQrcode}}" title="关注公众号" confirm-text="知道了" bindconfirm="hideQrcode">
    <image class="modal-qrcode-img" src="/images/bg/qrcode.jpg" mode="widthFix" show-menu-by-longpress="true"></image>
    <text class="modal-qrcode-text">长按图片识别二维码关注</text>
  </modal>
</view>