page {
  background: #FAF8F5; /* 奶油可可白 */
  color: #2C3327;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
}

.manager-search-bar {
  background: #FFFFFF;
  padding: 10rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(148, 164, 140, 0.04);
  position: relative;
  z-index: 10;
}

.list-container {
  padding: 30rpx;
  min-height: 60vh;
}

.sub-tabs-wrapper { padding-top: 30rpx; }
.sub-list { padding-top: 40rpx; }

/* ================= 🌟 高级玻璃质感通用面板 ================= */
.glass-panel {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(148, 164, 140, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.8);
  margin-bottom: 24rpx;
  overflow: hidden;
}

/* ================= 折叠面板定制样式 ================= */
.custom-collapse {
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(148, 164, 140, 0.05);
}
.custom-collapse-content {
  background: #FAFCFA !important; /* 展开后的底色稍微加深，突出内部卡片 */
  padding: 30rpx 20rpx !important; 
}

/* 客户标题行 */
.customer-title {
  display: flex;
  align-items: center;
}
.c-name {
  margin-left: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #2C3327;
}
.c-id {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #8A8E88;
}

/* ================= 项目资产卡片 (内部排版) ================= */
.asset-card {
  display: flex;
  padding: 24rpx;
  box-sizing: border-box;
}

.project-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: #EAECEA;
  margin-right: 24rpx;
  flex-shrink: 0; 
  object-fit: cover;
}

.asset-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.project-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2C3327;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.asset-meta {
  margin-top: auto;
  margin-bottom: 12rpx;
  display: flex;
  align-items: baseline;
}
.times-label { font-size: 24rpx; color: #8A8E88; }
.times-val { 
  color: #94A48C; 
  font-weight: bold; 
  font-size: 38rpx; 
  font-family: 'DIN Alternate', sans-serif;
  margin: 0 6rpx;
}
.total-val { color: #A0AAB5; font-size: 22rpx; }

.action-row {
  display: flex;
  justify-content: flex-end;
}

/* ================= 服务台流水卡片 ================= */
.record-card {
  padding: 0;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid #F8F9F5;
}

.user-info {
  display: flex;
  align-items: center;
}
.u-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #2C3327;
}
.u-id {
  font-size: 22rpx;
  color: #8A8E88;
  margin-left: 12rpx;
  background: #F1F3F1;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 30rpx;
  font-weight: 600;
}
.status-tag.pending { background: rgba(245, 158, 11, 0.12); color: #8A8E88; }
.status-tag.done { background: #F1F3F1; color: #8A8E88; }

.record-body {
  padding: 30rpx;
}
.p-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  color: #2C3327;
}
.p-desc {
  font-size: 26rpx;
  color: #8A8E88;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: rgba(250, 252, 250, 0.6);
  border-top: 1rpx dashed #EAECEA;
}
.tip-text { font-size: 24rpx; color: #8A8E88; }

/* ================= 评价展示区 ================= */
.review-box {
  padding: 0 30rpx 30rpx;
}
.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.r-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #2C3327;
  margin-right: 16rpx;
}
.r-content {
  font-size: 26rpx;
  color: #6B7067;
  line-height: 1.6;
  background: #F8F9F5;
  padding: 24rpx;
  border-radius: 16rpx;
}

/* ================= 辅助元素 ================= */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #A0AAB5;
  font-size: 28rpx;
}
.empty-state text { margin-top: 24rpx; }

/* 时间选择器工具栏 */
.custom-picker-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 110rpx;
  padding: 0 40rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F8F9F5;
}
.toolbar-title { font-size: 32rpx; font-weight: bold; color: #2C3327; }
.toolbar-btn { font-size: 30rpx; padding: 20rpx; }
.toolbar-btn.cancel { color: #A0AAB5; }
.toolbar-btn.confirm { color: #94A48C; font-weight: bold; }

.picker-columns-tips {
  display: flex;
  background: #FAFCFA; 
  padding: 18rpx 0;
  border-bottom: 1rpx solid #EAECEA;
}
.tip-col {
  flex: 1;             
  text-align: center;  
  font-size: 24rpx;
  color: #94A48C;
  font-weight: 600;
}
/* ================= 🌟 评价图片瀑布流展示 ================= */
.r-imgs {
  display: flex;
  flex-wrap: wrap; /* 容许超出时自动向下换行 */
  margin-top: 16rpx;
  padding: 0 4rpx;
}

.r-img-item {
  width: 136rpx;
  height: 136rpx;
  border-radius: 12rpx; /* 高级微圆角 */
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  background: #F1F3F1; /* 加载前的过渡底色 */
  object-fit: cover;   /* 完美居中裁切，防拉伸变形 */
  box-shadow: 0 2rpx 8rpx rgba(148, 164, 140, 0.05);
}

/* 移除每一行最后一幅图的多余右边距 */
.r-img-item:nth-child(4n) {
  margin-right: 0;
}