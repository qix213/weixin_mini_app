page {
  background: #FAF8F5;
  color: #2C3327;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
}

.list-container {
  padding: 30rpx;
  min-height: 60vh;
}
.sub-tabs-wrapper { padding-top: 30rpx; }
.sub-list { padding-top: 40rpx; }

/* 玻璃质感面板 */
.glass-panel {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(148, 164, 140, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.8);
  margin-bottom: 24rpx;
  overflow: hidden;
}

/* 资产卡片 */
.asset-card {
  display: flex;
  padding: 24rpx;
  box-sizing: border-box;
}
.project-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: #EAECEA;
  margin-right: 24rpx;
  flex-shrink: 0;
  object-fit: cover;
}
.asset-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}
.project-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2C3327;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.asset-meta {
  margin-top: auto;
  margin-bottom: 12rpx;
  display: flex;
  align-items: baseline;
}
.times-label { font-size: 24rpx; color: #8A8E88; }
.times-val { color: #94A48C; font-weight: bold; font-size: 38rpx; font-family: 'DIN Alternate', sans-serif; margin: 0 6rpx; }
.total-val { color: #A0AAB5; font-size: 22rpx; }
.action-row { display: flex; justify-content: flex-end; margin-top: 6rpx; }

/* 流水记录卡片 */
.record-card { padding: 0; }
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid #F8F9F5;
}
.time-text { font-size: 26rpx; color: #2C3327; font-weight: 600; }
.status-tag { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 30rpx; font-weight: 600; }
.status-tag.pending { background: rgba(245, 158, 11, 0.12); color: #F59E0B; }
.status-tag.done { background: #F1F3F1; color: #8A8E88; }

.record-body { padding: 30rpx; }
.p-name { font-size: 32rpx; font-weight: bold; margin-bottom: 12rpx; color: #2C3327; }
.p-desc { font-size: 26rpx; color: #8A8E88; }

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: rgba(250, 252, 250, 0.6);
  border-top: 1rpx dashed #EAECEA;
}
.tip-text { font-size: 24rpx; color: #8A8E88; }

/* 评价展示块 */
.review-box { padding: 0 30rpx 30rpx; }
.review-header { display: flex; align-items: center; margin-bottom: 16rpx; }
.r-title { font-size: 26rpx; font-weight: bold; color: #2C3327; margin-right: 16rpx; }
.r-content { font-size: 26rpx; color: #6B7067; line-height: 1.6; background: #F8F9F5; padding: 24rpx; border-radius: 16rpx; }

/* 空状态 */
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 140rpx 0; color: #A0AAB5; font-size: 28rpx; }
.empty-state text { margin-top: 24rpx; }

/* 🌟 评价弹窗特殊样式 */
.popup-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 40rpx;
  color: #2C3327;
}
.rate-section { display: flex; align-items: center; justify-content: center; margin-bottom: 20rpx; }
.rate-label { font-size: 28rpx; margin-right: 24rpx; color: #6B7067; }
.review-textarea {
  background: #F8F9F5 !important;
  border-radius: 16rpx;
  padding: 24rpx !important;
}

/* ========== 评价弹窗新增样式 ========== */
.upload-section {
  padding: 10rpx 0;
}

/* 覆盖 Vant Uploader 的默认样式，让它更圆润 */
.van-uploader__upload {
  border-radius: 16rpx !important;
  background-color: #F8F9F5 !important;
  border: 1px dashed #EAECEA !important;
}

.van-uploader__preview-image {
  border-radius: 16rpx !important;
}

/* 底部双按钮 */
.popup-actions {
  display: flex;
  justify-content: space-between;
  padding-bottom: env(safe-area-inset-bottom); /* 适配苹果底部小黑条 */
}
/* ================= 🌟 评价图片展示区 ================= */
.r-imgs {
  display: flex;
  flex-wrap: wrap; 
  margin-top: 16rpx;
  padding: 0 4rpx;
}

.r-img-item {
  width: 136rpx;
  height: 136rpx;
  border-radius: 12rpx; 
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  background: #F1F3F1; 
  object-fit: cover;   
  box-shadow: 0 2rpx 8rpx rgba(148, 164, 140, 0.05);
}

/* 消除每行最后一张图的右边距，防折行错位 */
.r-img-item:nth-child(4n) {
  margin-right: 0;
}