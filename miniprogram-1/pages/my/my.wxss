/* pages/mine/mine.wxss */
page {
  background: #f0f9ff;
  min-height: 100vh;
}

.mine-container {
  position: relative;
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* 动态流光背景 (与AI页面一致) */
.dynamic-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  background: linear-gradient(-45deg, #e0f2fe, #ffffff, #bae6fd, #f8fafc);
  background-size: 400% 400%;
  animation: gradientBG 15s ease infinite;
}

@keyframes gradientBG {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ========== 会员信息卡片 (深邃科技蓝 + 玻璃反光) ========== */
.user-info-card {
  position: relative;
  background: linear-gradient(135deg, #0284c7, #0ea5e9);
  color: #fff;
  margin: 30rpx 20rpx;
  padding: 40rpx 30rpx;
  border-radius: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 180rpx;
  box-shadow: 0 15rpx 35rpx rgba(2, 132, 199, 0.3);
  overflow: hidden;
}

/* 卡片内部的流光反光层 */
.user-info-card::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 60%);
  transform: rotate(30deg);
  pointer-events: none;
}

.avatar-area {
  display: flex;
  align-items: center;
  flex: 1;
  z-index: 1;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 0 20rpx rgba(255, 255, 255, 0.4);
}

.user-base-info {
  margin-left: 30rpx;
}

.nickname {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
  text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.member-type, .member-id {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 6rpx;
  font-weight: 300;
}

/* 卡片内按钮 (磨砂玻璃质感) */
.member-card-btn {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  color: #fff;
  padding: 18rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
  z-index: 1;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
}

.unlogin-area {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1;
}

.unlogin-btn {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  color: #fff;
  padding: 24rpx 70rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.1);
}

/* ========== 共用白透毛玻璃面板 ========== */
.glass-panel {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 2rpx solid rgba(255, 255, 255, 1);
  border-radius: 30rpx;
  margin: 0 20rpx 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(14, 165, 233, 0.08); /* 极度柔和的天蓝阴影 */
}

/* 积分+优惠券 */
.asset-container {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 2rpx solid rgba(255, 255, 255, 1);
  border-radius: 30rpx;
  margin: 0 20rpx 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(14, 165, 233, 0.08);
}

.asset-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.asset-item:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.asset-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: rgba(14, 165, 233, 0.2); /* 淡淡的蓝线分隔 */
}

.asset-title {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.asset-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #0ea5e9; /* 亮天蓝字 */
}

.asset-value-gray {
  color: #94a3b8 !important;
  font-weight: 500 !important;
}

/* 会员到期时间 */
.vip-expire-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 35rpx 40rpx;
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 2rpx solid rgba(255, 255, 255, 1);
  border-radius: 30rpx;
  margin: 0 20rpx 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(14, 165, 233, 0.08);
}

.vip-expire-title {
  font-size: 28rpx;
  color: #334155;
  font-weight: 600;
}

.vip-expire-value {
  font-size: 28rpx;
  color: #0ea5e9;
  font-weight: 800;
}

/* ========== 功能列表 ========== */
.function-list {
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 2rpx solid rgba(255, 255, 255, 1);
  border-radius: 30rpx;
  margin: 0 20rpx 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(14, 165, 233, 0.08);
}

.function-item {
  display: flex;
  align-items: center;
  padding: 35rpx 20rpx;
  border-bottom: 2rpx solid rgba(14, 165, 233, 0.08);
  transition: background 0.2s;
}

.function-item:last-child {
  border-bottom: none;
}

.function-item:active {
  background: rgba(240, 249, 255, 0.5);
  border-radius: 20rpx;
}

/* 图标包裹层：增加高科技微光底色 */
.function-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #e0f2fe, #bae6fd);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 25rpx;
  box-shadow: 0 4rpx 10rpx rgba(14, 165, 233, 0.15);
}

.function-name {
  flex: 1;
  font-size: 30rpx;
  color: #334155;
  font-weight: 600;
}

.function-arrow {
  font-size: 28rpx;
  color: #cbd5e1;
  font-weight: bold;
}

/* ========== 二维码弹窗 (保持极简) ========== */
.modal-qrcode-img {
  width: 400rpx;
  display: block;
  margin: 0 auto;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.1);
}

.modal-qrcode-text {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 30rpx;
  display: block;
  text-align: center;
  font-weight: 500;
}