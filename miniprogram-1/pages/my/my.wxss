/* pages/mine/mine.wxss */
.mine-container {
  padding: 0;
  margin: 0;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 会员信息卡片 */
.user-info-card {
  background: linear-gradient(135deg, #1677ff, #4096ff);
  color: #fff;
  padding: 30rpx 20rpx;
  border-bottom-left-radius: 30rpx;
  border-bottom-right-radius: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 220rpx;
}

.avatar-area {
  display: flex;
  align-items: center;
  flex: 1;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid #fff;
}

.user-base-info {
  margin-left: 30rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.member-type {
  font-size: 28rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.member-id {
  font-size: 26rpx;
  opacity: 0.7;
}

.member-card-btn {
  background-color: #fff;
  color: #1677ff;
  padding: 20rpx 30rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
}

/* 未登录样式 */
.unlogin-area {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.unlogin-btn {
  background-color: #fff;
  color: #1677ff;
  padding: 25rpx 60rpx;
  border-radius: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
}

/* 积分+优惠券样式 */
.asset-container {
  display: flex;
  background-color: #fff;
  margin: 30rpx 20rpx;
  border-radius: 10rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.asset-item {
  flex: 1;
  text-align: center;
}

.asset-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: #eee;
}

.asset-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.asset-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 会员到期时间样式 */
.vip-expire-container {
  background-color: #fff;
  margin: 0 20rpx 30rpx;
  border-radius: 10rpx;
  padding: 25rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.vip-expire-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.vip-expire-value {
  font-size: 32rpx;
  color: #1677ff;
  font-weight: 500;
}

/* 功能列表样式 */
.function-list {
  background-color: #fff;
  margin: 0 20rpx 30rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.function-item {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  border-bottom: 1rpx solid #eee;
}

.function-item:last-child {
  border-bottom: none;
}

.function-icon {
  font-size: 36rpx;
  margin-right: 30rpx;
  width: 40rpx;
  text-align: center;
}

.function-name {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.function-arrow {
  font-size: 28rpx;
  color: #999;
  margin-right: 10rpx;
}

/* 二维码弹窗样式 */
.qrcode-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.qrcode-content {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 10rpx;
  text-align: center;
}

.qrcode-img {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 20rpx;
}

.qrcode-tip {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.close-btn {
  background-color: #1677ff;
  color: #fff;
  padding: 10rpx 40rpx;
  border-radius: 20rpx;
}
.asset-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  flex: 1;
  text-align: center;
}
/* 点击态样式 */
.asset-item-hover {
  background-color: #f5f5f5;
  border-radius: 8rpx;
}
.asset-title {
  font-size: 28rpx;
  color: #666;
}
.asset-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1677ff;
  margin-top: 8rpx;
}
.asset-value-gray {
  color: #999 !important;
  font-weight: normal !important;
}