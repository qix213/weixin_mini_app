page { background-color: #FAF8F5; height: 100vh; }
.upgrade-container { padding: 30rpx; padding-bottom: 180rpx; }
.dynamic-bg { position: fixed; top:0; left:0; width: 100%; height: 100%; background: linear-gradient(135deg, #FAF8F5, #F4F6F2); z-index: -1; }

.glass-card { background: rgba(255,255,255,0.85); backdrop-filter: blur(20px); border-radius: 24rpx; border: 1px solid rgba(148,164,140,0.15); box-shadow: 0 8rpx 24rpx rgba(148,164,140,0.05); }

.header-card { padding: 50rpx 40rpx; text-align: center; margin-bottom: 40rpx; }
.header-card .title { font-size: 26rpx; color: #8A8E88; margin-bottom: 10rpx; }
.header-card .current-level { font-size: 44rpx; font-weight: bold; color: #94A48C; margin-bottom: 20rpx; }
.header-card .subtitle { font-size: 24rpx; color: #6B7067; }

.level-card { padding: 40rpx 30rpx; display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; transition: all 0.3s; border: 2rpx solid transparent; }
.level-card.active { border-color: #94A48C; background: rgba(148,164,140,0.05); }

.card-left { flex: 1; }
.level-name { font-size: 32rpx; font-weight: bold; color: #2C3327; margin-bottom: 12rpx; display: flex; align-items: center; }
.recommend { font-size: 18rpx; background: #94A48C; color: #fff; padding: 4rpx 12rpx; border-radius: 8rpx; margin-left: 16rpx; font-weight: normal; }
.level-desc { font-size: 24rpx; color: #8A8E88; }

.card-right { display: flex; align-items: center; }
.price { font-size: 38rpx; font-weight: bold; color: #2C3327; margin-right: 30rpx; font-family: 'DIN Alternate', sans-serif;}
.price .unit { font-size: 24rpx; }

.radio-circle { width: 36rpx; height: 36rpx; border-radius: 50%; border: 2px solid #CBD5E1; display: flex; justify-content: center; align-items: center; }
.active .radio-circle { border-color: #94A48C; }
.inner-dot { width: 20rpx; height: 20rpx; background: #94A48C; border-radius: 50%; }

.bottom-bar { position: fixed; bottom: 0; left: 0; width: 100%; height: 140rpx; background: rgba(255,255,255,0.9); backdrop-filter: blur(10px); display: flex; justify-content: space-between; align-items: center; padding: 0 40rpx; box-sizing: border-box; border-top: 1px solid rgba(148,164,140,0.1); padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); }
.total-info { font-size: 28rpx; color: #6B7067; }
.total-info .val { font-size: 44rpx; font-weight: bold; color: #2C3327; font-family: 'DIN Alternate', sans-serif;}
.pay-btn { margin: 0; width: 280rpx; height: 80rpx; line-height: 80rpx; background: linear-gradient(135deg, #94A48C 0%, #7A8B72 100%); color: #fff; font-size: 30rpx; border-radius: 40rpx; box-shadow: 0 8rpx 16rpx rgba(148,164,140,0.25); }
.pay-btn:active { transform: scale(0.96); }

/* ================= VIP 星级面板深度视觉修正 ================= */
.vip-board {
  padding: 36rpx 30rpx !important;
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
}

/* 1. 会籍基本状态栏 */
.vip-meta-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1px solid rgba(148, 164, 140, 0.08); /* 极细分隔线 */
}

.vip-expire-box {
  display: flex;
  align-items: center;
}

.expire-label {
  font-size: 24rpx;
  color: #8A8E88;
}

.expire-date-val {
  font-size: 26rpx;
  color: #2C3327;
  font-weight: 500;
  font-family: 'DIN Alternate', sans-serif; /* 时间数字高级化 */
}

.vip-identity-tag {
  font-size: 22rpx;
  color: #94A48C;
  background: rgba(148, 164, 140, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 2. 升级晋升交互区 */
.vip-upgrade-action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.upgrade-left-tip {
  display: flex;
  flex-direction: column;
}

.tip-prefix {
  font-size: 20rpx;
  color: #94A48C;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: #6B7067;
}

.tip-money {
  color: #2C3327;
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
}

.tip-max-status {
  font-size: 24rpx;
  color: #94A48C;
  font-weight: 500;
}

/* 🌟 核心调优：高显性轻奢级胶囊升级大按钮 */
.btn-upgrade-luxury {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #94A48C 0%, #7A8B72 100%); /* 渐变真丝质感 */
  border-radius: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(148, 164, 140, 0.3); /* 浮空阴影提示点击 */
  transition: all 0.2s cubic-bezier(0.25, 1, 0.5, 1);
}

.btn-upgrade-luxury .btn-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-right: 6rpx;
}

.btn-upgrade-luxury .btn-arrow-icon {
  margin-top: 2rpx;
}

/* 点击回弹动效：物理感知增强 */
.btn-upgrade-luxury:active {
  transform: scale(0.95) translateY(2rpx);
  box-shadow: 0 2rpx 6rpx rgba(148, 164, 140, 0.15);
  opacity: 0.95;
}

/* 3. 星级进度排版保护 */
.vip-progress {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F8F9F5;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  margin-top: 8rpx;
}

.node-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.node-cost {
  font-size: 22rpx;
  font-family: 'DIN Alternate', sans-serif;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.node-cost .rmb {
  font-size: 16rpx;
  margin-right: 2rpx;
}

.node-stars {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 40rpx;
}