<view class="container">
  <!-- 遍历订单列表 -->
  <block wx:for="{{orderList}}" wx:key="order_sn">
    <view class="order-card">
      <!-- 订单号+状态 -->
      <view class="order-header">
        <text class="sn">订单号：{{item.order_sn}}</text>
        <text class="status">{{item.status}}</text>
      </view>

      <!-- 商品列表（核心：渲染预处理的goodsList） -->
      <view class="goods-area">
        <text class="goods-title">商品：</text>    
        <!-- 用view替代block，直接循环goodsList -->
        <view 
          wx:for="{{item.goodsList}}" 
          wx:key="index" 
          class="goods-item"
        >
          {{item}} ×1
        </view>

        <!-- 兜底提示（仅当数组为空时显示） -->
        <view class="no-goods" wx:if="{{item.goodsList.length === 0}}">
          暂无商品信息
        </view>
      </view>

      <!-- 订单时间+总价 -->
      <view class="order-info">
        <text>{{item.create_time}}</text>
        <text class="price">￥{{item.total_price}}</text>
      </view>
    </view>
  </block>

  <view class="empty" wx:if="{{orderList.length === 0}}">暂无消费记录</view>
</view>