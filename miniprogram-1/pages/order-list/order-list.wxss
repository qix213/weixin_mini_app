/* 全局重置，避免默认样式干扰 */
page {
  background-color: #f5f5f5; /* 页面背景，和订单卡片区分 */
}

/* 订单列表容器（匹配WXML的外层view） */
.container {
  padding: 15rpx;
}

/* 单个订单卡片（匹配WXML的订单卡片view） */
.order-card {
  background: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

/* 订单号+状态行（匹配WXML的order-header view） */
.order-header {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.order-header .sn {
  color: #333;
}
.order-header .status {
  color: #ff6600;
}

/* 商品列表区域（匹配WXML的商品列表view） */
.goods-area {
  margin-bottom: 20rpx;
}
/* 商品标题（“商品：”） */
.goods-title {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}
/* 单个商品行（匹配WXML的goodsName view） */
.goods-item {
  font-size: 26rpx;
  color: #666; /* 确保文字颜色不是白色（和背景同色会看不见） */
  margin-bottom: 8rpx;
  /* 去掉flex，避免挤压文字 */
  display: block;
}
/* 暂无商品提示 */
.no-goods {
  font-size: 26rpx;
  color: #999;
}

/* 订单时间+总价行 */
.order-info {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #999;
}
.order-info .price {
  color: #333;
  font-weight: bold;
}

/* 空订单提示 */
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 所有会员总消费栏 */
.total-all-bar {
  padding: 10rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
}
.total-all-label {
  font-size: 28rpx;
  color: #333;
}
.total-all-amount {
  font-size: 30rpx;
  color: #e64340;
  font-weight: bold;
  margin-left: 10rpx;
}

/* 会员项外层包裹（每个会员独立） */
.member-item-wrapper {
  margin-bottom: 15rpx;
  border: 1px solid #eee;
  border-radius: 8rpx;
  overflow: hidden;
}

/* 原有样式保留，仅补充 */
.consume-detail {
  background: #fafafa;
  padding: 15rpx;
}

.pending-pay {
  color: #f4333c; /* 微信支付红 */
  font-weight: bold;
  cursor: pointer; /* 提示可点击 */
}

/* 订单头部布局优化 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 10rpx;
}

/* 积分商品标签 */
.point-tag {
  position: absolute;
  left: 200rpx;
  color: #ff9900;
  font-size: 24rpx;
  background: #fff8e6;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

/* 待付款状态样式 */
.pending-pay {
  color: #f4333c;
  font-weight: bold;
  cursor: pointer;
}

/* 价格区域布局 */
.price-area {
  text-align: right;
}

/* 金额样式 */
.price {
  color: #f4333c;
  font-weight: bold;
  font-size: 30rpx;
}
.point-price {
  color: #ff9900; /* 积分价格用橙色，和人民币红色区分 */
}
/* 积分抵扣数量样式 */
.point-deduct {
  display: block;
  color: #ff9900;
  font-size: 24rpx;
  margin-top: 4rpx;
  font-weight: normal;
}