/* ================= 全局与背景 ================= */
page {
  background: #f0f9ff;
  min-height: 100vh;
}

.order-list-container {
  position: relative;
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.dynamic-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  background: linear-gradient(-45deg, #e0f2fe, #ffffff, #bae6fd, #f8fafc);
  background-size: 400% 400%;
  animation: gradientBG 15s ease infinite;
}

@keyframes gradientBG {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ================= 订单卡片 (高透玻璃) ================= */
.glass-card {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 2rpx solid rgba(255, 255, 255, 1);
  border-radius: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(14, 165, 233, 0.08);
  margin-bottom: 30rpx;
  padding: 30rpx;
  transition: transform 0.2s ease;
}

.glass-card:active {
  transform: scale(0.98);
}

/* ================= 头部：订单号与状态 ================= */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx dashed rgba(14, 165, 233, 0.2);
}

.sn-wrap {
  display: flex;
  align-items: center;
}

.sn-wrap .icon { font-size: 28rpx; margin-right: 8rpx; }
.sn-text { font-size: 26rpx; color: #64748b; font-weight: 500; }

.status-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status {
  font-size: 28rpx;
  color: #0ea5e9; /* 默认完成状态用主题蓝 */
  font-weight: 800;
}

/* 待付款的强调色 (高亮橙红) */
.status.pending { color: #f97316; }

/* 倒计时徽章 */
.countdown-badge {
  background: rgba(249, 115, 22, 0.1);
  border: 1rpx solid rgba(249, 115, 22, 0.3);
  color: #ea580c;
  font-size: 22rpx;
  font-family: 'DIN Alternate', sans-serif;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  font-weight: bold;
}
.clock-icon { margin-right: 6rpx; font-size: 20rpx; }

/* ================= 中部：商品列表 ================= */
.goods-area {
  padding: 24rpx 0;
}

.goods-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.goods-title { font-size: 28rpx; color: #1e293b; font-weight: 800; margin-right: 16rpx;}

.point-tag {
  background: linear-gradient(135deg, #e0f2fe, #bae6fd);
  color: #0284c7;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: bold;
  border: 1rpx solid rgba(56, 189, 248, 0.4);
}

.goods-list {
  background: rgba(241, 245, 249, 0.5);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}

.goods-item {
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
}
.goods-item:last-child { margin-bottom: 0; }

.goods-item .dot { color: #0ea5e9; font-weight: bold; margin-right: 8rpx; }
.goods-count { margin-left: auto; color: #94a3b8; font-size: 24rpx; }

.no-goods { font-size: 24rpx; color: #94a3b8; font-style: italic; }

/* ================= 底部：金额与操作 ================= */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-top: 20rpx;
  border-top: 2rpx dashed rgba(14, 165, 233, 0.2);
}

.time-text {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 4rpx;
}

.action-area {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.price-area {
  display: flex;
  align-items: baseline;
}

.price-area .label { font-size: 24rpx; color: #64748b; margin-right: 8rpx; }
.price-area .unit { font-size: 24rpx; color: #1e293b; font-weight: bold; }
.price-area .price-val { 
  font-size: 40rpx; 
  color: #1e293b; 
  font-weight: 900; 
  font-family: 'DIN Alternate', sans-serif;
}
.price-area .point-val { color: #0ea5e9; } /* 积分数字用蓝色 */

/* 悬浮支付按钮 */
.pay-btn {
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  border-radius: 32rpx;
  box-shadow: 0 6rpx 15rpx rgba(14, 165, 233, 0.3);
  margin: 0;
}
.pay-btn:active { transform: scale(0.95); }

/* ================= 空状态 & 加载态 ================= */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 20vh;
}

.empty-icon-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-icon { font-size: 100rpx; z-index: 2; opacity: 0.8; }

.glow-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(14, 165, 233, 0.1);
  box-shadow: 0 0 40rpx rgba(14, 165, 233, 0.2);
  animation: pulse 3s infinite alternate;
}

@keyframes pulse {
  0% { transform: scale(0.8); opacity: 0.5; }
  100% { transform: scale(1.2); opacity: 1; }
}

.empty-text { font-size: 28rpx; color: #64748b; font-weight: 500; }
.loading-state { text-align: center; padding: 30rpx; font-size: 24rpx; color: #94a3b8; }