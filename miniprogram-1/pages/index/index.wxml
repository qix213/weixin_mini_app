<!-- 顶部渐变横幅（整合标语、Logo、功能按钮） -->
<!-- 顶部垂直渐变横幅（从蓝到白） -->
<view class="banner1">
  <!-- 顶部栏：标语 + 右上角登录/注册 -->
  <view class="banner-header">
    <view class="banner-text">
      <image class="banner-logo" src="/images/home/logo.png" mode="widthFix" />
      <text class="greeting">Hi，蓝朋友</text>
      <text class="welcome">欢迎来到蓝色奇肌SSTA</text>
    </view>
    
    <block wx:if="{{isLogin && userInfo.nickname}}">
      <!-- 登录后：欢迎昵称 -->
      <text class="welcome-text">欢迎回来，{{userInfo.nickname}}！</text>
    </block>
    <block wx:else>    
      <view class="login-register-btn-group">
        <button class="login-btn" bindtap="goToLogin">登录</button>
        <button class="register-btn" bindtap="goToRegister">注册</button>
      </view>
  </block>
  </view>


  <!-- 功能按钮组 -->
