<!-- 顶部渐变横幅 -->
<view class="banner1">
  <view class="banner-header">
    <!-- 左侧：欢迎标语 -->
    <view class="banner-text">
      <text class="greeting">欢迎来到蓝色奇肌 ssta</text>
      <text class="welcome">
      Skin Simple Treat Anytime
      精简护肤 随时悦享
      </text>
    </view>

    <!-- 右侧：Logo + 登录/注册按钮/欢迎文本（核心：条件渲染） -->
    <view class="header-right">
      <image class="banner-logo" src="/images/home/logo.png" mode="widthFix" />
      <!-- 登录状态：显示欢迎文本 -->
      <view class="user-welcome" wx:if="{{isLogin}}">
        <text class="welcome-text">欢迎回来，{{userInfo.nickname || '用户'}}</text>
      </view>
      <!-- 未登录状态：显示登录/注册按钮 -->
      <view class="login-register-btn-group" wx:else>
        <button class="login-btn" bindtap="goToLogin">登录</button>
        <button class="register-btn" bindtap="goToRegister">注册</button>
      </view>
    </view>
  </view>
</view>

<!-- 公告区域 -->
<view class="notice">
  <image src="/images/home/board.png" mode="aspectFit" style="width: 100rpx; height: 100rpx;" />
  <text>最新优惠活动信息：{{notice}} {{content}}</text>
</view>

<!-- 轮播图 -->
<view class="banner" wx:if="{{banner_list.length > 0}}">
  <swiper autoplay indicator-dots circular indicator-color="#FFFFFF" interval="4000">
    <swiper-item wx:for="{{banner_list}}" wx:key="index">
      <image src="{{item.img}}" mode="widthFix" style="width: 100%;" />
    </swiper-item>
  </swiper>
</view>

<!-- 明星产品区域（重构优化） -->
<view class="section-title-wrap">
  <text class="section-title">明星家居产品</text>
</view>
<view class="star-goods-section" wx:if="{{star_goods.length > 0}}">
  <view class="star-goods-container">
    <block wx:for="{{star_goods}}" wx:key="id">
      <view class="star-goods-item" bindtap="goToGoodsDetail" data-goodsid="{{item.id}}">
        <image 
          src="{{item.image}}" 
          mode="aspectFit"  
          class="star-goods-img"
          lazy-load="true"
          default-src="/images/home/default-img.png"
        />
        <view class="goods-info">
          <text class="goods-name">{{item.name}}</text>
          <view class="price-wrap">
            <text class="current-price">¥{{item.price}}</text>
            <text class="original-price" wx:if="{{item.original_price}}">¥{{item.original_price}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>

