.regist{
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  padding: 10rpx 1rpx ;
  margin: 10rpx 30rpx;
}

.icon {
  padding-right: 10rpx;
}

.menu {
  display: flex;
  justify-content: space-between;
  padding: 16rpx;
  border-radius: 10rpx;
  flex-wrap: wrap;
  background-color: powderblue;
}

.item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 250rpx;
  height: 200rpx;
  border: rgb(192, 251, 255) solid 10rpx;
  margin: 1rpx;
  background-color: powderblue;
}

.img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
}

.title {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.notice {
  display: flex;
  justify-content: flex-start;
  margin-top: 20rpx;
  margin-bottom: 10rpx;
}

.notice>text {
  flex-grow: 1;
  font-size: medium;
  color: blue;
}


/* 固定图片容器 - 保持原有Flex布局 */
.fixed-images-container {
  display: flex;          
  flex-wrap: wrap;        
  justify-content: space-between; 
  padding: 0 20rpx;       
  min-height: 200rpx;     
  gap: 30rpx 0;  /* 上下30rpx间隔，左右0 */
}

/* 新增：图片+名称的外层项（核心控制每行2张） */
.fixed-image-item {
  width: 48%;              /* 每行2张 */
  display: flex;           /* 垂直布局：图片在上，文字在下 */
  flex-direction: column;  
  align-items: center;     /* 内容居中 */
}

/* 单张图片样式 - 去掉width，由外层item控制 */
.fixed-image {
  width: 100%;             /* 占满外层item宽度 */
  min-height: 200rpx;     
  height: auto;           
  border-radius: 10rpx;   
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  object-fit: cover;      
}

/* 产品名称样式 */
.fixed-image-title {
  margin-top: 10rpx;       /* 名称与图片的间距 */
  font-size: 24rpx;        /* 字体大小 */
  color: #333;             /* 字体颜色 */
  text-align: center;      /* 文字居中 */
  white-space: nowrap;     /* 禁止换行 */
  overflow: hidden;        /* 超出隐藏 */
  text-overflow: ellipsis; /* 超出显示省略号 */
  width: 100%;             /* 宽度继承外层 */
}

.fixed-images-section {
  background-color: #fff; 
  margin: 20rpx 0;        
  padding: 10rpx 0;       
}
