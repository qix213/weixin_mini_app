/* 全局样式 */
page {
  background-color: #ffffff; /* 渐变底部已到白，页面背景设为白 */
}

/* 顶部横幅：垂直渐变（上蓝→下白，过渡明显） */
.banner1 {
  width: 100%;
  height: 360rpx; /* 适配渐变长度 */
  /* 垂直渐变：从品牌蓝 → 浅蓝 → 白色 */
  background: linear-gradient(180deg, 
    #1E88E5 0%,    /* 顶部：品牌主蓝 */
    #42a5f5 60%,   /* 中间：浅蓝过渡 */
    #ffffff 100%   /* 底部：完全白色 */
  );
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  color: white;
}

/* 顶部栏：标语 + Logo + 登录按钮（横向排列） */
.banner-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

/* 欢迎标语样式 */
.banner-text {
  flex: 1; /* 占满除Logo和登录按钮外的空间 */
}
.banner-text .greeting {
  font-size: 40rpx;
  font-weight: 600;
  display: block;
}
.banner-text .welcome {
  font-size: 30rpx;
  opacity: 0.8;
}

/* 新增：greeting右侧的Logo样式 */
.banner-logo {
  width: 200rpx;   /* Logo宽度，可按需调整 */
  height: 300rpx;  /* Logo高度，可按需调整 */
   /* margin: 0 40rpx;  */
  border-radius: 8rpx; /* 轻微圆角，提升质感 */
}

/* 右上角登录按钮 */
.login-btn {
  font-size: 30rpx;
  color:  rgb(35, 123, 158);
  padding: 8rpx 16rpx;
  border: 2rpx solid rgba(255,255,255,0.8);
  border-radius: 20rpx;
  white-space: wrap; /* 防止按钮文字换行 */
}

.register-btn {
  font-size: 30rpx;
  color: rgb(35, 123, 158);
  padding: 8rpx 16rpx;
  border: 2rpx solid rgba(255,255,255,0.8);
  border-radius: 20rpx;
  white-space: wrap; /* 防止按钮文字换行 */
}
/* 登录后：欢迎昵称 */
.welcome-text {
  color: #fff;
  font-size: 32rpx;
  margin-left: 20rpx;
}
/* 未登录：登录/注册按钮组 */
.login-register-btn-group {
  display: flex;
  flex-direction: row; /* 改为横向排列（关键） */
  gap: 8rpx; /* 按钮之间的小间距 */
  align-items:self-start; /* 垂直居中 */
}
/* 功能按钮组（匹配截图样式） */
.banner-btn-group {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}
/* 欢迎文本样式（和按钮区域对齐） */
.user-welcome {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10rpx;
}
.welcome-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  padding: 10rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}


.btn {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
}

/* 入会按钮：蓝边框+白字 */
.join-btn {
  background-color: transparent;
  color: #1E88E5;
  border: 2rpx solid #1E88E5;
}

/* 商城按钮：白底色+蓝字 */
.mall-btn {
  background-color: white;
  color: #1E88E5;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1); /* 轻微阴影提升质感 */
}
