page {
  background-color: #F4F6F9; /* 现代浅灰蓝背景 */
  --primary-color: #1E88E5;  /* 统一为品牌蓝 */
  --primary-light: #E6F0FF;
  --text-main: #333333;
  --text-gray: #999999;
}

/* ================= 顶部横幅 ================= */
.banner-header-wrap {
  /* 上蓝下白渐变，最后完美过渡到页面的浅灰白底色 */
  background: linear-gradient(180deg, #1E88E5 0%, #90caf9 75%, #F4F6F9 100%);
  padding: 40rpx 30rpx 40rpx;
  border-radius: 0; 
  box-shadow: none; 
  margin-bottom: 0; 
}

.banner-header {
  position: relative; /* 🔥 核心1：为Logo的绝对定位做参照物 */
  display: flex;
  flex-direction: column; 
  align-items: flex-start;
  width: 100%;
}

.banner-text {
  width: 72%; /* 🔥 核心2：限制文字最大宽度，给右上角的Logo留出空间，绝对不会重叠 */
  display: flex;
  flex-direction: column;
  color: #fff; 
}
.banner-text .greeting {
  font-size: 52rpx; 
  font-weight: 900;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.15); 
}
.banner-text .welcome {
  font-size: 32rpx; 
  font-weight: bold;
  opacity: 0.95;
  font-family: 'Arial', sans-serif;
  margin-bottom: 8rpx;
}
.banner-text .welcome-sub {
  font-size: 28rpx; 
  opacity: 0.9;
  color: #e3f2fd;
}

.header-right {
  width: 100%; 
  display: flex;
  flex-direction: row; 
  justify-content: flex-end; /* 🔥 核心3：让里面的按钮乖乖靠右排列 */
  align-items: center;
  margin-top: 1rpx; /* 和上面的文字拉开一点距离 */
}

/* 🔥 核心4：Logo绝对定位，死死钉在右上角！ */
.banner-logo {
  position: absolute; 
  top: 0;
  right: 0;
  width: 140rpx; 
  height: 70rpx;
  border-radius: 16rpx;
  background: #ffffff; /* 白底小画框，高级清晰 */
  padding: 10rpx;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
  z-index: 10;
}

/* 登录注册按钮 */
.login-register-btn-group {
  display: flex;
  gap: 24rpx; /* 两个按钮的间距 */
}

.glass-btn {
  font-size: 28rpx; 
  color: #ffffff;
  background: var(--primary-color); /* 登录：蓝色主按钮 */
  height: 64rpx; 
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 16rpx rgba(30, 136, 229, 0.3);
  border: 2rpx solid var(--primary-color);
  box-sizing: border-box;
  white-space: nowrap; 
}
.glass-btn:active {
  opacity: 0.8;
}

.glass-btn.outline {
  background: #ffffff; /* 注册：白色次按钮 */
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.glass-btn.outline:active {
  background: #f8f8f8;
}

/* 已登录状态下的欢迎块 */
.user-welcome {
  background: #ffffff;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  border-radius: 32rpx;
  border: 2rpx solid var(--primary-color);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  transform: translateY(-10rpx); /* 向上移动 10rpx，数字越大移得越高 */
}
.welcome-text {
  color: var(--primary-color);
  font-size: 28rpx; 
  font-weight: bold;
}

/* ================= 通用标题 ================= */
.section-title-wrap {
  padding: 30rpx 24rpx 10rpx;
}
.section-title {
  font-size: 36rpx; 
  font-weight: bold;
  color: var(--text-main);
  position: relative;
  padding-left: 20rpx;
}
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  background: var(--primary-color);
  border-radius: 4rpx;
}

/* ================= 4/5级管理员工作台 ================= */
.admin-content {
  padding: 0 24rpx 40rpx;
  position: relative;
  z-index: 2;
}
.admin-dashboard-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  margin-top: 10rpx;
}
.admin-dashboard-card:active {
  background: #fafafa;
}
.dashboard-left {
  display: flex;
  align-items: center;
}
.dashboard-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-light);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.dashboard-icon {
  font-size: 40rpx;
}
.dashboard-info {
  display: flex;
  flex-direction: column;
}
.dashboard-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 6rpx;
}
.dashboard-desc {
  font-size: 24rpx;
  color: var(--text-gray);
}
.dashboard-arrow {
  font-size: 26rpx;
  color: var(--primary-color);
  display: flex;
  align-items: center;
  font-weight: 500;
}
.arrow-icon {
  margin-left: 8rpx;
  font-size: 30rpx;
}

.product-table-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
  margin-top: 16rpx;
}
.table-header {
  display: flex;
  background: #F8FAFC; 
  color: #64748B;
  font-weight: bold;
  font-size: 26rpx;
}
.table-col {
  padding: 24rpx 10rpx;
  text-align: center;
  box-sizing: border-box;
}
.table-col-img { width: 22%; }
.table-col-name { width: 40%; text-align: left; padding-left: 20rpx; }
.table-col-price { width: 20%; }
.table-col-original { width: 18%; }

.table-body {
  max-height: 600rpx;
}
.table-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-main);
  border-bottom: 1rpx solid #F0F0F0;
  transition: background 0.3s;
}
.table-row:active {
  background: var(--primary-light);
}
.table-row:last-child {
  border-bottom: none;
}
.row-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  display: block;
  margin: 0 auto;
}
.text-ellipsis {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.emphasis {
  color: #1989fa;
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
  font-size: 28rpx;
}
.table-col-original {
  color: #999;
  text-decoration: line-through;
  font-size: 24rpx;
}

/* ================= 顾客视图 (普通页) ================= */
.normal-content {
  position: relative;
  z-index: 2;
}

.notice-bar-wrap {
  padding: 0 24rpx;
  margin-top: 10rpx;
}
.notice-bar {
  display: flex;
  align-items: center;
  background: var(--primary-light);
  border-radius: 40rpx;
  padding: 16rpx 28rpx; 
}
.notice-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}
.notice-text {
  flex: 1;
  font-size: 28rpx; 
  font-weight: bold; 
  color: var(--primary-color);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.banner-swiper-wrap {
  padding: 24rpx;
}
.banner-swiper {
  width: 100%;
  height: 320rpx; 
  border-radius: 20rpx;
  overflow: hidden;
  transform: translateY(0); 
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.06);
}
.swiper-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.star-goods-wrap {
  padding: 10rpx 24rpx 40rpx;
}
.star-goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 20rpx 0;
}
.goods-card {
  width: 48%;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
  display: flex;
  flex-direction: column;
}
.img-box {
  width: 100%;
  height: 340rpx;
  background: #f9f9f9;
}
.goods-img {
  width: 100%;
  height: 100%;
}
.goods-info {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
  justify-content: space-between;
}
.goods-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: bold;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.price-row {
  display: flex;
  align-items: baseline;
}
.price-unit {
  font-size: 24rpx;
  color: #1989fa;
  font-weight: bold;
}
.current-price {
  font-size: 34rpx;
  color: #1989fa;
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
  margin-right: 12rpx;
}
.original-price {
  font-size: 22rpx;
  color: var(--text-gray);
  text-decoration: line-through;
}

.empty-state {
  padding: 100rpx 0;
  text-align: center;
}
.empty-text {
  font-size: 28rpx;
  color: var(--text-gray);
}