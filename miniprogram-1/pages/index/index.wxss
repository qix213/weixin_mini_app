/* ================= 全局与背景 ================= */
page {
  background: #f0f9ff;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.dynamic-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  background: linear-gradient(-45deg, #e0f2fe, #ffffff, #bae6fd, #f8fafc);
  background-size: 400% 400%;
  animation: gradientBG 15s ease infinite;
}

@keyframes gradientBG {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ================= 通用毛玻璃卡片 ================= */
.glass-card {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 30rpx rgba(14, 165, 233, 0.08);
}

/* ================= 顶部 Banner ================= */
.banner-header-wrap {
  /* 从品牌蓝平滑渐变过渡到透明底色 */
  background: linear-gradient(180deg, #0ea5e9 0%, rgba(14, 165, 233, 0.8) 40%, rgba(240, 249, 255, 0) 100%);
  padding: 40rpx 30rpx 60rpx;
  position: relative;
  z-index: 10;
}

.banner-header {
  position: relative;
  display: flex;
  flex-direction: column; 
  align-items: flex-start;
  width: 100%;
}

.banner-text {
  width: 72%;
  display: flex;
  flex-direction: column;
  color: #fff; 
}

.banner-text .greeting {
  font-size: 52rpx; 
  font-weight: 900;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 10rpx rgba(2, 132, 199, 0.3); 
}

.banner-text .welcome {
  font-size: 32rpx; 
  font-weight: bold;
  opacity: 0.95;
  font-family: 'DIN Alternate', 'Arial', sans-serif;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 5rpx rgba(0,0,0,0.1);
}

.banner-text .welcome-sub {
  font-size: 28rpx; 
  opacity: 0.9;
  color: #e0f2fe;
}

.header-right {
  width: 100%; 
  display: flex;
  flex-direction: row; 
  justify-content: flex-end;
  align-items: center;
  margin-top: 20rpx;
}

/* 高级感 Logo 框 */
.banner-logo {
  position: absolute; 
  top: 0;
  right: 0;
  width: 150rpx; 
  height: 75rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  padding: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(2, 132, 199, 0.2);
  box-sizing: border-box;
  z-index: 10;
}

/* 用户在线状态胶囊 */
.user-status-capsule {
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10px);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  height: 64rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.05);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #4ade80; /* 绿色在线呼吸点 */
  border-radius: 50%;
  margin-right: 12rpx;
  box-shadow: 0 0 10rpx #4ade80;
  animation: breathe 2s infinite ease-in-out;
}

@keyframes breathe {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.3); }
}

.welcome-text {
  color: #fff;
  font-size: 28rpx; 
  font-weight: 800;
  text-shadow: 0 2rpx 5rpx rgba(0,0,0,0.1);
}

/* 登录注册按钮 */
.login-register-btn-group {
  display: flex;
  gap: 20rpx;
}

.glass-btn {
  font-size: 26rpx; 
  height: 64rpx; 
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  font-weight: bold;
  box-sizing: border-box;
  white-space: nowrap; 
  transition: all 0.2s;
}

.glass-btn.primary {
  background: rgba(255, 255, 255, 0.95);
  color: #0ea5e9;
  box-shadow: 0 6rpx 15rpx rgba(2, 132, 199, 0.2);
}

.glass-btn.outline {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

.glass-btn:active { transform: scale(0.95); }

/* ================= 通用标题 ================= */
.section-title-wrap {
  padding: 30rpx 24rpx 20rpx;
}

.section-title {
  font-size: 36rpx; 
  font-weight: 900;
  color: #1e293b;
  position: relative;
  padding-left: 24rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #38bdf8, #0ea5e9);
  border-radius: 4rpx;
  box-shadow: 0 0 10rpx rgba(14, 165, 233, 0.4);
}

/* ================= 管理员工作台 ================= */
.admin-content {
  padding: 0 24rpx 40rpx;
  margin-top: -30rpx; /* 向上提，融入渐变背景 */
  position: relative;
  z-index: 20;
}

.admin-dashboard-card {
  border-radius: 30rpx;
  padding: 36rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: transform 0.2s;
}

.admin-dashboard-card:active { transform: scale(0.98); }

.dashboard-left { display: flex; align-items: center; }

.dashboard-icon-wrap {
  width: 90rpx;
  height: 90rpx;
  background: linear-gradient(135deg, #e0f2fe, #bae6fd);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 15rpx rgba(14, 165, 233, 0.15);
}

.dashboard-icon { font-size: 46rpx; }

.dashboard-info { display: flex; flex-direction: column; }

.dashboard-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.dashboard-desc { font-size: 26rpx; color: #64748b; }

.dashboard-arrow {
  font-size: 28rpx;
  color: #0ea5e9;
  font-weight: bold;
}

.product-table-card {
  border-radius: 30rpx;
  overflow: hidden;
  margin-top: 10rpx;
}

.table-header {
  display: flex;
  background: rgba(241, 245, 249, 0.8);
  color: #475569;
  font-weight: 800;
  font-size: 26rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.6);
}

.table-col {
  padding: 24rpx 10rpx;
  text-align: center;
  box-sizing: border-box;
}

.table-col-img { width: 22%; }
.table-col-name { width: 40%; text-align: left; padding-left: 20rpx; }
.table-col-price { width: 20%; }
.table-col-original { width: 18%; }

.table-body { max-height: 600rpx; }

.table-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #1e293b;
  border-bottom: 2rpx dashed rgba(14, 165, 233, 0.1);
  transition: background 0.2s;
}

.table-row:active { background: rgba(224, 242, 254, 0.6); }
.table-row:last-child { border-bottom: none; }

.row-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.5);
  display: block;
  margin: 0 auto;
}

.text-ellipsis {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-weight: 500;
}

.emphasis {
  color: #0ea5e9;
  font-weight: 900;
  font-family: 'DIN Alternate', sans-serif;
  font-size: 30rpx;
}

.table-col-original {
  color: #94a3b8;
  text-decoration: line-through;
  font-size: 24rpx;
}

/* ================= 顾客普通内容区 ================= */
.normal-content {
  margin-top: -40rpx;
  position: relative;
  z-index: 20;
}

/* 玻璃公告栏 */
.notice-bar-wrap { padding: 0 24rpx; margin-bottom: 24rpx; }
.notice-bar {
  display: flex;
  align-items: center;
  border-radius: 50rpx;
  padding: 16rpx 30rpx;
}
.notice-icon { font-size: 32rpx; margin-right: 16rpx; }
.notice-marquee { flex: 1; overflow: hidden; }
.notice-text {
  font-size: 28rpx; 
  font-weight: bold; 
  color: #0ea5e9;
  white-space: nowrap;
}

/* 轮播图投影设计 */
.banner-swiper-wrap {
  padding: 0 24rpx;
  position: relative;
}
.banner-swiper {
  width: 100%;
  height: 320rpx; 
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(14, 165, 233, 0.15);
  position: relative;
  z-index: 2;
}
.swiper-img { width: 100%; height: 100%; border-radius: 24rpx; }

/* 底部发光阴影层，增加悬浮感 */
.swiper-shadow {
  position: absolute;
  bottom: -10rpx;
  left: 5%;
  width: 90%;
  height: 40rpx;
  background: #0ea5e9;
  filter: blur(20px);
  opacity: 0.3;
  z-index: 1;
}

/* 商品流 */
.star-goods-wrap { padding: 10rpx 24rpx 40rpx; }
.star-goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 24rpx 0;
}

.goods-card {
  width: 48%;
  border-radius: 30rpx;
  padding: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s;
}

.goods-card:active { transform: scale(0.97); }

.img-box {
  width: 100%;
  height: 340rpx;
  background: rgba(255, 255, 255, 0.4);
}
.goods-img { width: 100%; height: 100%; }

.goods-info {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 800;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.price-row { display: flex; align-items: baseline; }
.price-unit { font-size: 24rpx; color: #f43f5e; font-weight: bold; }
.current-price {
  font-size: 38rpx;
  color: #f43f5e;
  font-weight: 900;
  font-family: 'DIN Alternate', sans-serif;
  margin-right: 12rpx;
}
.original-price {
  font-size: 22rpx;
  color: #94a3b8;
  text-decoration: line-through;
}

/* 空状态 */
.empty-state { padding: 100rpx 0; text-align: center; }
.empty-text { font-size: 28rpx; color: #94a3b8; font-weight: 500; }