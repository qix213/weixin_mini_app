/* 全局样式 */
page {
  background-color: #ffffff;
}

/* 顶部横幅样式保持不变 ↓ */
.banner1 {
  width: 100%;
  height: 360rpx;
  background: linear-gradient(180deg, 
    #1E88E5 0%,    
    #42a5f5 60%,   
    #ffffff 100%   
  );
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  color: white;
}

.banner-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.banner-text {
  flex: 1;
}
.banner-text .greeting {
  font-size: 40rpx;
  font-weight: 600;
  display: block;
}
.banner-text .welcome {
  font-size: 30rpx;
  opacity: 0.8;
}

.banner-logo {
  width: 200rpx;
  height: 300rpx;
  border-radius: 8rpx;
}

.login-btn {
  font-size: 30rpx;
  color:  rgb(35, 123, 158);
  padding: 8rpx 16rpx;
  border: 2rpx solid rgba(255,255,255,0.8);
  border-radius: 20rpx;
  white-space: wrap;
}

.register-btn {
  font-size: 30rpx;
  color: rgb(35, 123, 158);
  padding: 8rpx 16rpx;
  border: 2rpx solid rgba(255,255,255,0.8);
  border-radius: 20rpx;
  white-space: wrap;
}

.welcome-text {
  color: #fff;
  font-size: 32rpx;
  margin-left: 20rpx;
}

.login-register-btn-group {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  align-items:self-start;
}

.banner-btn-group {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.user-welcome {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10rpx;
}

.welcome-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  padding: 10rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.btn {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
}

.join-btn {
  background-color: transparent;
  color: #1E88E5;
  border: 2rpx solid #1E88E5;
}

.mall-btn {
  background-color: white;
  color: #1E88E5;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.banner {
  height: 290rpx;
  width: 750rpx;
  background-color: rgb(127, 240, 255);
  font-size: 30rpx
}

.tips {
  display: flex;
  justify-content: space-evenly;
  height: 80rpx;
  width: 750rpx;
  background-color: rgb(140, 238, 238);
  font-size: 30rpx;
  color: rgb(196, 36, 14);
  border-radius: 50rpx;
  margin: 10rpx 10rpx 30rpx 10rpx;
  padding-left: 2rpx;
}
.tips>scrotext{
  flex-grow: 1;
  height: 30rpx;
  width: 750rpx;
  margin: 80rpx 10rpx 30rpx 10rpx;
  border-radius: 50rpx;
}
.regist{
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  padding: 10rpx 1rpx ;
  margin: 10rpx 30rpx;
}

.icon {
  padding-right: 10rpx;
}

.menu {
  display: flex;
  justify-content: space-between;
  padding: 16rpx;
  border-radius: 10rpx;
  flex-wrap: wrap;
  background-color: powderblue;
}

.item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 250rpx;
  height: 200rpx;
  border: rgb(192, 251, 255) solid 10rpx;
  margin: 1rpx;
  background-color: powderblue;
}

.img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
}

.title {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.notice {
  display: flex;
  justify-content: flex-start;
  margin-top: 20rpx;
  margin-bottom: 10rpx;
}

.notice>text {
  flex-grow: 1;
  font-size: medium;
  color: blue;
}

/* 明星产品区域样式（核心优化）↑ */
.section-title-wrap {
  padding: 0 20rpx;
  margin: 30rpx 0 10rpx;
}
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  padding-left: 10rpx;
  border-left: 8rpx solid #1E88E5;
}

/* 明星产品区域整体容器（缩减上下间距和内边距） */
.star-goods-section {
  background-color: #f8f9fa;
  padding: 10rpx 0; /* 原20rpx → 10rpx，缩减上下内边距 */
  margin: 5rpx 0;   /* 原10rpx → 5rpx，缩减上下外边距 */
}

/* 明星产品列表容器（缩减左右内边距和项间距） */
.star-goods-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 10rpx; /* 原20rpx → 10rpx，缩减左右内边距 */
  gap: 10rpx;       /* 原20rpx → 10rpx，缩减项之间的间距 */
}

/* 明星产品图片样式（取消缩放，恢复原始尺寸） */
.star-goods-img {
  width: 100%;
  height: 240rpx; /* 固定高度，确保图片清晰显示 */
  object-fit: contain; /* 保持比例，完整显示图片内容 */
  background-color: #f5f5f5;
  
  /* 核心修改：移除transform缩放 */
  transform: scale(1); /* 恢复原始尺寸 */
  transform-origin: unset; /* 移除定位 */
  
  margin: 0; /* 移除额外边距 */
}

/* 单个商品项容器（适配原始尺寸图片） */
.star-goods-item {
  width: 48%; /* 保持48%宽度 */
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  margin-bottom: 10rpx;
  max-width: 350rpx;
  
  /* 关键修改：调整容器高度适配原始尺寸图片 */
  min-height: 340rpx; /* 固定最小高度，避免内容错位 */
  
  padding-bottom: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

/* 商品信息区（微调位置，适配原始尺寸图片） */
.goods-info {
  padding: 12rpx;
  width: 90%;
  margin-top: -10rpx; /* 减少负边距，避免信息区过高 */
  box-sizing: border-box;
}

/* 商品名称（适配恢复后的宽度） */
.goods-name {
  font-size: 28rpx;     /* 恢复为28rpx，匹配48%宽度 */
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

/* 价格区域（适配恢复后的宽度） */
.price-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.current-price {
  font-size: 32rpx;     /* 恢复为32rpx，匹配48%宽度 */
  color: #ff4400;
  font-weight: 700;
}
.original-price {
  font-size: 24rpx;     /* 恢复为24rpx，匹配48%宽度 */
  color: #999;
  text-decoration: line-through;
}

/* 原有固定图片样式保持不变 ↓ */
.fixed-images-container {
  display: flex;          
  flex-wrap: wrap;        
  justify-content: space-between; 
  padding: 0 20rpx;       
  min-height: 200rpx;     
  gap: 30rpx 0;
}

.fixed-image-item {
  width: 48%;             
  display: flex;           
  flex-direction: column;  
  align-items: center;     
}

.fixed-image {
  width: 100%;             
  min-height: 200rpx;     
  height: auto;           
  border-radius: 10rpx;   
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  object-fit: cover;      
}

.fixed-image-title {
  margin-top: 10rpx;       
  font-size: 24rpx;        
  color: #333;             
  text-align: center;      
  white-space: nowrap;     
  overflow: hidden;        
  text-overflow: ellipsis; 
  width: 100%;             
}

.fixed-images-section {
  background-color: #fff; 
  margin: 20rpx 0;        
  padding: 10rpx 0;       
}