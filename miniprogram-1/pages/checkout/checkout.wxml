<view class="checkout-container">
  <view class="dynamic-bg"></view>

  <view class="page-header">结算页面</view>

  <view class="glass-card section-card">
    <view class="section-title">配送方式</view>
    <view class="delivery-options">
      <view 
        class="delivery-btn {{deliveryType==1 ? 'active' : ''}}" 
        data-type="1" 
        bindtap="switchDeliveryType">
        <text class="btn-icon" wx:if="{{deliveryType==1}}">✓</text> 快递上门
      </view>
      <view 
        class="delivery-btn {{deliveryType==2 ? 'active' : ''}}" 
        data-type="2" 
        bindtap="switchDeliveryType">
        <text class="btn-icon" wx:if="{{deliveryType==2}}">✓</text> 到店自取
      </view>
    </view>
  </view>

  <view wx:if="{{deliveryType==1}}" class="glass-card location-card" bindtap="toAddressPage">
    <view class="icon-wrap">📍</view>
    <view class="location-info">
      <view class="location-title">收货地址</view>
      <view wx:if="{{defaultAddress}}" class="location-desc">
        <view class="contact-name">{{defaultAddress.name}} <text class="phone">{{defaultAddress.phone}}</text></view>
        <view class="detail-addr">{{defaultAddress.address}} {{defaultAddress.detail}}</view>
      </view>
      <view wx:else class="location-empty">暂无收货地址，点击添加</view>
    </view>
    <view class="arrow-icon">></view>
  </view>

  <view wx:if="{{deliveryType==2}}" class="glass-card location-card" bindtap="openStore">
    <view class="icon-wrap store-icon">🏪</view>
    <view class="location-info">
      <view class="location-title">取货门店</view>
      <view wx:if="{{selectedStore}}" class="location-desc highlight-text">
        {{selectedStore.name}}
      </view>
      <view wx:else class="location-empty">请选择取货门店</view>
    </view>
    <view class="arrow-icon">></view>
  </view>

  <van-action-sheet show="{{storeShow}}" bindcancel="closeStore" title="选择取货门店" round>
    <view class="store-list">
      <view wx:for="{{areaList}}" wx:key="id" 
        class="store-item {{selectedStore && selectedStore.id==item.id ? 'active' : ''}}"
        data-store="{{item}}"
        bindtap="selectStore">
        <text class="store-name">{{item.name}}</text>
        <text class="check-mark" wx:if="{{selectedStore && selectedStore.id==item.id}}">✓</text>
      </view>
    </view>
  </van-action-sheet>

  <view class="section-title out-title">结算商品 <text class="badge">{{cartList.length}}</text> 件</view>
  
  <view class="goods-list">
    <view wx:for="{{cartList}}" wx:key="id" class="glass-card goods-item">
      <image src="{{item.goods_image}}" class="goods-img" mode="aspectFill"></image>
      <view class="goods-info">
        <view class="goods-name">{{item.goods_name}}</view>
        
        <view class="tags-row">
          <view wx:if="{{item.isPointGoods}}" class="point-tag">积分兑换商品</view>
          <view class="goods-num">x{{item.num}}</view>
        </view>

        <view class="goods-price">
          <block wx:if="{{item.isPointGoods}}">
            <text class="val">{{item.pointPrice}}</text> <text class="unit">积分</text>
          </block>
          <block wx:else>
            <text class="unit">¥</text><text class="val">{{item.formatPrice}}</text>
          </block>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{(hasExchangeGoods || isAllPointGoods) && cartList.length>0}}" class="glass-card point-deduct-card">
    <view class="section-title">积分抵扣</view>
    
    <view class="point-status-row">
      <view class="current-points">
        当前积分：<text class="highlight">{{userPoints}}</text>
        <text class="sub-tip">{{isAllPointGoods ? '(积分直接抵扣)' : '(1分=0.01元)'}}</text>
      </view>
      <view class="max-deduct-tip">最多可抵扣：{{maxDeductPoint}} 分</view>
    </view>
    
    <view class="point-operate-row">
      <view class="stepper-glass">
        <view class="btn-minus" bindtap="minusPoint">-</view>
        <input 
          class="point-input"
          type="number" 
          value="{{deductPoint}}" 
          bindinput="inputPoint"
          placeholder="0"
        />
        <view class="btn-plus" bindtap="plusPoint">+</view>
      </view>
      
      <button 
        bindtap="useAllPoints"
        disabled="{{maxDeductPoint <= 0}}"
        class="use-all-btn {{maxDeductPoint <= 0 ? 'disabled' : ''}}"
      >用全部积分</button>
    </view>
    
    <view class="deduct-summary">
      <block wx:if="{{isAllPointGoods}}">
        <view class="summary-item">抵扣积分：<text class="val blue">{{deductPoint}}</text> 分</view>
        <view class="summary-item">需现金支付：<text class="val red">¥{{actualPayMoney}}</text></view>
      </block>
      <block wx:else>
        <view class="summary-item">抵扣金额：<text class="val blue">¥{{deductMoney}}</text></view>
        <view class="summary-item">需现金支付：<text class="val red">¥{{actualPayMoney}}</text></view>
      </block>
    </view>
  </view>

  <view wx:if="{{cartList.length>0}}" class="bottom-submit-bar">
    <view class="total-info">
      <view class="deduct-tip">
        {{hasExchangeGoods && deductPoint>0 ? (isAllPointGoods ? '已抵扣 '+deductPoint+' 积分' : '已抵扣 ¥'+deductMoney) : '总计'}}
      </view>
      <view class="pay-amount">
        需支付：<text class="unit">¥</text><text class="val">{{actualPayMoney}}</text>
      </view>
    </view>
    
    <button class="submit-btn" bindtap="submitOrder">提交订单</button>
  </view>

</view>