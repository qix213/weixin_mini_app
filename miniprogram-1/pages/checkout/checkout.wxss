/* ================= 全局与背景 ================= */
page {
  background: #FAF8F5; /* 奶油可可白 */
  min-height: 100vh;
}

.checkout-container {
  position: relative;
  min-height: 100vh;
  padding-bottom: 160rpx; /* 为底部悬浮栏留出充裕空间 */
  font-family: 'DIN Alternate', -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

/* 科技感极简环境光晕 (取代原有的蓝色流动动画) */
.dynamic-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 600rpx;
  z-index: -1;
  background: linear-gradient(180deg, rgba(148, 164, 140, 0.12) 0%, rgba(250, 248, 245, 0) 100%);
  pointer-events: none;
}

.page-header {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #222222;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
  position: sticky;
  top: 0;
  z-index: 99;
  letter-spacing: 2rpx;
}

/* ================= 通用毛玻璃卡片 ================= */
.glass-card {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(148, 164, 140, 0.06);
  margin: 24rpx;
}

.section-card {
  padding: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #222222;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

/* 外部悬浮标题 */
.out-title {
  padding: 0 32rpx;
  margin-top: 40rpx;
  margin-bottom: 12rpx;
}

.out-title .badge {
  color: #94A48C;
  font-family: 'DIN Alternate', sans-serif;
  font-size: 34rpx;
  font-weight: bold;
}

/* ================= 配送方式按钮 (极简胶囊) ================= */
.delivery-options {
  display: flex;
  gap: 24rpx;
}

.delivery-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #94a3b8;
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.delivery-btn.active {
  background: linear-gradient(135deg, #94A48C 0%, #7A8B72 100%);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(148, 164, 140, 0.25);
}

.btn-icon {
  margin-right: 10rpx;
  font-size: 26rpx;
}

/* ================= 地址/门店信息卡片 ================= */
.location-card {
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
}

.icon-wrap {
  width: 72rpx;
  height: 72rpx;
  background: rgba(148, 164, 140, 0.1);
  color: #94A48C;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 24rpx;
  border: 1px solid rgba(148, 164, 140, 0.15);
}

.store-icon { 
  background: rgba(212, 192, 168, 0.15); /* 门店用极淡的暖咖色区分 */
  color: #B59F84;
  border-color: rgba(212, 192, 168, 0.2);
} 

.location-info { flex: 1; }

.location-title {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 8rpx;
}

.location-desc {
  font-size: 30rpx;
  color: #222222;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.contact-name { margin-bottom: 6rpx; }
.phone { color: #666666; font-size: 26rpx; font-weight: 500; margin-left: 12rpx; font-family: 'DIN Alternate', sans-serif;}
.detail-addr { font-size: 26rpx; color: #666666; font-weight: normal; line-height: 1.5; }

.location-empty {
  font-size: 28rpx;
  color: #94A48C;
  font-weight: bold;
}

.highlight-text { color: #94A48C; font-size: 30rpx; }
.arrow-icon { font-size: 26rpx; color: #C2C2C2; margin-left: 20rpx;}

/* ================= Action Sheet 门店列表 ================= */
.store-list {
  padding: 10rpx 0 40rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.store-item {
  padding: 32rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid rgba(0,0,0,0.03);
  transition: background 0.2s;
}

.store-item:active { background: rgba(0,0,0,0.02); }

.store-item.active {
  background: rgba(148, 164, 140, 0.04);
}

.store-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.store-item.active .store-name { color: #94A48C; font-weight: bold; }
.check-mark { color: #94A48C; font-weight: bold; font-size: 30rpx; }

/* ================= 商品列表 ================= */
.goods-list { padding: 0; }

.goods-item {
  display: flex;
  padding: 32rpx;
  border-bottom: 1px solid rgba(0,0,0,0.02);
}

.goods-item:last-child { border-bottom: none; }

.goods-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  background: #F8F9FA;
  border: 1px solid rgba(0,0,0,0.04);
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 28rpx;
  color: #222222;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tags-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: auto;
}

.point-tag {
  background: rgba(148, 164, 140, 0.08);
  color: #94A48C;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  border: 1px solid rgba(148, 164, 140, 0.15);
}

.goods-num { font-size: 26rpx; color: #A3A3A3; font-weight: 500; }

.goods-price {
  text-align: right;
  margin-top: 10rpx;
}

/* 高级感：放弃红色，全部采用深邃黑 */
.goods-price .val {
  color: #222222;
  font-size: 34rpx;
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
}

.goods-price .unit {
  color: #222222;
  font-size: 24rpx;
  font-weight: bold;
}

/* ================= 积分抵扣模块 ================= */
.point-deduct-card { padding: 32rpx; }

.point-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.current-points { font-size: 26rpx; color: #666666; font-weight: 500;}
.current-points .highlight { color: #94A48C; font-weight: bold; font-size: 34rpx; font-family: 'DIN Alternate', sans-serif;}
.current-points .sub-tip { font-size: 22rpx; color: #A3A3A3; margin-left: 12rpx; }
.max-deduct-tip { font-size: 22rpx; color: #94A48C; background: rgba(148, 164, 140, 0.08); padding: 6rpx 16rpx; border-radius: 8rpx;}

.point-operate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

/* 水晶步进器 */
.stepper-glass {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 16rpx;
  overflow: hidden;
  height: 68rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
}

.btn-minus, .btn-plus {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666666;
  background: transparent;
  transition: all 0.2s;
}
.btn-minus:active, .btn-plus:active { background: rgba(148, 164, 140, 0.1); color: #94A48C; }

.point-input {
  flex: 1;
  height: 68rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #222222;
  border-left: 1px solid rgba(0, 0, 0, 0.03);
  border-right: 1px solid rgba(0, 0, 0, 0.03);
  background: rgba(250, 248, 245, 0.5);
}

.use-all-btn {
  width: 180rpx !important;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #94A48C 0%, #7A8B72 100%);
  color: #FFFFFF;
  border-radius: 34rpx; /* 胶囊状 */
  box-shadow: 0 6rpx 16rpx rgba(148, 164, 140, 0.25);
  padding: 0;
}
.use-all-btn.disabled { background: rgba(0,0,0,0.04) !important; color: #A3A3A3 !important; box-shadow: none !important; border: 1px solid rgba(0,0,0,0.05);}

.deduct-summary {
  background: rgba(250, 248, 245, 0.6);
  padding: 24rpx;
  border-radius: 16rpx;
  border: 1px dashed rgba(0, 0, 0, 0.05);
}

.summary-item {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 12rpx;
  display: flex;
  justify-content: space-between;
}
.summary-item:last-child { margin-bottom: 0; }

.summary-item .val { font-weight: bold; font-family: 'DIN Alternate', sans-serif;}
.summary-item .blue { color: #94A48C; font-size: 26rpx;} /* 改为莫兰迪绿 */
.summary-item .red { color: #222222; font-size: 30rpx;} /* 放弃红色，采用克制的深黑色 */

/* ================= 底部结算悬浮栏 ================= */
.bottom-submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 140rpx; 
  background: rgba(250, 248, 245, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1px solid rgba(0, 0, 0, 0.02);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  box-shadow: 0 -4rpx 30rpx rgba(148, 164, 140, 0.05);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.total-info {
  display: flex;
  flex-direction: column;
}

.deduct-tip {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 6rpx;
}

.pay-amount {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.pay-amount .unit { color: #222222; font-size: 28rpx; margin-left: 8rpx; font-weight: bold;}
.pay-amount .val { color: #222222; font-size: 46rpx; font-weight: bold; font-family: 'DIN Alternate', sans-serif;}

/* 极简高级胶囊提交按钮 */
.submit-btn {
  width: 260rpx !important;
  height: 84rpx;
  background: linear-gradient(135deg, #94A48C 0%, #7A8B72 100%);
  color: #FFFFFF;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(148, 164, 140, 0.25);
  margin: 0;
  transition: transform 0.2s;
}

.submit-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 10rpx rgba(148, 164, 140, 0.15);
}
/* 🌟 核心：统一清零和用全部按钮的尺寸，解决大小不一的问题 */
.btn-action {
  width: 140rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 24rpx;
  border-radius: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
  padding: 0;
  transition: all 0.2s ease;
}

.btn-clear {
  color: #94A48C;
  background-color: rgba(148, 164, 140, 0.1); 
}

.btn-use-all {
  color: #FFFFFF;
  background-color: #94A48C;
  box-shadow: 0 4rpx 12rpx rgba(148, 164, 140, 0.2);
}

.btn-use-all.disabled {
  background-color: #EAECEA;
  color: #A9ACA8;
  box-shadow: none;
}

.btn-action:active {
  transform: scale(0.94);
  opacity: 0.9;
}

/* 中间的加减框铺满剩余空间 */
.stepper-glass {
  flex: 1;
  margin: 0 20rpx;
  display: flex;
  justify-content: center;
}

/* 底部混合高亮 */
.pay-amount .point-color {
  color: #94A48C;
  font-size: 28rpx;
  margin-right: 6rpx;
  font-weight: 600;
}