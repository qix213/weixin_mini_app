page{background-color: #f5f5f5;}
.checkout-container{padding-bottom: 120rpx;}

/* 收货地址样式 */
.address-wrap{margin: 10rpx;background: #fff;border-radius: 10rpx;}

/* 分割线 */
.line{height: 10rpx;background-color: #f5f5f5;}

/* 商品标题 */
.goods-title{padding: 10rpx 20rpx;font-size: 28rpx;color: #333;font-weight: bold;}

/* 商品列表 */
.goods-list{padding: 0 10rpx;}
.goods-item{margin-bottom: 10rpx;}

/* 空商品样式 */
.empty-wrap{padding: 100rpx 0;text-align: center;}
.empty-text{font-size: 26rpx;color: #999;margin-bottom: 30rpx;}

/* 底部提交栏 */
.submit-bar{
  position: fixed;
  bottom: 0;left: 0;right: 0;
  height: 100rpx;background: #fff;
  border-top: 1rpx solid #e0e0e0;
  display: flex;align-items: center;justify-content: space-between;
  padding: 0 20rpx;z-index:999;
}
.total-price{font-size: 28rpx;color: #e64340;}
.total-price span{font-size: 32rpx;font-weight: bold;}
.submit-btn{width: 240rpx;height: 70rpx;line-height: 70rpx;}

/* 配送方式样式 */
.delivery-wrap {
  margin: 10rpx;background: #fff;border-radius: 10rpx;
}
.delivery-title {
  padding: 20rpx 20rpx 10rpx;
  font-size:30rpx;
  font-weight: bold;
}
.delivery-type {
  display: flex;
  padding: 0 20rpx 20rpx;
  gap: 20rpx;
}
.delivery-btn {
  flex: 1;
  height:80rpx;
  line-height:80rpx;
  text-align:center;
  font-size:28rpx;
  border:1rpx solid #ddd;
  border-radius:8rpx;
}

/* 门店选择样式 */
.store-wrap {
  margin: 10rpx;background: #fff;border-radius: 10rpx;
}
.selected-store {
  text-align: right;
}
.store-name {
  font-size: 26rpx;color: #333;margin-top:8rpx;
}
.store-desc {
  font-size: 26rpx;color: #666;margin-top:8rpx;
}
.store-option {
  padding: 24rpx;border-bottom:1rpx solid #eee;font-size:28rpx;
}
.option-name {
  font-size: 26rpx;color: #333;
}
.option-desc {
  font-size: 22rpx;color: #999;margin-top: 4rpx;
}

/* 积分抵扣模块补充样式 */
.delivery-wrap .delivery-title {
  font-size:30rpx;
  font-weight:600;
}
input[type="number"] {
  font-size:28rpx;
  color:#333;
}
button {
  border:none;
  background:#f5f5f5;
  border-radius:4rpx;
}