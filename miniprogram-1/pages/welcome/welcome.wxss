.welcome-container {
  width: 100vw;
  height: 100vh;
  position: relative;
}

/* 🌟 核心修复 1：将背景图降级到负一层，绝对不可能再挡住任何东西 */
.bg-img {
  width: 100%;
  height: 100vh;
  position: absolute;
  top: 0;
  left: 0;
  z-index: -1;
  /* 图片未加载出来前，显示与设计稿底色一致的奶油色 */
  background-color: #FAF8F5; 
}

/* 🌟 核心修复 2：去掉复杂的 calc 计算，直接用 120rpx 的安全高度 */
.skip-btn {
  position: absolute;
  top: 120rpx; 
  right: 40rpx;
  z-index: 999; 
  
  /* 增加了一点背景不透明度，防止背景图片太亮导致文字看不清 */
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.9);
  
  /* 稍微加深了莫兰迪绿的颜色，提升对比度 */
  color: #7A8B72; 
  font-size: 26rpx;
  font-weight: bold;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.skip-btn:active {
  transform: scale(0.95);
  background: #FFFFFF;
}