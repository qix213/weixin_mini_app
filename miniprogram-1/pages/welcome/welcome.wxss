.welcome-container {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

/* 🌟 品牌高级渐变底色 (零KB，纯代码，瞬间渲染) */
.brand-bg {
  /* 从左上角的奶油色，渐变到右下角的极淡莫兰迪绿 */
  background: linear-gradient(135deg, #FAF8F5 0%, #E8EDE4 100%);
}

.bg-img {
  width: 100%;
  height: 100vh;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  opacity: 0; 
  transition: opacity 0.8s ease-in-out; /* 渐显动画稍微拉长到0.8秒，更柔和 */
}

.bg-img.show {
  opacity: 1;
}

/* --- 下方的 skip-btn 保持你之前的代码 --- */
.skip-btn {
  position: absolute;
  top: 120rpx; 
  right: 40rpx;
  z-index: 999; 
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.9);
  color: #7A8B72; 
  font-size: 26rpx;
  font-weight: bold;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}
.skip-btn:active {
  transform: scale(0.95);
  background: #FFFFFF;
}