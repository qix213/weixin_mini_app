/* 让页面占满整个屏幕 */
page {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.welcome-container {
  width: 100%;
  height: 100%;
  position: relative;
}

/* 背景图铺满全屏 */
.bg-img {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1; /* 垫在最底层 */
}

/* 高级感：半透明毛玻璃胶囊按钮 */
.skip-btn {
  position: absolute;
  /* 距离顶部的高度，加上安全区，适配刘海屏 */
  top: calc(80rpx + env(safe-area-inset-top)); 
  right: 40rpx;
  z-index: 10;
  
  /* 毛玻璃视觉效果 */
  padding: 10rpx 32rpx;
  background-color: rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(10px); /* 磨砂虚化背景 */
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  
  /* 字体与边角 */
  border-radius: 100rpx; /* 胶囊圆角 */
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 按钮点击时的交互反馈 */
.skip-btn:active {
  background-color: rgba(0, 0, 0, 0.4);
}